//========= HL2RPM ============================================================//
//
// Indirect light of the global light from the GI probes (deferred_gi.cpp in the
// client), at half resolution; blurred by deferred_giblur_ps30 and used by
// lightingpass_global_ps30 instead of its flat sky light.
//
// Every probe holds (atlas planes, see the client):
//   0: sky visibility as L1 spherical harmonics, scaled so that
//      vis( n ) = a0 + dot( a1, n ) is the cosine weighted part of the sky the
//      directions around n see (1 = open sky above a horizontal surface)
//   1: the same for the indirect light of the sun - what the surfaces around it
//      send back of the sun and of each other's light, any number of bounces -
//      as luminance, in units of the sun's light
//   2: rgb color of that light (luminance 1), a weight (0 = in a wall / not
//      traced yet, rising to 1 while a new probe fades in)
//   3: free distance from the probe along +x -x, +y -y, +z -z (5 bits each,
//      packed in pairs), 31 = a whole probe spacing
//   4: the sky light the surroundings send back (as 1), in units of the sky light
//   5: rgb color of it
//
// The 8 probes around the point are blended with trilinear weights, except
// probes that can't see it: a wall between them (free distance along an axis
// shorter than the way to the point) or the probe behind the surface. A probe
// outside a room must not light it - that is what made interiors as bright as
// the street.
//
// Three sources, each taking over where the one before ends (or has no probe
// that sees the point), so that there is no place where the light is of another
// kind - beyond the grid the old flat sky light used to show, half of a shaded
// wall dark and half of it light:
//   - the near grid of probes around the camera,
//   - the far grid (4 x the spacing) around that,
//   - an estimate without probes: an open hemisphere above the surface, closed
//     by the sky visibility of the rain map (roofs), the ground lit by the sun.
//
// Output: rgb indirect light / Shape( n ) (the full resolution pass multiplies by
// Shape of its own normal: bumps keep their shading in the shade), a 1 (0 = sky).
// The normal is the one of the lower right pixel of the 2 x 2 block this half
// resolution pixel stands for - the upsampling of the lighting pass relies on it.
//
//=============================================================================//

#include "common_ps_fxc.h"

sampler sDepth			: register( s0 );	// G-buffer linear depth (0 = sky)
sampler sNormals		: register( s1 );	// G-buffer normals
sampler sProbes			: register( s2 );	// probe atlas of the near grid (point sampled)
sampler sProbesFar		: register( s3 );	// probe atlas of the far grid
sampler sSkyVis			: register( s4 );	// SSAO (r) and sky visibility of the rain map (g), half resolution

const float3 g_vecViewOrigin	: register( c0 );
const float4 g_vecGrid			: register( c1 );	// near grid: xyz world cell index of the first probe, w 1 / spacing
const float4 g_vecDims			: register( c2 );	// near grid: xyz probes per axis, w spacing
const float4 g_vecAtlas			: register( c3 );	// x 1 / atlas width, y 1 / atlas height, z normal offset (x spacing), w debug
const float4 g_vecAmbHigh		: register( c4 );	// rgb sky light, w sky light left without sky in sight
const float4 g_vecAmbLow		: register( c5 );	// rgb sky light bounced off the ground (ambient low: the estimate beyond the probes), w scale of the bounced sky light
const float4 g_vecSun			: register( c6 );	// rgb sun light x bounce scale, w 1 / cells over which the near grid fades into the far one
const float4 g_vecGI2			: register( c7 );	// x leak tolerance (x spacing), y probe offset in its cell (probe i sits at ( i + y ) * spacing), z unused, w indirect sun boost indoors
const float4 g_vecGridFar		: register( c8 );	// far grid, as c1
const float4 g_vecDimsFar		: register( c9 );	// far grid, as c2 (xyz 0: off)
const float4 g_vecEstimate		: register( c10 );	// x sky visibility uv scale (0 = none), y its indoor ambient, z height of the sun (0..1)

struct PS_INPUT
{
	float2 vTexCoord			: TEXCOORD0;
	float3 vecWorldRay			: TEXCOORD1;
};

float Shape( float3 n )
{
	return 0.6 + 0.4 * n.z;
}

// what the probes of one grid give the point: xyz light, w how far they can be trusted
// (0 = outside the grid or no probe sees the point)
// (flFade: the part of a cell the grid's weight falls by toward its sides - the near grid
// fades into the far one over a wide band, the far one into the estimate over two cells)
float4 GatherGrid( sampler sAtlas, float4 vecGrid, float4 vecDims, float3 P, float3 N, float flFade, out float4 vecDebug, out float3 vecDebugSky )
{
	vecDebug = 0.0;
	vecDebugSky = 0.0;

	// (off the surface along its normal: a floor looks up between the probes over it, a
	// wall looks into the room in front of it)
	const float3 Ps = P + N * ( g_vecAtlas.z * vecDims.w );
	const float3 g = Ps * vecGrid.w - g_vecGI2.y;
	const float3 base = floor( g );
	const float3 f = g - base;

	// inside the grid, fading out over its outermost cells (flFade to the sides, one up and down).
	// A grid that ended within two cells drew its border across the scene: what the near probes
	// know and the far ones don't - the shade in a corner, behind a wall - "loaded in" at that
	// line as the player walked up to it. Smooth over a wide band it grows with the approach.
	const float3 rel = g - vecGrid.xyz;
	const float3 margin = min( rel, ( vecDims.xyz - 1.0 ) - rel ) * float3( flFade, flFade, 1.0 );
	float edge = saturate( min( min( margin.x, margin.y ), margin.z ) );
	edge = edge * edge * ( 3.0 - 2.0 * edge );
	if ( edge <= 0.0 )
		return 0.0;

	const float planeStep = vecDims.y * g_vecAtlas.y;
	const float tolerance = g_vecGI2.x * vecDims.w;
	const float invSoft = 8.0 / vecDims.w;

	float wsum = 0.0;
	float sky = 0.0;
	float3 skyBounce = 0.0;
	float3 sun = 0.0;

	// (a real loop: unrolled, the 8 probes x 6 planes ran out of ps_3_0's temporary registers)
	[loop]
	for ( int c = 0; c < 8; c++ )
	{
		// corner c of the cell: ( c & 1, ( c >> 1 ) & 1, c >> 2 )
		const float fc = c;
		const float3 corner = float3( frac( fc * 0.5 ) * 2.0, frac( floor( fc * 0.5 ) * 0.5 ) * 2.0, floor( fc * 0.25 ) );
		const float3 idx = base + corner;
		// (the grid is toroidal: a probe lives at its world cell modulo the grid size)
		const float3 slot = idx - vecDims.xyz * floor( idx / vecDims.xyz );
		const float2 uv = float2( ( slot.x + slot.z * vecDims.x + 0.5 ) * g_vecAtlas.x, ( slot.y + 0.5 ) * g_vecAtlas.y );

		const float4 dVis = tex2Dlod( sAtlas, float4( uv, 0, 0 ) );
		const float4 dBnc = tex2Dlod( sAtlas, float4( uv.x, uv.y + planeStep, 0, 0 ) );
		const float4 dAux = tex2Dlod( sAtlas, float4( uv.x, uv.y + 2.0 * planeStep, 0, 0 ) );
		const float4 dFree = tex2Dlod( sAtlas, float4( uv.x, uv.y + 3.0 * planeStep, 0, 0 ) );
		const float4 dSky = tex2Dlod( sAtlas, float4( uv.x, uv.y + 4.0 * planeStep, 0, 0 ) );
		const float4 dSkyC = tex2Dlod( sAtlas, float4( uv.x, uv.y + 5.0 * planeStep, 0, 0 ) );

		const float3 tw = lerp( 1.0 - f, f, corner );
		float w = tw.x * tw.y * tw.z * dAux.w;

		// a wall between the probe and the point: the free distance along an axis is shorter
		// than the way to the point along it (fading out over an eighth of the spacing: a hard
		// test drew the cells of the grid on the walls)
		const float3 probePos = ( idx + g_vecGI2.y ) * vecDims.w;
		const float3 d = Ps - probePos;
		const float3 qHi = floor( dFree.xyz * ( 1.0 / 32.0 ) + 0.01 );
		const float3 qLo = dFree.xyz - qHi * 32.0;
		const float3 freeD = ( d >= 0.0 ? qHi : qLo ) * ( vecDims.w / 31.0 );
		const float3 over = abs( d ) - freeD - tolerance;
		w *= saturate( 1.0 - max( max( over.x, over.y ), over.z ) * invSoft );

		// the probe behind the surface (under the floor, inside the wall)
		const float3 toProbe = probePos - P;
		const float facing = saturate( dot( toProbe, N ) * rsqrt( max( dot( toProbe, toProbe ), 1.0 ) ) * 0.5 + 0.5 );
		w *= facing * facing + 0.02;

		const float vis = saturate( dVis.x + dot( dVis.yzw, N ) );
		const float bnc = max( dBnc.x + dot( dBnc.yzw, N ), 0.0 );
		const float skb = max( dSky.x + dot( dSky.yzw, N ), 0.0 );
		sky += w * vis;
		// (indoors the eye would adapt far more than the exposure does: the light that reaches a
		// room by bouncing - off the sunlit patch on the floor, off the walls by the window - is
		// boosted where little sky is in sight; outdoors it stays as it is)
		const float indoor = lerp( g_vecGI2.w, 1.0, saturate( dVis.x * 2.0 ) );
		skyBounce += w * dSkyC.rgb * ( skb * indoor );
		sun += w * dAux.rgb * ( bnc * indoor );
		wsum += w;
	}

	if ( wsum < 1e-5 )
		return 0.0;

	const float inv = 1.0 / wsum;
	sky *= inv;
	skyBounce *= inv * g_vecAmbLow.w;
	sun *= inv;

	vecDebug = float4( sky, sun );
	vecDebugSky = skyBounce;
	const float3 light = g_vecAmbHigh.rgb * ( lerp( g_vecAmbHigh.w, 1.0, sky ) + skyBounce )
		+ g_vecSun.rgb * sun;
	return float4( light, edge * saturate( wsum * 16.0 ) );
}

// no probes: the surface under an open sky - or under a roof, as far as the sky visibility of
// the rain map knows - over a ground the sun lights (what a probe in the open comes to)
float3 Estimate( float2 uv, float3 N, out float4 vecDebug )
{
	// (under a roof no sky at all: the level of a closed room of the probes)
	float open = 1.0;
	if ( g_vecEstimate.x > 0.0 )
		open = tex2Dlod( sSkyVis, float4( uv * g_vecEstimate.x, 0, 0 ) ).g;

	const float hemi = 0.5 + 0.5 * N.z;
	const float sky = hemi * open;
	const float bounce = 0.25 * g_vecEstimate.z * ( ( 1.0 - hemi ) + 0.25 ) * open;

	vecDebug = float4( sky, bounce.xxx );
	return g_vecAmbHigh.rgb * lerp( g_vecAmbHigh.w, 1.0, sky )
		+ g_vecAmbLow.rgb * ( ( 1.0 - hemi ) * open * g_vecAmbLow.w )
		+ g_vecSun.rgb * bounce;
}

float4 main( const PS_INPUT In ) : COLOR
{
	// the lower right pixel of the 2 x 2 block
	const float2 uvPixel = In.vTexCoord + 0.25 * float2( abs( ddx( In.vTexCoord.x ) ), abs( ddy( In.vTexCoord.y ) ) );

	const float depth = tex2Dlod( sDepth, float4( uvPixel, 0, 0 ) ).x;
	if ( depth < 0.1 )
		return float4( 0, 0, 0, 0 );

	const float3 P = g_vecViewOrigin + In.vecWorldRay * depth;
	const float3 N = normalize( tex2Dlod( sNormals, float4( uvPixel, 0, 0 ) ).xyz * 2.0 - 1.0 );

	float4 dbgNear, dbgFar = 0.0, dbgEst = 0.0;
	float3 dbgSkyNear, dbgSkyFar = 0.0;
	const float4 lightNear = GatherGrid( sProbes, g_vecGrid, g_vecDims, P, N, g_vecSun.w, dbgNear, dbgSkyNear );

	float3 light = lightNear.rgb;
	float4 dbg = dbgNear;
	float3 dbgSky = dbgSkyNear;
	float3 source = float3( lightNear.a, 0, 0 );

	[branch]
	if ( lightNear.a < 0.999 )
	{
		float4 lightFar = 0.0;
		[branch]
		if ( g_vecDimsFar.x > 0.5 )
			lightFar = GatherGrid( sProbesFar, g_vecGridFar, g_vecDimsFar, P, N, 0.5, dbgFar, dbgSkyFar );

		const float3 lightEst = Estimate( In.vTexCoord, N, dbgEst );

		const float3 lightBeyond = lerp( lightEst, lightFar.rgb, lightFar.a );
		light = lerp( lightBeyond, lightNear.rgb, lightNear.a );
		dbg = lerp( lerp( dbgEst, dbgFar, lightFar.a ), dbgNear, lightNear.a );
		dbgSky = lerp( dbgSkyFar * lightFar.a, dbgSkyNear, lightNear.a );
		source = float3( lightNear.a, ( 1.0 - lightNear.a ) * lightFar.a, ( 1.0 - lightNear.a ) * ( 1.0 - lightFar.a ) );
	}

	// r_deferred_gi_debug 3..6: the sky visibility / the indirect sun / the source / the bounced sky alone
	if ( g_vecAtlas.w > 2.5 )
	{
		if ( g_vecAtlas.w < 3.5 )
			light = dbg.xxx;
		else if ( g_vecAtlas.w < 4.5 )
			light = dbg.yzw;
		else if ( g_vecAtlas.w < 5.5 )
			light = source;
		else
			light = dbgSky;
	}

	return float4( light / Shape( N ), 1.0 );
}
