
// STATIC:		"ALPHATEST"			"0..1"
// STATIC:		"TRANSLUCENT"		"0..1"
// STATIC:		"READNORMAL"		"0..1"
// STATIC:		"NOCULL"			"0..1"
// STATIC:		"PHONGFRESNEL"		"0..1"
// STATIC:		"ENVMAP"			"0..1"
// STATIC:		"ENVMAPMASK"		"0..1"
// STATIC:		"ENVMAPFRESNEL"		"0..1"

// STATIC:		"RIMLIGHT"						"0..1"
// STATIC:		"RIMLIGHTMODULATELIGHT"			"0..1"

// STATIC:		"BASETEXTURE2"		"0..1"
// STATIC:		"BLENDMODULATE"		"0..1"
// STATIC:		"MULTIBLEND"		"0..1"

// STATIC:		"SELFILLUM"					"0..1"
// STATIC:		"SELFILLUM_MASK"			"0..1"
// STATIC:		"SELFILLUM_ENVMAP_ALPHA"	"0..1"

// STATIC:		"PARALLAXCORRECT"			"0..1"

// DYNAMIC:		"PIXELFOGTYPE"		"0..1"
// DYNAMIC:		"REFLECTVIEW"		"0..1"

// SKIP:		$ALPHATEST && $TRANSLUCENT
// SKIP:		!$ENVMAP && $ENVMAPFRESNEL
// SKIP:		!$ENVMAP && $ENVMAPMASK

// SKIP:		$ENVMAP && !$READNORMAL
// SKIP:		$ENVMAPFRESNEL && !$READNORMAL
// SKIP:		$PHONGFRESNEL && !$READNORMAL
// SKIP:		$RIMLIGHT && !$READNORMAL
// SKIP:		!$RIMLIGHT && $RIMLIGHTMODULATELIGHT

// SKIP:		!$BASETEXTURE2 && !$MULTIBLEND && $BLENDMODULATE
// SKIP:		$MODEL && $BASETEXTURE2
// SKIP:		$MODEL && $MULTIBLEND
// SKIP:		$BASETEXTURE2 && $MULTIBLEND
// SKIP:		$ENVMAPMASK && $MULTIBLEND
// SKIP:		$SELFILLUM_MASK && $MULTIBLEND

// SKIP:		!$ENVMAP && $PARALLAXCORRECT
// SKIP:		$MODEL && $PARALLAXCORRECT

// SKIP:		!$SELFILLUM && $SELFILLUM_MASK
// SKIP:		!$SELFILLUM && $SELFILLUM_ENVMAP_ALPHA
// SKIP:		$SELFILLUM_MASK && $SELFILLUM_ENVMAP_ALPHA
// SKIP:		$SELFILLUM_MASK && $ENVMAPMASK
// SKIP:		$SELFILLUM_ENVMAP_ALPHA && !$ENVMAPMASK

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"
#include "common_vertexlitgeneric_dx9.h"
#include "hl2rpm_pom_fxc.h"


sampler sAlbedo							: register( s0 );

#if ALPHATEST
const float g_flAlphaRef				: register( c0 );
#endif


#if READNORMAL
sampler sNormals						: register( s1 );
#endif

sampler sLightAccum						: register( s2 );

// HL2RPM: the G-buffer depth and how it was written (WriteDepth: forward, scale; w 0 = the
// MSAA light lookup is off)
const float4 g_vecMainFwd				: register( c21 );	// xyz view forward, w G-buffer depth scale
sampler sMainDepth						: register( s11 );

#if REFLECTVIEW
// HL2RPM: a planar reflection (water, glass) is drawn with the main view's light buffer
// bound: find the reflected point in the main view and take its lighting from there
const float4 g_vecMainToScreen[4]		: register( c16 );	// world -> main view screen texcoords (rows)
const float4 g_vecMainEye				: register( c20 );	// xyz main view origin
const float4 g_vecFallbackLight			: register( c22 );	// points the main view doesn't see: rgb the sky's light, w debug view
const float4 g_vecFallbackSunDir		: register( c24 );	// xyz direction to the sun / moon
const float4 g_vecFallbackSun			: register( c25 );	// rgb its light there (a part: no shadow is known)
#endif

const float2 g_vecFullScreenTexel		: register( c1 );
const float4 g_vecFogParams				: register( c2 );
const float4 g_vecCaustics				: register( c23 );	// HL2RPM: x strength (0 = off), y time, z 1 / pattern size (units), w mip bias of the albedo (TAA)
const float3 g_vecOrigin				: register( c3 );

const float g_flPhongScale				: register( c4 );

// HL2RPM (PBR): x metalness, y the mirror reflection of the material as a non-metal (F0), z how
// much dark texels of the texture mirror less, w 1 = on;  x the albedo brightness that mirrors
// fully, y how much of its diffuse color a metal loses, z scale of all that is mirrored, w the
// light at the pixel instead of the cubemap of $envmap (0 = the cubemap; see the envmap below)
const float4 g_vecPBR					: register( c26 );
const float4 g_vecPBR2					: register( c27 );
// HL2RPM: x the most light a surface takes (x its albedo), y the most it mirrors (for F0 = 1)
const float4 g_vecLightLimit			: register( c28 );
// HL2RPM: the relief of a brush material (hl2rpm_pom_fxc.h) - its height map, x its depth (0 =
// none), y, z its fade with the distance: what the G-buffer pass shifted its normals by
sampler sPomHeight						: register( s12 );
const float4 g_vecPOM					: register( c32 );
// HL2RPM: thin things the light shines through - leaves, grass, cloth: x how much (0 = not at
// all), y how narrow the glow about the direction of the sun, z how much of the surface's own
// color the light takes on its way through;  xyz the direction to the sun / the moon
const float4 g_vecTransmit				: register( c33 );
const float4 g_vecTransmitSun			: register( c34 );

#if ENVMAP
sampler sEnvmap								: register( s3 );
const float3 g_flEnvmapTint					: register( c5 );
const float2 g_flEnvmapSaturationContrast	: register( c6 );

#	if ENVMAPMASK
sampler sEnvmapMask							: register( s4 );
#	endif

#	if PARALLAXCORRECT
const float3 cubemapPos						: register( c11 );
const float4x4 obbMatrix					: register( c12 );
#	endif

#endif

#if BASETEXTURE2
sampler sAlbedo2							: register( s5 );
#endif

#if BLENDMODULATE
sampler sBlendmodulate						: register( s6 );
#endif

#if PHONGFRESNEL || ENVMAPFRESNEL
const float3 g_flFresnelRanges				: register( c7 );
#endif

#if RIMLIGHT
const float3 g_flRimLight_Tint						: register( c8 );
const float2 g_flRimLight_Exponent_AlbedoScale		: register( c9 );
#endif

#if ENVMAPMASK && BASETEXTURE2
sampler sEnvmapMask2						: register( s7 );
#endif

#if MULTIBLEND
sampler sAlbedo2							: register( s5 );
sampler sAlbedo3							: register( s7 );
sampler sAlbedo4							: register( s8 );

#if BLENDMODULATE
sampler sBlendmodulate2						: register( s9 );
sampler sBlendmodulate3						: register( s10 );
#endif
#endif

#if SELFILLUM
const float3 g_flSelfIllum_Tint				: register( c10 );
#if SELFILLUM_MASK
sampler sSelfIllumMask						: register( s4 ); // override envmap mask
#endif
#endif

struct PS_INPUT
{
#if BLENDMODULATE
	float4 vTexCoord				: TEXCOORD0;
#else
	float2 vTexCoord				: TEXCOORD0;
#endif

	// HL2RPM: from the surface to the eye in tangent space (the relief; ( 0, 0, 1 ) without)
	float3 vecViewTS				: TEXCOORD1;
	float3 vWorldPos				: TEXCOORD2;

#if ENVMAP || RIMLIGHT || PHONGFRESNEL || ENVMAPFRESNEL
	float3 worldToEye				: TEXCOORD3;
#endif

#if BASETEXTURE2
	float4 vColor_0					: COLOR0;
#endif

#if MULTIBLEND
#if BLENDMODULATE
	float4 vTexCoordBlendmod23			: TEXCOORD4;
#endif
	float3 vAlphaBlend					: TEXCOORD5;
	float4 vColorBlend1					: COLOR0;
	float4 vColorBlend2					: COLOR1;
	float4 vColorBlend3					: TEXCOORD6;
	float3 vColorBlend4					: TEXCOORD7;
#endif

#if NOCULL
	float vDir						: VFACE;
#endif

	float2 vScreenPos				: VPOS;
};


struct PS_OUTPUT
{
	float4 vColor_0				:	COLOR0;
};


PS_OUTPUT main( const PS_INPUT In )
{
	PS_OUTPUT Out;

	// HL2RPM: the relief of the material - the texture coordinate moved to where the view ray
	// meets it (the same shift the G-buffer pass gave its normals). What is sampled with it gives
	// its gradients - those of the coordinate as it came: the shifted one is out of a loop.
	const float2 vecUVdx = ddx( In.vTexCoord.xy );
	const float2 vecUVdy = ddy( In.vTexCoord.xy );
	const float2 vecUV = ParallaxOcclusionUV( sPomHeight, In.vTexCoord.xy, In.vecViewTS, g_vecPOM );
	// HL2RPM: with TAA the frame is the average of jittered frames - a box filter of a pixel on
	// top of the texture filtering: textures looked soft. The albedo is sampled a little sharper
	// then (a negative mip bias, c23.w - here as smaller gradients); TAA resolves what that
	// would alias.
	const float flMipScale = exp2( g_vecCaustics.w );
	const float2 vecAlbedoDx = vecUVdx * flMipScale;
	const float2 vecAlbedoDy = vecUVdy * flMipScale;
#define SAMPLE_ALBEDO( _s ) tex2Dgrad( _s, vecUV, vecAlbedoDx, vecAlbedoDy )
#define SAMPLE_UV( _s ) tex2Dgrad( _s, vecUV, vecUVdx, vecUVdy )

	float4 flAlbedoSample = SAMPLE_ALBEDO( sAlbedo );

#if BASETEXTURE2
	float4 flAlbedoSample2 = SAMPLE_ALBEDO( sAlbedo2 );
	float flBlendfactor = In.vColor_0.w;
#if BLENDMODULATE
	flBlendfactor = GetModulatedBlend( flBlendfactor, tex2D( sBlendmodulate, In.vTexCoord.zw ).rg );
#endif
	flAlbedoSample = lerp( flAlbedoSample, flAlbedoSample2, flBlendfactor );
#endif

#if MULTIBLEND
	float remaining = 1;
	float4 flBlendFactors;

#if BLENDMODULATE
	flBlendFactors.x = GetMultiBlendModulated( tex2D( sBlendmodulate, In.vTexCoord.zw ).rg, In.vColorBlend1.a, In.vAlphaBlend.x, remaining );
	flBlendFactors.y = GetMultiBlendModulated( tex2D( sBlendmodulate2, In.vTexCoordBlendmod23.xy ).rg, In.vColorBlend2.a, In.vAlphaBlend.y, remaining );
	flBlendFactors.z = GetMultiBlendModulated( tex2D( sBlendmodulate3, In.vTexCoordBlendmod23.zw ).rg, In.vColorBlend3.a, In.vAlphaBlend.z, remaining );
#else
	flBlendFactors.x = GetMultiBlend( In.vColorBlend1.a, remaining );
	flBlendFactors.y = GetMultiBlend( In.vColorBlend2.a, remaining );
	flBlendFactors.z = GetMultiBlend( In.vColorBlend3.a, remaining );
#endif
	flBlendFactors.w = remaining;

	flAlbedoSample = flAlbedoSample * flBlendFactors.x
		+ SAMPLE_ALBEDO( sAlbedo2 ) * flBlendFactors.y
		+ SAMPLE_ALBEDO( sAlbedo3 ) * flBlendFactors.z
		+ SAMPLE_ALBEDO( sAlbedo4 ) * flBlendFactors.w;

	flAlbedoSample.rgb *= In.vColorBlend1.rgb * flBlendFactors.x
		+ In.vColorBlend2.rgb * flBlendFactors.y
		+ In.vColorBlend3.rgb * flBlendFactors.z
		+ In.vColorBlend4.rgb * flBlendFactors.w;
#endif

#if ALPHATEST
	// (the coverage exactly as the G-buffer pass tests it: the base texture, no mip bias)
	clip( SAMPLE_UV( sAlbedo ).a - g_flAlphaRef );
#endif

#if TRANSLUCENT
	Out.vColor_0.w = flAlbedoSample.a;
#else
	Out.vColor_0.w = 1;
#endif

	//float2 screenPos = GetLightAccumUVs( In.vProjPosXYW, g_vecHalfScreenTexel );
	float2 screenPos = ( In.vScreenPos + 0.5f ) * g_vecFullScreenTexel;

#if REFLECTVIEW
	float4 mainPos = float4( In.vWorldPos, 1.0f );
	float4 mainTex = float4( dot( g_vecMainToScreen[0], mainPos ), dot( g_vecMainToScreen[1], mainPos ),
		0.0f, dot( g_vecMainToScreen[3], mainPos ) );
	float2 mainUV = mainTex.xy / max( mainTex.w, 0.001f );
	float mainZ = dot( In.vWorldPos - g_vecMainEye.xyz, g_vecMainFwd.xyz );
	float gbufZ = tex2D( sMainDepth, mainUV ).x / max( g_vecMainFwd.w, 1e-6f );
	// (on the main view's screen: compared, not "saturate( uv ) - uv == 0" - the two uv of that
	// difference came out of different instructions (a mul and a mad) and never cancelled exactly:
	// the test failed for every pixel and every reflection was lit by the fallback light alone -
	// flat, unshadowed, as bright in a wall's shade as in the sun)
	const float2 vecInside = step( 0.0f, mainUV ) * step( mainUV, 1.0f );
	const float flOnScreen = ( mainTex.w > 0.0f ) ? vecInside.x * vecInside.y : 0.0f;
	float flVisible = ( flOnScreen > 0.5f && abs( gbufZ - mainZ ) < max( 8.0f, mainZ * 0.02f ) ) ? 1.0f : 0.0f;
	// what the main view doesn't see: the sky's light and the sun's by the facing of the surface
	// (the face normal from the position's derivatives, toward this view's camera)
	float3 vecFace = normalize( cross( ddx( In.vWorldPos ), ddy( In.vWorldPos ) ) );
	vecFace *= sign( dot( vecFace, g_vecOrigin - In.vWorldPos ) );
	const float3 vecFallback = g_vecFallbackLight.rgb
		+ g_vecFallbackSun.rgb * saturate( dot( vecFace, g_vecFallbackSunDir.xyz ) );
	float4 flLighting = lerp( float4( vecFallback, 0.0f ), ReadLighting( tex2D( sLightAccum, mainUV ) ), flVisible );
	screenPos = mainUV;
	// r_deferred_reflect_debug: r seen by the main view, g how far its depth there is from this
	// point's (64 units = 1), b on the main view's screen
	if ( g_vecFallbackLight.w > 0.5f )
	{
		Out.vColor_0 = float4( flVisible, saturate( abs( gbufZ - mainZ ) * ( 1.0f / 64.0f ) ), flOnScreen, 1.0f );
		return Out;
	}
#else
#if !TRANSLUCENT
	// HL2RPM: with MSAA the pixel shader runs once per pixel for every triangle covering it,
	// but the light buffer holds one surface per pixel - the one at the pixel's center. The
	// fragments of the other triangles (thin ribs of corrugated metal, railings, wires, the
	// silhouette of everything) took the light of whatever was behind or next to them: lit
	// and shadowed stripes crawled along every edge while walking. The light of the
	// neighbouring pixel whose G-buffer depth matches this fragment instead.
	[branch]
	if ( g_vecMainFwd.w > 0.0f )
	{
		const float fragZ = dot( g_vecMainFwd.xyz, In.vWorldPos - g_vecOrigin ) * g_vecMainFwd.w;
		float best = abs( tex2Dlod( sMainDepth, float4( screenPos, 0, 0 ) ).x - fragZ );
		[branch]
		if ( best > max( g_vecMainFwd.w, fragZ * 0.004f ) )
		{
			const float2 vecOffsets[8] =
			{
				float2( -1, 0 ), float2( 1, 0 ), float2( 0, -1 ), float2( 0, 1 ),
				float2( -1, -1 ), float2( 1, -1 ), float2( -1, 1 ), float2( 1, 1 ),
			};
			float2 bestUV = screenPos;
			[unroll]
			for ( int k = 0; k < 8; k++ )
			{
				const float2 uvN = screenPos + vecOffsets[k] * g_vecFullScreenTexel;
				const float dN = abs( tex2Dlod( sMainDepth, float4( uvN, 0, 0 ) ).x - fragZ );
				if ( dN < best )
				{
					best = dN;
					bestUV = uvN;
				}
			}
			screenPos = bestUV;
		}
	}
#endif
	// (explicit LOD: the coordinates may come from the branch above; the targets have no mips)
	float4 flLighting = ReadLighting( tex2Dlod( sLightAccum, float4( screenPos, 0, 0 ) ) );
#endif

	// HL2RPM: right at a lamp the light is many times what a lit surface of the day gets - the
	// maps' lamps were set for lightmaps, which hold no more than twice "white": a patch of pure
	// white on the ground under every strong lamp, white characters standing in it. A soft limit
	// (nothing changes below about half of it; the sun stays as it is).
	{
		const float flLum = dot( flLighting.rgb, float3( 0.3f, 0.59f, 0.11f ) );
		float2 vecOver = float2( flLum, flLighting.w ) / g_vecLightLimit.xy;
		vecOver *= vecOver;
		vecOver = rsqrt( sqrt( 1.0f + vecOver * vecOver ) );
		flLighting.rgb *= vecOver.x;
		flLighting.w *= vecOver.y;
	}

#if READNORMAL
	float3 worldNormal = tex2Dlod( sNormals, float4( screenPos, 0, 0 ) ).xyz * 2.0f - 1.0f;
#if REFLECTVIEW
	worldNormal = lerp( vecFace, worldNormal, flVisible );
#endif
#endif


#if RIMLIGHT || PHONGFRESNEL || ENVMAPFRESNEL
	float3 worldToEye = normalize( In.worldToEye );
	worldNormal = normalize( worldNormal );
#endif

#if PHONGFRESNEL || ENVMAPFRESNEL
	float flFresnel = saturate( Fresnel( worldNormal, worldToEye, g_flFresnelRanges ) );
#endif

#if PHONGFRESNEL
	flLighting.w *= flFresnel;
#endif

	float3 flSpecularLighting = (float3)0;

#if RIMLIGHT
	float dotEyeVec = 1.0f - saturate( dot( worldNormal, worldToEye ) );

	float3 rimLighting = pow( dotEyeVec, g_flRimLight_Exponent_AlbedoScale.x );
	rimLighting *= lerp( 1, flAlbedoSample.rgb, g_flRimLight_Exponent_AlbedoScale.y );
	rimLighting *= g_flRimLight_Tint;
#if RIMLIGHTMODULATELIGHT
	rimLighting *= dot( flLighting.rgb, float3( 0.299f, 0.587f, 0.114f ) );
#endif

	flSpecularLighting += rimLighting;
#endif


#if ENVMAP
	float flSpecularFactor;
#if ENVMAPMASK
	float4 vecEnvmapmaskColor = SAMPLE_UV( sEnvmapMask );
#if BASETEXTURE2
	vecEnvmapmaskColor = lerp( vecEnvmapmaskColor,
		SAMPLE_UV( sEnvmapMask2 ),
		flBlendfactor );
#endif
	flSpecularFactor = vecEnvmapmaskColor.r;
#else
	flSpecularFactor = flAlbedoSample.a;
#endif

#if RIMLIGHT
	float3 reflectVect = reflect( worldToEye, worldNormal );
#else
	float3 reflectVect = CalcReflectionVectorUnnormalized( worldNormal, In.worldToEye );
#endif

#if PARALLAXCORRECT
	float3 positionLS = mul(float4(In.vWorldPos, 1), obbMatrix);
	float3 rayLS = mul(reflectVect, (float3x3) obbMatrix);

	float3 firstPlaneIntersect = (float3(1.0f, 1.0f, 1.0f) - positionLS) / rayLS;
	float3 secondPlaneIntersect = (-positionLS) / rayLS;
	float3 furthestPlane = max(firstPlaneIntersect, secondPlaneIntersect);
	float dist = min(furthestPlane.x, min(furthestPlane.y, furthestPlane.z));

	// Use distance in WS directly to recover intersection
	float3 intersectPositionWS = In.vWorldPos + reflectVect * dist;
	reflectVect = intersectPositionWS - cubemapPos;
#endif

	float3 flCubemap = ENV_MAP_SCALE * texCUBE( sEnvmap, reflectVect ).rgb;
	// HL2RPM: no cubemap to mirror - a map whose cubemaps were never built hands out the
	// engine's default one (a greenish blur, the same at noon, in a storm and at night: "fullbright"
	// shields, glass and floors in the rain), and a model's is not bound here at all. What a
	// surface mirrors is about as bright and as colored as what lights it: the light at the pixel
	// stands for its surroundings.
	if ( g_vecPBR2.w > 0.0f )
		flCubemap = flLighting.rgb * g_vecPBR2.w;
	flCubemap *= flSpecularFactor;
	flCubemap *= g_flEnvmapTint;

#if ENVMAPFRESNEL
	flCubemap *= flFresnel;
#endif

	float3 specularLightingSquared = flCubemap * flCubemap;
	flCubemap = lerp( flCubemap, specularLightingSquared, g_flEnvmapSaturationContrast.y );
	float3 greyScale = dot( flCubemap, float3( 0.299f, 0.587f, 0.114f ) );
	flCubemap = lerp( greyScale, flCubemap, g_flEnvmapSaturationContrast.x );

	flSpecularLighting += flCubemap;
#endif

#if SELFILLUM
	float flSelfIllumAmount;
#if SELFILLUM_MASK
	flSelfIllumAmount = SAMPLE_UV( sSelfIllumMask ).r;
#elif SELFILLUM_ENVMAP_ALPHA
	flSelfIllumAmount = vecEnvmapmaskColor.a;
#else
	flSelfIllumAmount = flAlbedoSample.a;
#endif
	flLighting.rgb = max( flLighting.rgb,
		flAlbedoSample.rgb * g_flSelfIllum_Tint * flSelfIllumAmount );
#endif

	float flLightScale =
#if DEFCFG_USE_SRGB_CONVERSION
		LINEAR_LIGHT_SCALE;
#else
		GAMMA_LIGHT_SCALE;
#endif

	float3 vecDiffuseColor = flAlbedoSample.rgb;
	// (the highlight of before: a phong term scaled per material - 0 for every stock material)
	float3 vecMirrored = flLighting.w * g_flPhongScale * flLighting.xyz;
#if !TRANSLUCENT
	// HL2RPM (PBR): what the surface mirrors. The light passes left its luminance in the alpha
	// of the light buffer - the reflections of the sun and the lamps by the roughness of the
	// G-buffer and the light around the point, with their growth toward glancing angles - for a
	// surface that mirrors all of it from the front. This material's share (F0): a few % for a
	// non-metal; a metal mirrors much more, in its own color, and scatters little. The light
	// mirrored has the color of the light at the pixel. Dark texels - the cracks, the dirt, the
	// seams painted into a stock texture - mirror less.
	if ( g_vecPBR.w > 0.5f )
	{
		const float3 vecF0 = lerp( g_vecPBR.yyy, flAlbedoSample.rgb, g_vecPBR.x );
		const float flLightLum = dot( flLighting.rgb, float3( 0.3f, 0.59f, 0.11f ) );
		const float flCavity = lerp( 1.0f, saturate( dot( flAlbedoSample.rgb, float3( 0.3f, 0.59f, 0.11f ) ) * g_vecPBR2.x ), g_vecPBR.z );
		vecMirrored = flLighting.rgb * ( flLighting.w / max( flLightLum, 1e-4f ) ) * vecF0 * ( flCavity * g_vecPBR2.z );
		vecDiffuseColor *= 1.0f - g_vecPBR.x * g_vecPBR2.y;
		// r_deferred_pbr_debug: 1 = what is mirrored alone, 2 = what is scattered alone
		if ( g_vecPBR.w > 2.5f )
			vecMirrored = 0.0f;
		else if ( g_vecPBR.w > 1.5f )
			vecDiffuseColor = 0.0f;
	}
#endif

	Out.vColor_0.xyz = ( vecDiffuseColor * flLighting.xyz + vecMirrored + flSpecularLighting ) * flLightScale;

	// HL2RPM: thin things the light shines through. A leaf between the eye and the sun glows:
	// what comes through it is the light on its far side, in the leaf's own color once more. The
	// light passes light such a surface from both sides ($litface); here, looking toward the sun,
	// it is brighter and more saturated - the more the closer to the sun's direction.
	{
		const float3 vecRay = normalize( In.vWorldPos - g_vecOrigin );
		const float flThrough = pow( saturate( dot( vecRay, g_vecTransmitSun.xyz ) ), g_vecTransmit.y );
		Out.vColor_0.xyz *= 1.0f + g_vecTransmit.x * flThrough * lerp( 1.0f, flAlbedoSample.rgb * 2.2f, g_vecTransmit.z );
	}

#if PIXELFOGTYPE == 0
	float fogAmt = CalcPixelFogFactor( PIXELFOGTYPE, g_vecFogParams, g_vecOrigin, In.vWorldPos, 0 );

	// HL2RPM: squared like BlendPixelFog of the stock shaders ("closer to hardware fog"):
	// linear, half way to the fog end was half fogged instead of a quarter - the distant
	// skybox city and the Citadel were all hazy where the maps only fog their far parts
	fogAmt = saturate( fogAmt );
	Out.vColor_0.xyz = lerp( Out.vColor_0.xyz, g_LinearFogColor, fogAmt * fogAmt );
#else
	// HL2RPM: fog below the water surface = the refraction view of a water. The water shader
	// fades its fog color in by the dest alpha of this view (without it the target kept the
	// clear alpha 255: every water was opaque fog color). The stock shaders
	// (WRITEWATERFOGTODESTALPHA) write the fog amount of the water the engine picked - the one
	// closest in view - and fog the color with it; but one refraction view serves every water
	// in sight: turning the camera next to a clear pool and a murky one, the clear pool turned
	// opaque olive whenever the murky one was picked. The alpha is the depth under the surface
	// now, sqrt( depth / 1024 units ), the color unfogged: each water makes its own fog of it
	// (water_ps2x_helper.h, DecodeRefractFog).
	const float flDepthUnder = saturate( ( g_vecFogParams.y - In.vWorldPos.z - 2.0f ) * ( 1.0f / 1024.0f ) );
#if !TRANSLUCENT
	Out.vColor_0.w = sqrt( flDepthUnder );
#endif

	// HL2RPM: caustics - the sun light the waves focus into moving bright lines on what lies under
	// the water, only where it is sunlit (bright light buffer), fading in below the surface and
	// out with depth (iterated warp, after Dave Hoskins' tileable water caustic). There the
	// position itself (~ -250) scaled the line terms; here that magnitude is a constant: the
	// pattern tiles without seams and looks the same everywhere (with the world position it
	// blew up into white near the map origin). The light is redistributed - the mean stays.
	//
	// Two layers of it, the second larger, turned and out of step: one layer repeats every pattern
	// size (48 units) - from a few steps away the pool floor was a grid of identical cells. And on
	// what the light falls along (walls: the face normal from the position's derivatives) nothing:
	// a pattern of the horizontal position alone drew vertical stripes down every wall.
	const float3 vecFaceNormal = normalize( cross( ddx( In.vWorldPos ), ddy( In.vWorldPos ) ) );
	[branch]
	if ( g_vecCaustics.x > 0.0f )
	{
		const float flUnder = g_vecFogParams.y - In.vWorldPos.z;
		const float flFade = saturate( flUnder / 6.0f ) * saturate( 1.0f - flUnder / 320.0f )
			* saturate( abs( vecFaceNormal.z ) * 2.5f - 0.75f );
		const float flSunlit = saturate( ( dot( flLighting.xyz, float3( 0.3f, 0.59f, 0.11f ) ) - 0.25f ) * 1.5f );
		[branch]
		if ( flFade * flSunlit > 0.001f )
		{
			const float2 q = In.vWorldPos.xy * g_vecCaustics.z;
			const float2 pA = frac( q ) * 6.2831853f;
			// (turned by 37 degrees, 1.83 x larger)
			const float2 pB = frac( float2( q.x * 0.4364f + q.y * 0.3289f, q.y * 0.4364f - q.x * 0.3289f ) + 0.37f ) * 6.2831853f;
			float2 wA = pA;
			float2 wB = pB;
			float cA = 1.0f;
			float cB = 1.0f;
			[unroll]
			for ( int n = 0; n < 4; n++ )
			{
				const float ttA = g_vecCaustics.y * ( 1.0f - 3.5f / ( n + 1.0f ) );
				wA = pA + float2( cos( ttA - wA.x ) + sin( ttA + wA.y ), sin( ttA - wA.y ) + cos( ttA + wA.x ) );
				const float sA = sin( wA.x + ttA );
				const float kA = cos( wA.y + ttA );
				// 1 / length( 1.25 / s, 1.25 / k )
				cA += abs( sA * kA ) * rsqrt( sA * sA + kA * kA + 1e-6f ) * 0.8f;

				const float ttB = ( g_vecCaustics.y * 0.71f + 11.3f ) * ( 1.0f - 3.5f / ( n + 1.0f ) );
				wB = pB + float2( cos( ttB - wB.x ) + sin( ttB + wB.y ), sin( ttB - wB.y ) + cos( ttB + wB.x ) );
				const float sB = sin( wB.x + ttB );
				const float kB = cos( wB.y + ttB );
				cB += abs( sB * kB ) * rsqrt( sB * sB + kB * kB + 1e-6f ) * 0.8f;
			}
			cA = 1.17f - pow( cA * 0.25f, 1.4f );
			cB = 1.17f - pow( cB * 0.25f, 1.4f );
			// (each: mean ~0.13, lines up to ~1.1)
			const float flCaustic = pow( cA, 8.0f ) * 0.6f + pow( cB, 8.0f ) * 0.4f;
			Out.vColor_0.xyz *= max( 1.0f + ( flCaustic * 2.0f - 0.26f ) * ( g_vecCaustics.x * flFade * flSunlit ), 0.0f );
		}
	}
#endif

	return Out;
}
