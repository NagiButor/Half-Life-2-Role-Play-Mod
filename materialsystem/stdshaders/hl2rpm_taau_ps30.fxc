//========= HL2RPM ============================================================//
//
// TAA upscale (render scale; deferred_taa.cpp, DeferredTAA_DrawUpscale). The 3D view was drawn into
// a smaller frame, its projection shifted by a sub-pixel jitter each frame (Halton 2, 3 in the
// frame's pixels). Drawn over the whole screen: each screen pixel takes the frame samples around it,
// each weighted by how close its jittered position comes to the pixel's center (exp( -k d^2 ), d in
// screen pixels), and blends them into the history kept at the size of the screen - reprojected by
// the G-buffer depth as the TAA does. Over the jitter sequence the frame's samples land all over the
// screen's pixels: the history gathers the detail of the screen's resolution. The neighbourhood of
// frame samples clips the history (YCoCg box). Where there is no history (reset, out of the last
// view) the weighted samples alone: a smooth upsample. Pixels that move with the camera (the mask
// made from the TAA stencil bit) take the history of the same pixel.
//
//=============================================================================//

#include "common_ps_fxc.h"

sampler sFrame				: register( s0 );	// this frame at the render scale (gamma space), point
sampler sHistory			: register( s1 );	// the result of the last frame at the size of the screen
sampler sDepth				: register( s2 );	// G-buffer linear depth (render scale)
sampler sMask				: register( s3 );	// 1 = moves with the camera (render scale)

const float4 g_vecTexel		: register( c0 );	// the history target: 1 / size, size
const float4 g_vecPrevX		: register( c1 );	// position relative to this frame's camera -> last frame's clip
const float4 g_vecPrevY		: register( c2 );	// space (unjittered): rows x, y, w
const float4 g_vecPrevW		: register( c3 );
const float4 g_vecCurX		: register( c4 );	// ... -> this frame's clip space (unjittered)
const float4 g_vecCurY		: register( c5 );
const float4 g_vecCurW		: register( c6 );
const float4 g_vecCamDelta	: register( c7 );	// xyz last camera position - this one
const float4 g_vecTAA		: register( c8 );	// x history weight (like the frame), y (unlike it), z clip box size, w reset
const float4 g_vecTAA2		: register( c9 );	// x debug, y motion (screen pixels) at which less history is kept, zw screen / history target
const float4 g_vecTAA3		: register( c10 );	// x frame number, y history weight in motion, z sample weight falloff k
const float4 g_vecLow		: register( c11 );	// the frame: xy 1 / its target's size, zw the frame's size
const float4 g_vecJitter	: register( c12 );	// xy where this frame's samples lie off their pixel centers (frame pixels, y down), zw frame / screen

struct PS_INPUT
{
	float2 vTexCoord			: TEXCOORD0;	// over the history target (the screen's part of it)
	float3 vecWorldRay			: TEXCOORD1;
	float2 vScreenPos			: VPOS;
};

float3 RGBToYCoCg( float3 c )
{
	return float3( dot( c, float3( 0.25, 0.5, 0.25 ) ), dot( c, float3( 0.5, 0.0, -0.5 ) ), dot( c, float3( -0.25, 0.5, -0.25 ) ) );
}

float3 YCoCgToRGB( float3 c )
{
	return float3( c.x + c.y - c.z, c.x + c.z, c.x - c.y - c.z );
}

// the history: Catmull-Rom from 5 bilinear taps
float3 SampleHistory( float2 uv )
{
	const float2 pos = uv * g_vecTexel.zw;
	const float2 center = floor( pos - 0.5 ) + 0.5;
	const float2 f = pos - center;
	const float2 f2 = f * f;
	const float2 f3 = f2 * f;
	const float2 w0 = -0.5 * f3 + f2 - 0.5 * f;
	const float2 w1 = 1.5 * f3 - 2.5 * f2 + 1.0;
	const float2 w2 = -1.5 * f3 + 2.0 * f2 + 0.5 * f;
	const float2 w3 = 0.5 * f3 - 0.5 * f2;
	const float2 w12 = w1 + w2;
	const float2 tc0 = ( center - 1.0 ) * g_vecTexel.xy;
	const float2 tc3 = ( center + 2.0 ) * g_vecTexel.xy;
	const float2 tc12 = ( center + w2 / w12 ) * g_vecTexel.xy;

	const float wa = w12.x * w0.y;
	const float wb = w0.x * w12.y;
	const float wc = w12.x * w12.y;
	const float wd = w3.x * w12.y;
	const float we = w12.x * w3.y;

	float3 c = tex2Dlod( sHistory, float4( tc12.x, tc0.y, 0, 0 ) ).rgb * wa
		+ tex2Dlod( sHistory, float4( tc0.x, tc12.y, 0, 0 ) ).rgb * wb
		+ tex2Dlod( sHistory, float4( tc12.x, tc12.y, 0, 0 ) ).rgb * wc
		+ tex2Dlod( sHistory, float4( tc3.x, tc12.y, 0, 0 ) ).rgb * wd
		+ tex2Dlod( sHistory, float4( tc12.x, tc3.y, 0, 0 ) ).rgb * we;
	return max( c / ( wa + wb + wc + wd + we ), 0.0 );
}

float3 ClipToBox( float3 boxMin, float3 boxMax, float3 q )
{
	const float3 center = 0.5 * ( boxMax + boxMin );
	const float3 extents = 0.5 * ( boxMax - boxMin ) + 1e-4;
	const float3 v = q - center;
	const float3 a = abs( v / extents );
	const float ma = max( a.x, max( a.y, a.z ) );
	return ( ma > 1.0 ) ? center + v / ma : q;
}

float4 main( const PS_INPUT In ) : COLOR
{
	// this screen pixel: 0..1 over the screen, and its center in the frame's pixels
	const float2 uvScreen = In.vTexCoord / g_vecTAA2.zw;
	const float2 q = uvScreen * g_vecLow.zw;
	// the frame pixel whose sample (its center + the jitter) is nearest
	const float2 k = floor( q - g_vecJitter.xy );
	const float2 screenPerFrame = 1.0 / g_vecJitter.zw;

	float3 m1 = 0;
	float3 m2 = 0;
	float3 nmin = 1e3;
	float3 nmax = -1e3;
	float3 sumC = 0;
	float sumW = 0;
	[unroll]
	for ( int y = -1; y <= 1; y++ )
	{
		[unroll]
		for ( int x = -1; x <= 1; x++ )
		{
			const float2 kk = clamp( k + float2( x, y ), 0.0, g_vecLow.zw - 1.0 );
			const float3 s = RGBToYCoCg( tex2Dlod( sFrame, float4( ( kk + 0.5 ) * g_vecLow.xy, 0, 0 ) ).rgb );
			m1 += s;
			m2 += s * s;
			nmin = min( nmin, s );
			nmax = max( nmax, s );
			const float2 d = ( kk + 0.5 + g_vecJitter.xy - q ) * screenPerFrame;
			const float w = exp( -g_vecTAA3.z * dot( d, d ) );
			sumC += s * w;
			sumW += w;
		}
	}
	const float3 cur = sumC / max( sumW, 1e-4 );
	const float3 mean = m1 * ( 1.0 / 9.0 );
	const float3 sigma = sqrt( max( m2 * ( 1.0 / 9.0 ) - mean * mean, 0.0 ) );

	// the nearest sample's depth and camera mask
	const float2 uvK = ( clamp( k, 0.0, g_vecLow.zw - 1.0 ) + 0.5 ) * g_vecLow.xy;
	const bool bAttached = tex2Dlod( sMask, float4( uvK, 0, 0 ) ).r > 0.5;

	float2 velocity = 0;
	if ( !bAttached )
	{
		const float depth = tex2Dlod( sDepth, float4( uvK, 0, 0 ) ).x;
		const float4 P = ( depth > 0.1 ) ? float4( In.vecWorldRay * depth, 1.0 ) : float4( In.vecWorldRay, 0.0 );
		const float4 Pprev = float4( P.xyz - g_vecCamDelta.xyz * P.w, P.w );
		const float3 clipPrev = float3( dot( g_vecPrevX, Pprev ), dot( g_vecPrevY, Pprev ), dot( g_vecPrevW, Pprev ) );
		const float3 clipCur = float3( dot( g_vecCurX, P ), dot( g_vecCurY, P ), dot( g_vecCurW, P ) );
		const float2 ndcPrev = clipPrev.xy / ( abs( clipPrev.z ) > 1e-6 ? clipPrev.z : 1e-6 );
		const float2 ndcCur = clipCur.xy / ( abs( clipCur.z ) > 1e-6 ? clipCur.z : 1e-6 );
		velocity = ( ndcPrev - ndcCur ) * float2( 0.5, -0.5 ) * g_vecTAA2.zw;
		velocity = ( clipPrev.z > 0.0 ) ? velocity : float2( 2.0, 2.0 );
	}
	const float2 uvHist = In.vTexCoord + velocity;
	const bool bOutside = any( uvHist < 0.0 ) || any( uvHist > g_vecTAA2.zw );

	float3 histRGB;
	[branch]
	if ( dot( velocity, velocity ) < 1e-14 )
		histRGB = tex2Dlod( sHistory, float4( uvHist, 0, 0 ) ).rgb;
	else
		histRGB = SampleHistory( uvHist );
	const float3 hist = RGBToYCoCg( histRGB );

	const float3 boxMin = max( nmin, mean - g_vecTAA.z * sigma );
	const float3 boxMax = min( nmax, mean + g_vecTAA.z * sigma );
	const float3 histClipped = ClipToBox( boxMin, boxMax, hist );

	const float flDiff = abs( cur.x - histClipped.x ) / max( max( cur.x, histClipped.x ), 0.2 );
	const float flMatch = ( 1.0 - flDiff ) * ( 1.0 - flDiff );
	float flHistory = lerp( g_vecTAA.y, g_vecTAA.x, flMatch );

	const float flSpeed = length( velocity * g_vecTexel.zw );
	const float flMotion = saturate( flSpeed / max( g_vecTAA2.y, 0.5 ) );
	flHistory *= lerp( 1.0, g_vecTAA3.y, flMotion );

	// this frame's share: as much as its samples come near the pixel (a sample right at the center
	// gives the TAA's full share, none nearby - the history alone)
	float flCur = ( 1.0 - flHistory ) * saturate( sumW );
	flCur = ( bOutside || g_vecTAA.w > 0.5 ) ? 1.0 : flCur;

	float3 result = YCoCgToRGB( lerp( histClipped, cur, flCur ) );

	// r_deferred_taa_debug: red over the grey frame - 1 motion, 2 clip, 3 camera mask, 4 this frame's share
	if ( g_vecTAA2.x > 0.5 )
	{
		float flDebug;
		if ( g_vecTAA2.x < 1.5 )
			flDebug = bOutside ? 1.0 : saturate( flSpeed / 16.0 );
		else if ( g_vecTAA2.x < 2.5 )
			flDebug = saturate( length( hist - histClipped ) * 8.0 );
		else if ( g_vecTAA2.x < 3.5 )
			flDebug = bAttached ? 1.0 : 0.0;
		else
			flDebug = flCur * 4.0;
		const float g = dot( saturate( result ), float3( 0.299, 0.587, 0.114 ) ) * 0.7;
		return float4( lerp( g, 1.0, saturate( flDebug ) ), g * ( 1.0 - saturate( flDebug ) ), g * ( 1.0 - saturate( flDebug ) ), 1.0 );
	}

	// dither to the 8 bits of the history
	const float flNoise = frac( 52.9829189 * frac( dot( In.vScreenPos + g_vecTAA3.x * 5.588238, float2( 0.06711056, 0.00583715 ) ) ) );
	result += ( flNoise - 0.5 ) * ( 1.0 / 255.0 );

	return float4( saturate( result ), 1.0 );
}
