//========= HL2RPM ============================================================//
//
// Volumetric sun light: raymarch the cascaded sun shadow map through the
// weather's height fog. Rendered at 1/4 resolution into the volumetrics
// buffer, blurred and added by the existing volumetrics blend pass.
//
//=============================================================================//

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"

sampler sDepth						: register( s0 );
sampler sShadowDepth				: register( s1 );	// CSM atlas, hardware compare
sampler sWeatherMap					: register( s2 );
sampler sRainDepth					: register( s3 );	// HL2RPM: rain map hardware depth (compare)

const float3 g_vecViewOrigin		: register( c0 );
const float3 g_vecLightDir			: register( c1 );	// direction to the light

// same layout as lightingpass_global_ps30 (CommitShadowProjectionConstants_Ortho_Composite at c2)
const float4x3 g_matOrtho[8]		: register( c2 );
const float4 g_vecUVTransform[8]	: register( c26 );

const float4 g_vecLightColor		: register( c58 );
const float4 g_vecFog				: register( c59 );	// density, falloff, base z, volumetric strength
const float4 g_vecCloud0			: register( c60 );	// coverage, density, type, darkness
const float4 g_vecCloud1			: register( c61 );	// base (m), thickness, cirrus, time
const float4 g_vecWind				: register( c62 );	// xy cloud offset (m)
const float4 g_vecParams			: register( c63 );	// steps, max distance, frame, night
const float4 g_vecCloudSpace		: register( c64 );	// x cloud space meters per unit
const float4 g_matRainMap[3]		: register( c65 );	// HL2RPM: rows of world -> rain map texture (c65 - c67)
const float4 g_vecDust				: register( c68 );	// x "covered" margin (rain map depth units), y indoor dust (extinction per unit), z rain map valid, w debug

struct PS_INPUT
{
	float2 vTexCoord			: TEXCOORD0;
	float3 vecWorldRay			: TEXCOORD1;
	float2 vScreenPos			: VPOS;
};

float CloudShadow( float3 p )
{
	// project to the cloud base along the light and look at the large scale coverage
	float3 pm = float3( p.xy * ( ( g_vecCloudSpace.x > 0.0 ) ? g_vecCloudSpace.x : 0.0254 ), p.z * 0.0254 );
	float tBase = ( g_vecCloud1.x - pm.z ) / max( g_vecLightDir.z, 0.08 );
	float2 cxy = pm.xy + g_vecLightDir.xy * tBase + g_vecWind.xy;
	float wm = tex2Dlod( sWeatherMap, float4( cxy / 40000.0, 0, 0 ) ).r;
	float cov = saturate( g_vecCloud0.x + ( wm - 0.5 ) * 0.5 * ( 1.0 - g_vecCloud0.x * 0.6 ) * saturate( ( 1.0 - g_vecCloud0.x ) * 6.0 ) );
	return 1.0 - saturate( ( cov - 0.25 ) * 1.6 ) * saturate( g_vecCloud0.y * 0.7 );
}

float PhaseHG( float g, float cosTheta )
{
	return ( 1.0 - g * g ) / pow( max( 1.0 + g * g - 2.0 * g * cosTheta, 1e-3 ), 1.5 ) * ( 1.0 / ( 4.0 * 3.14159265 ) );
}

float4 main( const PS_INPUT In ) : COLOR
{
	float depth = tex2D( sDepth, In.vTexCoord ).x;
	float rayLen = length( In.vecWorldRay );
	float3 rd = In.vecWorldRay / rayLen;

	float maxDist = g_vecParams.y;
	float dist = ( depth < 0.1 ) ? maxDist : min( depth * rayLen, maxDist );

	const float steps = max( g_vecParams.x, 4.0 );
	// Interleaved Gradient Noise (rotated temporally via golden ratio)
	float jitter = frac( 52.9829189f * frac( dot( In.vScreenPos + g_vecParams.z * 5.588238f, float2( 0.06711056f, 0.00583715f ) ) ) );
	// HL2RPM: samples spread over the visible part of the ray, denser near the eye (t = dist * u^2):
	// a window's beam a few dozen units wide fell between the evenly spaced samples of the whole
	// distance (100+ units apart) and no beam was ever seen indoors
	const float invSteps = 1.0 / steps;
	const bool bDust = g_vecDust.z > 0.5 && g_vecDust.y > 0.0;

	const float k = g_vecFog.y * 0.001;
	// base haze always present, weather fog on top
	const float sigma0 = ( 0.00006 + g_vecFog.x * 0.00030 ) * g_vecFog.w;

	// HL2RPM: hoist affine world->cascade and world->rainmap projections out of the 48-step loop
	const float4 ro4 = float4( g_vecViewOrigin, 1.0 );
	const float4 rd4 = float4( rd, 0.0 );
	float3 csmStart[4];
	float3 csmStep[4];
	[unroll]
	for ( int c = 0; c < 4; c++ )
	{
		csmStart[c] = mul( ro4, g_matOrtho[c] );
		csmStep[c] = mul( rd4, g_matOrtho[c] );
	}
	const float3 rainStart = float3( dot( g_matRainMap[0], ro4 ), dot( g_matRainMap[1], ro4 ), dot( g_matRainMap[2], ro4 ) );
	const float3 rainStep = float3( dot( g_matRainMap[0].xyz, rd ), dot( g_matRainMap[1].xyz, rd ), dot( g_matRainMap[2].xyz, rd ) );

	// Cloud attenuation varies over hundreds of meters, so evaluating once at the ray midpoint avoids
	// up to 48 texture lookups per pixel inside the march loop.
	const float cloudLit = ( g_vecCloud0.x > 0.01 ) ? CloudShadow( g_vecViewOrigin + rd * ( dist * 0.5 ) ) : 1.0;

	// (the haze and the dust apart: they scatter differently, see below)
	float inscatter = 0.0;
	float inscatterDust = 0.0;
	float T = 1.0;
	float litSum = 0.0;
	float coverSum = 0.0;

	int curC = 0;
	[loop]
	for ( int i = 0; i < 32; i++ )
	{
		if ( i >= (int)steps )
			break;

		const float u0 = i * invSteps;
		const float u1 = ( i + 1.0 ) * invSteps;
		const float uj = ( i + jitter ) * invSteps;
		const float t = dist * uj * uj;
		const float dt = dist * ( u1 * u1 - u0 * u0 );
		const float pz = g_vecViewOrigin.z + rd.z * t;

		const float sigmaFog = sigma0 * exp( -k * ( pz - g_vecFog.z ) );
		float covered = 0.0;
		[branch]
		if ( bDust )
		{
			const float3 ruvz = rainStart + rainStep * t;
			if ( all( ruvz.xy >= 0.0 ) && all( ruvz.xy <= 1.0 ) )
				covered = 1.0 - tex2Dlod( sRainDepth, float4( ruvz.xy, ruvz.z - g_vecDust.x, 0 ) ).x;
		}
		const float sigmaDust = g_vecDust.y * covered;
		// HL2RPM: monotone cascade index tracking along the outgoing camera ray (t strictly
		// increases, so once a ray exits cascade c it only advances to c+1..3 -> 1 test/step).
		float lit = 1.0;
		if ( curC == 0 )
		{
			const float3 uvz = csmStart[0] + csmStep[0] * t;
			if ( all( uvz.xy > 0.003 ) && all( uvz.xy < 0.997 ) )
				lit = tex2Dlod( sShadowDepth, float4( uvz.xy * g_vecUVTransform[0].zw + g_vecUVTransform[0].xy, uvz.z - 0.0005, 0 ) ).x;
			else
				curC = 1;
		}
		if ( curC == 1 )
		{
			const float3 uvz = csmStart[1] + csmStep[1] * t;
			if ( all( uvz.xy > 0.003 ) && all( uvz.xy < 0.997 ) )
				lit = tex2Dlod( sShadowDepth, float4( uvz.xy * g_vecUVTransform[1].zw + g_vecUVTransform[1].xy, uvz.z - 0.0005, 0 ) ).x;
			else
				curC = 2;
		}
		if ( curC == 2 )
		{
			const float3 uvz = csmStart[2] + csmStep[2] * t;
			if ( all( uvz.xy > 0.003 ) && all( uvz.xy < 0.997 ) )
				lit = tex2Dlod( sShadowDepth, float4( uvz.xy * g_vecUVTransform[2].zw + g_vecUVTransform[2].xy, uvz.z - 0.0005, 0 ) ).x;
			else
				curC = 3;
		}
		if ( curC == 3 )
		{
			const float3 uvz = csmStart[3] + csmStep[3] * t;
			if ( all( uvz.xy > 0.003 ) && all( uvz.xy < 0.997 ) )
				lit = tex2Dlod( sShadowDepth, float4( uvz.xy * g_vecUVTransform[3].zw + g_vecUVTransform[3].xy, uvz.z - 0.0005, 0 ) ).x;
			else
				curC = 4;
		}
		litSum += lit;
		coverSum += covered;

		inscatter += T * sigmaFog * lit * dt;
		inscatterDust += T * sigmaDust * lit * dt;
		T *= exp( -( sigmaFog + sigmaDust ) * dt );
	}
	inscatter *= cloudLit;
	inscatterDust *= cloudLit;
	litSum *= cloudLit;

	float cosTheta = dot( rd, g_vecLightDir );
	// HL2RPM: haze scatters most of the light it takes within a few degrees of where it was
	// going (the bright aureole around a sun in haze): a quarter of it goes into a second, narrow
	// lobe. Looking toward the sun - past the edge of a roof, through a tree's crown - the shafts
	// on open sky are twice as bright; when a solid surface (a ceiling, a roof, a wall) blocks
	// the view (depth >= 0.1), the narrow aureole is dropped and a gentle lobe like indoor dust is
	// used so the sun's halo does not glow on top of ceilings and walls in sunlit foreground haze.
	const float gDust = 0.25;
	const float phaseDust = PhaseHG( gDust, cosTheta );
	const float phase = ( depth < 0.1 )
		? ( 0.75 * PhaseHG( 0.58, cosTheta ) + 0.25 * PhaseHG( 0.82, cosTheta ) )
		: phaseDust;

	float3 light = g_vecLightColor.rgb * ( phase * inscatter + phaseDust * inscatterDust ) * 6.5;

	// r_weather_sunshafts_debug
	if ( g_vecDust.w > 0.5 )
	{
		if ( g_vecDust.w < 1.5 )
			return float4( 0.25, 0, 0, 1 );
		if ( g_vecDust.w < 2.5 )
			return float4( 0, coverSum / steps * 0.5, 0, 1 );
		if ( g_vecDust.w < 3.5 )
			return float4( 0, 0, litSum / steps * 0.5, 1 );
		const float3 ps = g_vecViewOrigin + rd * dist * 0.97;
		const float4 wp = float4( ps, 1.0 );
		const float3 uvz = float3( dot( g_matRainMap[0], wp ), dot( g_matRainMap[1], wp ), dot( g_matRainMap[2], wp ) );
		if ( g_vecDust.w < 4.5 )
		{
			const float covEnd = ( all( uvz.xy >= 0.0 ) && all( uvz.xy <= 1.0 ) )
				? ( 1.0 - tex2Dlod( sRainDepth, float4( uvz.xy, uvz.z - g_vecDust.x, 0 ) ).x )
				: 0.0;
			return float4( 0, covEnd * 0.5, 0, 1 );
		}
		return float4( saturate( uvz.xy ) * 0.5, saturate( uvz.z ) * 0.5, 1 );
	}
	return float4( light, 1.0 );
}
