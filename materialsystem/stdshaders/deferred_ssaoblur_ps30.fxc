//========= HL2RPM ============================================================//
//
// Depth-aware (bilateral) separable blur of the half resolution SSAO (r) and
// sky visibility (g).
//
//=============================================================================//

#include "common_ps_fxc.h"

sampler sAO				: register( s0 );	// half resolution AO (top left of a full size RT)
sampler sDepth			: register( s1 );	// G-buffer linear depth

const float4 g_vecBlur	: register( c0 );	// xy step (screen uv), z depth tolerance (fraction), w AO uv scale

struct PS_INPUT
{
	float2 vTexCoord			: TEXCOORD0;
	float3 vecWorldRay			: TEXCOORD1;
};

float UnpackSSAODepth( float2 ba )
{
	if ( ba.x < 0.005 )
		return 0.0;
	return ( ba.x < 0.96 ) ? ( ba.x * 520.0 - 8.0 ) : ( 400.0 + ba.y * ba.y * 11600.0 );
}

float4 main( const PS_INPUT In ) : COLOR
{
	float2 uv = In.vTexCoord;
	// (reads of the half resolution source stay half a texel inside its drawn area;
	// works for both legacy full-size RT (w = 0.5) and tight half-res RT (w = 1.0))
	const float2 uvMax = 1.0 - 0.5 * float2( abs( ddx( uv.x ) ), abs( ddy( uv.y ) ) );
	const float4 c0 = tex2Dlod( sAO, float4( clamp( uv, 0.0, uvMax ) * g_vecBlur.w, 0, 0 ) );
	const float d0 = UnpackSSAODepth( c0.ba );
	if ( d0 < 0.1 )
		return float4( 1, 1, 0, 0 );

	// 7-tap renormalized Gaussian (dropped the 1.6% outer tap; depth is packed in sAO.ba -> 0 sDepth fetches)
	static const float w[4] = { 0.2346368, 0.2011173, 0.1256983, 0.0558659 };

	// r: SSAO, g: sky visibility, ba: packed depth (passed through for vertical pass)
	float2 sum = c0.rg * w[0];
	float wsum = w[0];
	float invTol = 1.0 / max( d0 * g_vecBlur.z, 1.0 );

	[unroll]
	for ( int i = 1; i < 4; i++ )
	{
		float2 off = g_vecBlur.xy * i;

		float4 sA = tex2Dlod( sAO, float4( clamp( uv + off, 0.0, uvMax ) * g_vecBlur.w, 0, 0 ) );
		float dA = UnpackSSAODepth( sA.ba );
		float wA = w[i] * saturate( 1.0 - abs( dA - d0 ) * invTol );
		sum += sA.rg * wA;
		wsum += wA;

		float4 sB = tex2Dlod( sAO, float4( clamp( uv - off, 0.0, uvMax ) * g_vecBlur.w, 0, 0 ) );
		float dB = UnpackSSAODepth( sB.ba );
		float wB = w[i] * saturate( 1.0 - abs( dB - d0 ) * invTol );
		sum += sB.rg * wB;
		wsum += wB;
	}

	float2 ao = sum / max( wsum, 1e-4 );
	return float4( ao.x, ao.y, c0.b, c0.a );
}
