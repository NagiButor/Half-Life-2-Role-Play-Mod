
// DYNAMIC:		"HAS_SHADOW"		"0..1"


#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"

sampler sNormals							: register( s0 );
sampler sDepth								: register( s1 );
#if !DEFCFG_LIGHTCTRL_PACKING
sampler sLightCtrl							: register( s3 );
#endif

#if HAS_SHADOW
sampler sShadowDepth						: register( s2 );
#endif

const float3 g_vecViewOrigin				: register( c0 );
const float3 g_vecLightVec_Forward			: register( c1 );

// ---- cascade shadow arrays (SHADOW_NUM_CASCADES = 8) ----
// c2  – c25 : g_matOrtho        8 × float4x3 = 24 regs
// c26 – c33 : g_vecUVTransform  8 × float4   =  8 regs
// c34 – c41 : g_vecSlopeData    8 × float3   =  8 regs
// c42 – c49 : g_vecFilterConfig_A 8 × float4 =  8 regs
// c50 – c57 : g_vecFilterConfig_B 8 × float4 =  8 regs
const float4x3 g_matOrtho[8]				: register( c2 );
const float4 g_vecUVTransform[8]			: register( c26 );
const float3 g_vecSlopeData[8]				: register( c34 );
const float4 g_vecFilterConfig_A[8]			: register( c42 );
const float4 g_vecFilterConfig_B[8]			: register( c50 );

// ---- global-light data ----
const float3 g_light_diffuse				: register( c58 );
const float3 g_light_ambient_high			: register( c59 );
const float3 g_light_ambient_low_half		: register( c60 );
const float g_flCSMColorize				: register( c61 );

// ---- HL2RPM weather: moving cloud shadows ----
const float4 g_vecCloud0					: register( c62 );	// coverage, density, type, darkness
const float4 g_vecCloud1					: register( c63 );	// base (m), thickness (m), cirrus, time
const float4 g_vecWind						: register( c64 );	// xy cloud offset (m)
const float4 g_vecWeatherFlags				: register( c65 );	// x cloud shadow strength

sampler sWeatherMap							: register( s4 );
sampler sCloudNoise							: register( s5 );

// Density of the cloud column above a point, looking toward the light.
// Uses the same weather map / shape noise as the volumetric clouds so the
// shadows on the ground match the clouds in the sky.
float CloudShadow( float3 worldPos, float3 lightDir )
{
	float3 pm = worldPos * 0.0254;
	float midH = g_vecCloud1.x + g_vecCloud1.y * 0.35;
	float tMid = ( midH - pm.z ) / max( lightDir.z, 0.1 );
	float2 cxy = pm.xy + lightDir.xy * tMid + g_vecWind.xy;

	float2 wm = tex2Dlod( sWeatherMap, float4( cxy / 40000.0, 0, 0 ) ).rg;
	float coverage = saturate( g_vecCloud0.x + ( wm.x - 0.5 ) * 0.45 * ( 1.0 - g_vecCloud0.x * 0.6 ) );
	float type = saturate( g_vecCloud0.z + ( wm.y - 0.5 ) * 0.5 );

	// one slice of the shape noise where the height profile peaks (same parameterization as the clouds)
	float hs = lerp( 0.11, 0.3, type );
	float3 p = float3( cxy, hs * g_vecCloud1.y * 1.6 + g_vecCloud1.w * 3.0 ) / 8000.0;
	p = frac( p );
	float zs = p.z * 64.0 - 0.5;
	float z0 = floor( zs );
	z0 = ( z0 < 0.0 ) ? 63.0 : z0;
	float2 inTile = ( 1.0 + p.xy * 62.0 ) / 512.0;
	float2 t0 = float2( fmod( z0, 8.0 ), floor( z0 / 8.0 ) ) * 0.125;
	float4 n = tex2Dlod( sCloudNoise, float4( t0 + inTile, 0, 0 ) );
	float fbm = n.g * 0.625 + n.b * 0.25 + n.a * 0.125;
	float shape = saturate( ( ( n.r - ( fbm - 1.0 ) ) / ( 2.0 - fbm ) - 0.66 ) * ( 1.0 / 0.27 ) );

	// same coverage cut as weather_clouds_ps30 (CoverageThreshold)
	float cu = ( ( -1.0825 * coverage + 1.6586 ) * coverage - 1.1291 ) * coverage + 0.7521;
	float st = ( ( -1.2365 * coverage + 1.6690 ) * coverage - 1.1536 ) * coverage + 0.7396;
	float threshold = lerp( st, cu, type ) * saturate( ( 1.0 - coverage ) * 20.0 );
	float density = saturate( ( shape - threshold ) / max( ( 1.0 - threshold ) * 0.6, 0.05 ) ) * ( 0.35 + 0.65 * coverage );
	float opticalDepth = density * g_vecCloud0.y * 6.0;
	return 1.0 - g_vecWeatherFlags.x * ( 1.0 - exp( -opticalDepth ) );
}

struct PS_INPUT
{
	float2 vTexCoord				: TEXCOORD0;

	float3 vecWorldRay				: TEXCOORD1;
};

struct PS_OUTPUT
{
	float4 vColor_0				:	COLOR0;
};

PS_OUTPUT main( const PS_INPUT In )
{
	PS_OUTPUT Out = (PS_OUTPUT)0;

	float flDepth = tex2D( sDepth, In.vTexCoord ).x;

	clip( flDepth - 0.1f );

	float phong_exp;
	bool half_lambert, litface;

	float4 flNormalCtrl = tex2D( sNormals, In.vTexCoord );
	float3 flNormal = normalize( flNormalCtrl.xyz * 2.0f - 1.0f );
	
#if !DEFCFG_LIGHTCTRL_PACKING
	{
		float4 flLightCtrl = tex2D( sLightCtrl, In.vTexCoord );
		phong_exp = flLightCtrl.x;
		half_lambert = flLightCtrl.y;
		litface = flLightCtrl.z;
	}
#else
	UnpackLightingControls( flNormalCtrl.a, phong_exp, half_lambert, litface );
#endif

	float3 flLitNormal = lerp( 1, dot( flNormal, g_vecLightVec_Forward ), litface ) * flNormal;

	float flSpecular = max( 0, dot( normalize( -In.vecWorldRay + g_vecLightVec_Forward ), flLitNormal ) );
	flSpecular = pow( flSpecular, phong_exp ) * dot( -In.vecWorldRay, flLitNormal );

	float viewFwdDot = dot( g_vecLightVec_Forward.xyz, flLitNormal );
	float litDot = lerp( viewFwdDot, viewFwdDot * 0.5f + 0.5f, half_lambert );

	float3 diffuse = g_light_diffuse;
	float lightAmount = saturate( litDot );

	float sunVis = saturate( ( g_vecLightVec_Forward.z + 0.02 ) / 0.08 );
	lightAmount *= sunVis;

	// HL2RPM: sky light comes from above and bounce light from below (it used to be
	// oriented along the sun direction, which made overcast lighting wrong).
	float3 ambientLow = max( 2.0 * g_light_ambient_low_half - g_light_ambient_high, 0.0 );
	float skyFacing = saturate( flNormal.z * 0.5 + 0.5 ) * 0.75 + saturate( viewFwdDot * 0.5 + 0.5 ) * 0.25;
	float3 ambient = lerp( ambientLow, g_light_ambient_high, skyFacing );

	if ( g_vecWeatherFlags.x > 0.0 && lightAmount > 0.0 && flDepth < DEPTH_RECONSTRUCTION_LIMIT )
		lightAmount *= CloudShadow( g_vecViewOrigin + In.vecWorldRay * flDepth, g_vecLightVec_Forward );

#if HAS_SHADOW
	if ( flDepth < DEPTH_RECONSTRUCTION_LIMIT )
	{
		float3 worldPos = g_vecViewOrigin + In.vecWorldRay * flDepth;

		int csmCascadeIndex = 0;
		float shadowMult = PerformCascadedShadowEx( sShadowDepth, worldPos, g_matOrtho, g_vecUVTransform, g_vecSlopeData,
									g_vecFilterConfig_A, g_vecFilterConfig_B, flLitNormal, viewFwdDot, csmCascadeIndex );
		if ( g_flCSMColorize > 0.5f )
		{
			float3 cascadeColor = float3( 1, 0, 1 );
			if ( csmCascadeIndex == 0 ) cascadeColor = float3( 1, 0, 0 );       // red
			if ( csmCascadeIndex == 1 ) cascadeColor = float3( 0, 1, 0 );       // green
			if ( csmCascadeIndex == 2 ) cascadeColor = float3( 0, 0, 1 );       // blue
			if ( csmCascadeIndex == 3 ) cascadeColor = float3( 1, 1, 0 );       // yellow
			if ( csmCascadeIndex == 4 ) cascadeColor = float3( 1, 0.5, 0 );     // orange
			if ( csmCascadeIndex == 5 ) cascadeColor = float3( 0, 1, 1 );       // cyan
			if ( csmCascadeIndex == 6 ) cascadeColor = float3( 0.5, 0, 1 );     // purple
			if ( csmCascadeIndex == 7 ) cascadeColor = float3( 0.5, 0.5, 0.5 ); // gray
			Out.vColor_0 = WriteLighting( float4( cascadeColor, 0 ) );
			return Out;
		}

#if 0
		// fixes self shadowing for half lambertian, but, i don't like it!
		lightAmount *= max( shadowMult, (1.0f - saturate( viewFwdDot )) * half_lambert );
#else
		lightAmount *= shadowMult;
#endif
	}
#endif

	// HL2RPM: sky light + direct light (the old lerp *replaced* the sky light with the
	// sun wherever it was lit, so lit areas under a weak overcast sun got darker than shadow)
	// (lightAmount already contains saturate( litDot ) * sun visibility * shadows)
	float4 lighting = float4( ambient + diffuse * lightAmount, flSpecular * lightAmount );

	Out.vColor_0 = WriteLighting( lighting );

	return Out;
}
