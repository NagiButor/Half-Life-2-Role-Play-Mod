
// DYNAMIC:		"HAS_SHADOW"		"0..1"


#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"

sampler sNormals							: register( s0 );
sampler sDepth								: register( s1 );
#if !DEFCFG_LIGHTCTRL_PACKING
sampler sLightCtrl							: register( s3 );
#endif

#if HAS_SHADOW
sampler sShadowDepth						: register( s2 );
#endif

const float3 g_vecViewOrigin				: register( c0 );
const float3 g_vecLightVec_Forward			: register( c1 );

// ---- cascade shadow arrays (SHADOW_NUM_CASCADES = 8) ----
// c2  – c25 : g_matOrtho        8 × float4x3 = 24 regs
// c26 – c33 : g_vecUVTransform  8 × float4   =  8 regs
// c34 – c41 : g_vecSlopeData    8 × float3   =  8 regs
// c42 – c49 : g_vecFilterConfig_A 8 × float4 =  8 regs
// c50 – c57 : g_vecFilterConfig_B 8 × float4 =  8 regs
const float4x3 g_matOrtho[8]				: register( c2 );
const float4 g_vecUVTransform[8]			: register( c26 );
const float3 g_vecSlopeData[8]				: register( c34 );
const float4 g_vecFilterConfig_A[8]			: register( c42 );
const float4 g_vecFilterConfig_B[8]			: register( c50 );

// ---- global-light data ----
const float3 g_light_diffuse				: register( c58 );
const float3 g_light_ambient_high			: register( c59 );
const float3 g_light_ambient_low_half		: register( c60 );
const float g_flCSMColorize				: register( c61 );

// ---- HL2RPM weather: moving cloud shadows ----
const float4 g_vecCloud0					: register( c62 );	// coverage, density, type, darkness
const float4 g_vecCloud1					: register( c63 );	// base (m), thickness (m), cirrus, time
const float4 g_vecWind						: register( c64 );	// xy cloud offset (m)
const float4 g_vecWeatherFlags				: register( c65 );	// x cloud shadow strength, y cloud space meters per unit, z contact shadows: march length in texels of the cascade at the point, w close-up B-spline min scale

sampler sWeatherMap							: register( s4 );
sampler sCloudNoise							: register( s5 );

// ---- HL2RPM: ambient occlusion + sky visibility of the ambient light ----
// half resolution (top left of a full size RT), blurred: r SSAO, g sky visibility
// from the top-down occlusion map (see deferred_ssao_ps30). Deep inside buildings
// the sky light fades to the indoor level.
sampler sSSAO								: register( s6 );
const float4 g_vecAmbientCtrl				: register( c70 );	// y indoor ambient, w AO uv scale (0 = off)

// ---- HL2RPM: contact shadows debug flag (c72.z; old probe GI removed, replaced by Zenteon TurboGI) ----
const float4 g_vecGIApply					: register( c72 );	// z contact shadows debug

// ---- HL2RPM: contact shadows - a short march toward the sun through the depth buffer ----
const float4 g_matWorldToScreen[4]			: register( c73 );	// world -> screen texture coords of this view (rows, c73 - c76)
const float4 g_vecContact					: register( c77 );	// x length (units), y thickness (units), z max distance from the eye (units), w strength (0 = off)
const float4 g_vecPBR						: register( c78 );	// HL2RPM (PBR): x the sun's reflection (0 = off), y, z what a surface mirrors of the light around it, looking down / up, w least roughness for the sun
const float4 g_vecPBRWet					: register( c79 );
// HL2RPM: the sun light through foliage ($litface): x 1 / the depth in the crown (world units) over
// which it halves, y the most of it that comes through; z how bright a leaf glows seen against the
// sun (0 = not at all), w the width of that glow (an exponent of the cosine to the sun). The leaves
// are flagged in the caster depth (sShadowRaw: + 2, shadowpass_ps30): light comes through them, not
// through walls, roofs and trunks
const float4 g_vecFoliage					: register( c80 );

// Density of the cloud column above a point, looking toward the light.
// Uses the same weather map / shape noise as the volumetric clouds so the
// shadows on the ground match the clouds in the sky.
float CloudShadow( float3 worldPos, float3 lightDir )
{
	// same cloud space as the volumetric clouds (horizontal scale), real heights
	float3 pm = float3( worldPos.xy * ( ( g_vecWeatherFlags.y > 0.0 ) ? g_vecWeatherFlags.y : 0.0254 ), worldPos.z * 0.0254 );
	float midH = g_vecCloud1.x + g_vecCloud1.y * 0.35;
	float tMid = ( midH - pm.z ) / max( lightDir.z, 0.1 );
	float2 cxy = pm.xy + lightDir.xy * tMid + g_vecWind.xy;

	float4 wm = tex2Dlod( sWeatherMap, float4( cxy / 40000.0, 0, 0 ) );
	float coverage = saturate( g_vecCloud0.x + ( wm.x - 0.5 ) * 0.5 * ( 1.0 - g_vecCloud0.x * 0.6 ) * saturate( ( 1.0 - g_vecCloud0.x ) * 6.0 ) );
	float type = saturate( g_vecCloud0.z + ( wm.y - 0.5 ) * 0.7 );

	// one slice of the convex Perlin-Worley shape noise matching weather_clouds_ps30
	float hs = lerp( 0.18, 0.35, type );
	float3 p = float3( cxy, hs * g_vecCloud1.y * 1.6 + g_vecCloud1.w * 3.0 ) * ( 1.0 / 16000.0 );
	p.xy += ( wm.ba - 0.5 ) * 0.55;
	p = frac( p );
	float zs = p.z * 64.0 - 0.5;
	float z0 = floor( zs );
	z0 = ( z0 < 0.0 ) ? 63.0 : z0;
	float2 inTile = ( 1.0 + p.xy * 62.0 ) / 512.0;
	float2 t0 = float2( fmod( z0, 8.0 ), floor( z0 / 8.0 ) ) * 0.125;
	float shape = tex2Dlod( sCloudNoise, float4( t0 + inTile, 0, 0 ) ).r;

	// same coverage cut as weather_clouds_ps30 (CoverageThreshold)
	float cu = ( ( -1.2207 * coverage + 1.6196 ) * coverage - 1.4986 ) * coverage + 1.0431;
	float st = ( ( -0.6585 * coverage + 1.3479 ) * coverage - 1.7223 ) * coverage + 0.9918;
	float threshold = max( lerp( st, cu, type ), 0.0 ) * saturate( ( 1.0 - coverage ) * 20.0 );
	float edgeWidth = lerp( 0.55, 0.42, type );
	float density = smoothstep( 0.0, 1.0, saturate( ( shape - threshold ) / max( ( 1.0 - threshold ) * edgeWidth, 0.05 ) ) ) * ( 0.55 + 0.45 * coverage );
	float deck = saturate( ( coverage - 0.92 ) / 0.08 );
	density = max( density, deck * ( 0.035 + 0.22 * shape * ( 0.55 + 0.90 * wm.r ) ) );
	float opticalDepth = density * g_vecCloud0.y * 6.0;
	return 1.0 - g_vecWeatherFlags.x * ( 1.0 - exp( -opticalDepth ) );
}


#if HAS_SHADOW
// ---- HL2RPM: soft sun shadows (PCSS) ----
sampler sShadowRaw							: register( s8 );	// caster depth of the sun atlas (R32F)
const float4 g_vecPCSS						: register( c71 );	// x penumbra radius per unit of caster distance (sun), y max penumbra (texels), z max penumbra (world units), w r_csm_pcss (0 = no blocker search)
// x: how far in front of the local player's first person body casters are ignored (world
// units, r_csm_body_bias) - its hidden head and shoulders shadowed the visible torso and legs
const float4 g_vecShadowExtra				: register( c66 );	// y: shadow normal (0 G-buffer, 1 2x2 quad derivatives, 2 own surface from the depth), z footprint scale, w phase of the contact shadow dither (-1 = none)

// Blocker search: a fixed Vogel disk (unit radius), the same for every pixel - a disk rotated
// per pixel gives noise that boils as soon as the shadow map shifts under it (the sun moving
// with the time of day). xy offset, z weight (falls off toward the rim, the weights add up to
// 10) so the estimated caster depth - and with it the penumbra - doesn't jump each time a
// tap crosses the texel staircase of a silhouette.
static const float3 g_vecPCSSBlockerDisk[16] =
{
	float3( -0.085703, -0.154612, 0.9766 ), float3(  0.290350,  0.097194, 0.9297 ),
	float3( -0.361154,  0.160679, 0.8828 ), float3(  0.186672, -0.428840, 0.8359 ),
	float3(  0.172387,  0.501530, 0.7891 ), float3( -0.515063, -0.280108, 0.7422 ),
	float3(  0.618570, -0.153693, 0.6953 ), float3( -0.378427,  0.570564, 0.6484 ),
	float3( -0.113240, -0.720019, 0.6016 ), float3(  0.602455,  0.480415, 0.5547 ),
	float3( -0.808195,  0.055414, 0.5078 ), float3(  0.584497, -0.614095, 0.4609 ),
	float3( -0.016863,  0.883723, 0.4141 ), float3( -0.607443, -0.689031, 0.3672 ),
	float3(  0.946566,  0.101304, 0.3203 ), float3( -0.792385,  0.583845, 0.2734 ),
};

// Percentage-closer soft shadows: the penumbra grows with the distance between the caster
// and the receiver - crisp at the foot of a wall or a tree trunk, softer where the shadow of
// a crown or a roof edge falls far away.
//
// HL2RPM (2026-10-02): the depth test is filtered with a cubic B-spline - hardware bilinear
// compares, each one weighting a pair of texels per axis: 4 of them for the sharpest kernel,
// 16 for a wider one (up to twice as wide). The result is a smooth function of the position:
// up close, where one texel of the shadow map covers many pixels, the old disk of bilinear
// taps showed the texel staircase and a stripe along every texel column across a penumbra.
// One filter for the whole cascade and for the band blended into the next one (the old one
// switched between 12 and 24 taps, skipped the filter in a probed umbra and blended in a
// hard 4 tap lookup of the next cascade: contours inside penumbrae, "one shadow lying over
// another", and acne coming and going with the camera as the band moved over the surfaces).

// cubic B-spline (support -2..2, the weights of four texels at distances t add up to 1)
float4 BSplineWeights( float4 t )
{
	float4 a = abs( t );
	float4 b = saturate( 2.0f - a );
	float4 outer = b * b * b * ( 1.0f / 6.0f );
	float4 inner = ( 2.0f / 3.0f ) + a * a * ( 0.5f * a - 1.0f );
	return ( a < 1.0f ) ? inner : outer;
}

// shadow map position of a receiver, moved along its geometric normal - up to
// r_csm_bias_normal texels off the surface at grazing angles. That is a depth margin of as
// many texels per unit of tan( angle to the sun ), but unlike a depth bias it doesn't let
// the light through under the foot of a caster (the point only rises off the floor).
// normalOffsetDir = flNormal * sqrt( saturate( 1 - max(NdotL, 0)^2 ) ), hoisted out of cascade search.
float3 SunShadowUVZ( float3 worldPos, float3 normalOffsetDir, int c )
{
	// g_vecSlopeData[c].z = half a texel in world units
	worldPos += normalOffsetDir * ( 2.0f * g_vecSlopeData[c].z * g_vecAmbientCtrl.x );
	return mul( float4( worldPos, 1 ), g_matOrtho[c] ).xyz;
}

bool InsideCascade( float3 uvz )
{
	return !any( floor( ( uvz.xy - 0.0015f ) * 1.003f ) );
}

// Exact texel-snapped 4-tap zero-gap hardware 2x2 PCF pre-screen for Cascade 1 (and scale <= 1.50).
// Samples the 4 exact half-texel midpoints (i-0.5, j-0.5), (i+1.5, j-0.5), (i-0.5, j+1.5), (i+1.5, j+1.5),
// reading all 16 texels {i-1..i+2} x {j-1..j+2} with exact 0.25 weight and zero gaps at any fractional f.
// Returns 1.0 (fully lit), 0.0 (fully shadowed), or 0.5 (mixed / edge).
float ProbeShadowSnap4( float2 atlasUV, float uvzZ, float2 dzdTexel, float2 atlasTexel, float2 tileMin, float2 tileMax )
{
	const float2 x = atlasUV / atlasTexel - 0.5f;
	const float2 i = floor( x );
	const float2 p0 = i - 0.5f;
	const float2 p1 = i + 1.5f;
	const float2 uv0 = clamp( i * atlasTexel, tileMin, tileMax );
	const float2 uv1 = clamp( ( i + 2.0f ) * atlasTexel, tileMin, tileMax );
	const float2 z0 = ( p0 - x ) * dzdTexel;
	const float2 z1 = ( p1 - x ) * dzdTexel;
	float s = tex2Dlod( sShadowDepth, float4( uv0.x, uv0.y, uvzZ + z0.x + z0.y, 0 ) ).x;
	s += tex2Dlod( sShadowDepth, float4( uv1.x, uv0.y, uvzZ + z1.x + z0.y, 0 ) ).x;
	s += tex2Dlod( sShadowDepth, float4( uv0.x, uv1.y, uvzZ + z0.x + z1.y, 0 ) ).x;
	s += tex2Dlod( sShadowDepth, float4( uv1.x, uv1.y, uvzZ + z1.x + z1.y, 0 ) ).x;
	if ( s > 3.995f )
		return 1.0f;
	if ( s < 0.005f )
		return 0.0f;
	return 0.5f;
}

// Two-stage 8-tap zero-gap hardware 2x2 PCF pre-screen for Cascade 0 (maxScale <= 2.0):
// Stage 1: 4 inner corners at (+-0.95, +-0.95) cover the entire solid [-1.95, +1.95]^2 square
// (including center (0,0), so no redundant 5th center tap is needed; penumbra cores exit in 4 taps).
// Stage 2: only when all 4 agree, 4 outer cardinals at (+-1.9, 0) and (0, +-1.9) cover out to +-2.9
// texels with zero blind holes inside the B-spline support (eliminates 1-2px thin-branch speckles).
// Returns 1.0 (fully lit), 0.0 (fully shadowed), or 0.5 (mixed / penumbra).
float ProbeShadowPreScreen8( float2 atlasUV, float uvzZ, float2 dzdTexel, float2 atlasTexel, float2 tileMin, float2 tileMax )
{
	float s = tex2Dlod( sShadowDepth, float4( clamp( atlasUV + float2( -0.95f, -0.95f ) * atlasTexel, tileMin, tileMax ), uvzZ + dot( float2( -0.95f, -0.95f ), dzdTexel ), 0 ) ).x;
	s += tex2Dlod( sShadowDepth, float4( clamp( atlasUV + float2(  0.95f, -0.95f ) * atlasTexel, tileMin, tileMax ), uvzZ + dot( float2(  0.95f, -0.95f ), dzdTexel ), 0 ) ).x;
	s += tex2Dlod( sShadowDepth, float4( clamp( atlasUV + float2( -0.95f,  0.95f ) * atlasTexel, tileMin, tileMax ), uvzZ + dot( float2( -0.95f,  0.95f ), dzdTexel ), 0 ) ).x;
	s += tex2Dlod( sShadowDepth, float4( clamp( atlasUV + float2(  0.95f,  0.95f ) * atlasTexel, tileMin, tileMax ), uvzZ + dot( float2(  0.95f,  0.95f ), dzdTexel ), 0 ) ).x;
	if ( s > 0.005f && s < 3.995f )
		return 0.5f;
	s += tex2Dlod( sShadowDepth, float4( clamp( atlasUV + float2( -1.90f, 0.0f ) * atlasTexel, tileMin, tileMax ), uvzZ - 1.90f * dzdTexel.x, 0 ) ).x;
	s += tex2Dlod( sShadowDepth, float4( clamp( atlasUV + float2(  1.90f, 0.0f ) * atlasTexel, tileMin, tileMax ), uvzZ + 1.90f * dzdTexel.x, 0 ) ).x;
	s += tex2Dlod( sShadowDepth, float4( clamp( atlasUV + float2( 0.0f, -1.90f ) * atlasTexel, tileMin, tileMax ), uvzZ - 1.90f * dzdTexel.y, 0 ) ).x;
	s += tex2Dlod( sShadowDepth, float4( clamp( atlasUV + float2( 0.0f,  1.90f ) * atlasTexel, tileMin, tileMax ), uvzZ + 1.90f * dzdTexel.y, 0 ) ).x;
	if ( s > 7.995f )
		return 1.0f;
	if ( s < 0.005f )
		return 0.0f;
	return 0.5f;
}

// filtered sun shadow from cascade c
float SunShadowCascade( float3 uvz, float3 flNormal, float NdotL, float extraBias, float3 footX, float3 footY, int c, bool bDebug, float flFoliage, float minScale )
{
	const float4 tile = g_vecUVTransform[c];		// atlas offset / scale of this cascade
	const float2 atlasTexel = g_vecFilterConfig_A[c].xy;
	const float oneTexelDepth = 2.0f * g_vecSlopeData[c].x;

	// the receiver's plane in shadow space: depth change per texel of offset - a kernel wider
	// than a texel would otherwise shadow the surface itself
	const float3 gu = float3( g_matOrtho[c][0].x, g_matOrtho[c][1].x, g_matOrtho[c][2].x );
	const float3 gv = float3( g_matOrtho[c][0].y, g_matOrtho[c][1].y, g_matOrtho[c][2].y );
	const float3 gz = float3( g_matOrtho[c][0].z, g_matOrtho[c][1].z, g_matOrtho[c][2].z );
	float nz = dot( flNormal, gz );
	nz = ( nz < 0.0f ) ? min( nz, -1e-5f ) : max( nz, 1e-5f );
	const float gz2 = dot( gz, gz );
	float2 dzdTexel = -float2( dot( flNormal, gu ) * gz2 / dot( gu, gu ), dot( flNormal, gv ) * gz2 / dot( gv, gv ) ) / nz;
	dzdTexel *= atlasTexel / tile.zw;
	dzdTexel = clamp( dzdTexel, -4.0f * oneTexelDepth, 4.0f * oneTexelDepth );
	if ( minScale > 1.5f )
		dzdTexel = 0.0f;

	// a small depth bias on top of the normal offset (r_csm_bias_slope texels per unit of tan):
	// within one bilinear compare the plane is not followed. The caster side keeps only a
	// small slope bias now - the old 3x pushed steep walls behind the floor at their foot
	// (a lit gap along the base of every wall)
	const float cosA = max( abs( NdotL ), 0.05f );
	const float tanA = min( sqrt( 1.0f - cosA * cosA ) / cosA, 8.0f );
	uvz.z -= oneTexelDepth * ( 0.1f + g_vecAmbientCtrl.z * tanA );
	// (world units to depth: g_vecSlopeData x / z = half a texel of depth / half a texel)
	uvz.z -= extraBias * g_vecSlopeData[c].x / g_vecSlopeData[c].z;

	const float2 atlasUV = uvz.xy * tile.zw + tile.xy;
	const float2 tileMin = tile.xy + atlasTexel;
	const float2 tileMax = tile.xy + tile.zw - atlasTexel;

	// r_csm_pcss 3: caster depth - receiver depth at the point (grey = equal), 4: the caster depth itself
	if ( bDebug && g_vecPCSS.w > 2.5f && g_vecPCSS.w < 4.5f )
	{
		float raw = tex2Dlod( sShadowRaw, float4( atlasUV, 0, 0 ) ).x;
		raw = frac( raw * 0.5f ) * 2.0f;	// (a leaf: + 2)
		return ( g_vecPCSS.w > 3.5f ) ? frac( raw * 20.0f ) : saturate( ( raw - uvz.z ) / ( 4.0f * oneTexelDepth ) + 0.5f );
	}

	// kernel scale: 1 = the sharpest B-spline (sigma 0.58 texel), up to 2. The penumbra adds
	// a disk of its radius (sigma = radius / 2). The widest penumbra is the same in world units
	// in every cascade (what the first one allows): the coarse far cascades filter only the
	// texels right around the point - most of an open view - and skip the blocker search.
	const float maxPenumbra = min( g_vecPCSS.y, g_vecPCSS.z / ( 2.0f * g_vecSlopeData[c].z ) );
	const float maxScale = min( sqrt( 1.0f + 0.75f * maxPenumbra * maxPenumbra ), 2.0f );
	float scale = 1.0f;
	// HL2RPM: the light that comes through leaves (see the end)
	float leak = 0.0f;
	const bool bNormalPCSS = ( g_vecPCSS.w < 1.5f || g_vecPCSS.w > 4.5f );
	float preState = 0.5f;
	[branch]
	if ( bNormalPCSS && c <= 1 )
	{
		// HL2RPM: zero-gap hardware 2x2 PCF early-out BEFORE blocker search / footprint / B-spline:
		//   - c == 1: exact texel-snapped 4-tap {i-1..i+2}x{j-1..j+2} (~85% of c1 exits in 4 taps!)
		//   - c == 0: 8-tap two-stage (4 inner corners -> 4 outer cardinals; penumbra cores exit in 4 taps,
		//     uniform pixels exit in 8 taps with zero blind holes -> zero speckles).
		if ( c == 1 )
			preState = ProbeShadowSnap4( atlasUV, uvz.z, dzdTexel, atlasTexel, tileMin, tileMax );
		else
			preState = ProbeShadowPreScreen8( atlasUV, uvz.z, dzdTexel, atlasTexel, tileMin, tileMax );
		if ( preState > 0.99f )
			return 1.0f;
		if ( preState < 0.01f && flFoliage < 0.01f )
			return 0.0f;
	}

	// Blocker search: run for c == 0, foliage (crown translucency), or PCSS debug mode 2.
	// Skip on non-foliage c >= 1 (saves 16 R32F fetches per Cascade-1 shadow edge pixel!).
	[branch]
	if ( maxScale > 1.15f && g_vecPCSS.w > 0.5f && ( c == 0 || flFoliage >= 0.01f || !bNormalPCSS ) )
	{
		const float searchRadius = 1.5f * maxScale + 1.0f;
		float blockers = 0.0f;
		float blockerSum = 0.0f;
		float leafBlockers = 0.0f;	// (x 2)
		[loop]
		for ( int b = 0; b < 16; b++ )
		{
			float2 o = g_vecPCSSBlockerDisk[b].xy * searchRadius;
			const float raw = tex2Dlod( sShadowRaw, float4( clamp( atlasUV + o * atlasTexel, tileMin, tileMax ), 0, 0 ) ).x;
			// (a leaf: + 2. The depth is 0 .. 1, the flagged depth 2 .. 3. This decoding and the count
			// of leaves through raw - d are the forms that still fit the temp registers - X4505)
			const float d = frac( raw * 0.5f ) * 2.0f;
			float isBlocker = step( d, uvz.z + dot( o, dzdTexel ) - oneTexelDepth ) * g_vecPCSSBlockerDisk[b].z;
			blockers += isBlocker;
			blockerSum += d * isBlocker;
			leafBlockers += ( raw - d ) * isBlocker;
		}
		if ( bDebug && abs( g_vecPCSS.w - 2.0f ) < 0.5f )
			return blockers / 10.0f;	// r_csm_pcss 2: how many blockers the search found
		if ( blockers > 0.01f )
		{
			// penumbra radius (texels) from the caster distance: the sun's angular radius
			const float casterDistance = uvz.z - blockerSum / blockers;
			const float penumbra = casterDistance * g_vecPCSS.x / oneTexelDepth;
			scale = clamp( sqrt( 1.0f + 0.75f * penumbra * penumbra ), 1.0f, maxScale );
			// (a leaf in the shade of the leaves between it and the sun: a crown lets light through, the
			// less the deeper in - by how far the casters are, in world units - and only as much of it
			// as the blockers are leaves: a wall, a roof, a trunk stop it)
			leak = flFoliage * ( 0.5f * leafBlockers / blockers ) * exp2( -casterDistance * ( g_vecSlopeData[c].z / g_vecSlopeData[c].x ) * g_vecFoliage.x );
			// Full umbra for foliage: skip B-spline and return exact crown leak
			if ( blockers > 9.9f && preState < 0.01f )
				return leak * g_vecFoliage.y;
		}
	}
	else if ( bDebug && abs( g_vecPCSS.w - 2.0f ) < 0.5f )
	{
		return 0.0f;
	}

	{
		const float texelsPerUV = tile.z / atlasTexel.x;
		const float2 fx = float2( dot( footX, gu ), dot( footX, gv ) ) * texelsPerUV;
		const float2 fy = float2( dot( footY, gu ), dot( footY, gv ) ) * texelsPerUV;
		const float fx2 = dot( fx, fx );
		const float fy2 = dot( fy, fy );
		const float footprint = sqrt( max( fx2, fy2 ) );
		const float minFoot = sqrt( min( fx2, fy2 ) );
		float magScale = 1.0f;
		if ( c == 0 )
		{
			magScale = ( minFoot < 0.45f )
				? lerp( g_vecWeatherFlags.w, 1.45f, saturate( ( minFoot - 0.10f ) * ( 1.0f / 0.35f ) ) )
				: lerp( 1.45f, 1.0f, saturate( ( minFoot - 0.45f ) * ( 1.0f / 0.50f ) ) );
		}
		else if ( c == 1 )
		{
			// <= 1.42 stays inside fast 9-tap 3x3 B-spline with < 2.4% tail outside 4-tap Snap4 pre-screen
			magScale = lerp( 1.42f, 1.08f, saturate( ( minFoot - 0.35f ) * ( 1.0f / 0.65f ) ) );
		}
		scale = max( scale, max( minScale, max( magScale, min( footprint * g_vecShadowExtra.z, 2.0f ) ) ) );
	}

	// texel centre units: the centre of texel k at k
	const float2 x = atlasUV / atlasTexel - 0.5f;
	const float2 i = floor( x );
	const float2 f = x - i;

	// (explicit LOD: no gradients inside the branches; the hardware still compares with z)
	float shadow = 0.0f;
	[branch]
	if ( scale < 1.01f )
	{
		// texels i-1 .. i+2, a pair of them per bilinear compare and axis
		const float4 wx = BSplineWeights( f.x - float4( -1, 0, 1, 2 ) );
		const float2 Wx = wx.xz + wx.yw;
		const float2 Px = i.x + float2( -1, 1 ) + wx.yw / Wx;
		const float4 wy = BSplineWeights( f.y - float4( -1, 0, 1, 2 ) );
		const float2 Wy = wy.xz + wy.yw;
		const float2 Py = i.y + float2( -1, 1 ) + wy.yw / Wy;
		[unroll]
		for ( int a = 0; a < 2; a++ )
		{
			[unroll]
			for ( int b = 0; b < 2; b++ )
			{
				float2 p = float2( Px[a], Py[b] );
				float2 uv = clamp( ( p + 0.5f ) * atlasTexel, tileMin, tileMax );
				shadow += Wx[a] * Wy[b] * tex2Dlod( sShadowDepth, float4( uv, uvz.z + dot( p - x, dzdTexel ), 0 ) ).x;
			}
		}
	}
	else
	{
		// Unified branchless-setup cubic B-spline for scale in (1.0, 2.0]:
		//   scale <= 1.505 (sh=1): texels i-2..i+3 -> exact 3x3 (9 hardware taps, Wx.w=Wy.w=0, skips 7 outer taps)
		//   scale >  1.505 (sh=0): texels i-3..i+4 -> exact 4x4 (9 + 7 = 16 hardware taps)
		// Computing X->(Ux,Zx) before Y->(Uy,Zy) kills all coordinate/clamp/plane regs before any tap.
		const float rs = 1.0f / scale;
		const bool b3x3 = ( scale <= 1.505f );
		const float sh = b3x3 ? 1.0f : 0.0f;
		const float4 o0 = float4( -3, -2, -1, 0 ) + sh;
		const float4 o1 = float4( 1, 2, 3, 4 ) + ( b3x3 ? float4( 1, 1, 6, 5 ) : 0 );

		float4 Wx, Ux, Zx;
		{
			const float4 wx0 = BSplineWeights( ( f.x - o0 ) * rs );
			const float4 wx1 = BSplineWeights( ( f.x - o1 ) * rs );
			Wx = float4( wx0.xz + wx0.yw, wx1.xz + wx1.yw );
			const float4 Px = i.x + float4( -3, -1, 1, 3 ) + sh + float4( wx0.yw, wx1.yw ) / max( Wx, 1e-6f );
			Ux = clamp( ( Px + 0.5f ) * atlasTexel.x, tileMin.x, tileMax.x );
			Zx = ( Px - x.x ) * dzdTexel.x + uvz.z;
			Wx /= dot( Wx, 1.0f );
		}

		float4 Wy, Uy, Zy;
		{
			const float4 wy0 = BSplineWeights( ( f.y - o0 ) * rs );
			const float4 wy1 = BSplineWeights( ( f.y - o1 ) * rs );
			Wy = float4( wy0.xz + wy0.yw, wy1.xz + wy1.yw );
			const float4 Py = i.y + float4( -3, -1, 1, 3 ) + sh + float4( wy0.yw, wy1.yw ) / max( Wy, 1e-6f );
			Uy = clamp( ( Py + 0.5f ) * atlasTexel.y, tileMin.y, tileMax.y );
			Zy = ( Py - x.y ) * dzdTexel.y;
			Wy /= dot( Wy, 1.0f );
		}

		[unroll]
		for ( int a = 0; a < 3; a++ )
		{
			float row = Wy.x * tex2Dlod( sShadowDepth, float4( Ux[a], Uy.x, Zx[a] + Zy.x, 0 ) ).x
			          + Wy.y * tex2Dlod( sShadowDepth, float4( Ux[a], Uy.y, Zx[a] + Zy.y, 0 ) ).x
			          + Wy.z * tex2Dlod( sShadowDepth, float4( Ux[a], Uy.z, Zx[a] + Zy.z, 0 ) ).x;
			shadow += Wx[a] * row;
		}
		[branch]
		if ( !b3x3 )
		{
			shadow += Wx.x * Wy.w * tex2Dlod( sShadowDepth, float4( Ux.x, Uy.w, Zx.x + Zy.w, 0 ) ).x
			        + Wx.y * Wy.w * tex2Dlod( sShadowDepth, float4( Ux.y, Uy.w, Zx.y + Zy.w, 0 ) ).x
			        + Wx.z * Wy.w * tex2Dlod( sShadowDepth, float4( Ux.z, Uy.w, Zx.z + Zy.w, 0 ) ).x;
			float row3 = Wy.x * tex2Dlod( sShadowDepth, float4( Ux.w, Uy.x, Zx.w + Zy.x, 0 ) ).x
			           + Wy.y * tex2Dlod( sShadowDepth, float4( Ux.w, Uy.y, Zx.w + Zy.y, 0 ) ).x
			           + Wy.z * tex2Dlod( sShadowDepth, float4( Ux.w, Uy.z, Zx.w + Zy.z, 0 ) ).x
			           + Wy.w * tex2Dlod( sShadowDepth, float4( Ux.w, Uy.w, Zx.w + Zy.w, 0 ) ).x;
			shadow += Wx.w * row3;
		}
	}
	// (what the leaves let through lights the shaded part)
	return shadow + ( 1.0f - shadow ) * leak * g_vecFoliage.y;
}

// HL2RPM: the cascades in use - at most 4 (cascade_t.cpp: GetActiveCascadeCount clamps to 4, the
// cascades above it are committed with zero matrices and never hold a point). The arrays keep room
// for SHADOW_NUM_CASCADES (8); looking through all 8 cost every pixel 4 more transforms.
#define SUN_SHADOW_CASCADES 4

// flNormal: the geometric normal (see main), NdotL: its dot with the direction to the sun
float SunShadowPCSS( float3 worldPos, float3 flNormal, float NdotL, float extraBias, float3 footX, float3 footY, out int outCascade, float flFoliage, float minScale )
{
	int c = -1;
	float3 uvz = 0;
	{
		const float clN = max( NdotL, 0.0f );
		const float3 normalOffsetDir = flNormal * sqrt( saturate( 1.0f - clN * clN ) );
		[unroll]
		for ( int i = 0; i < SUN_SHADOW_CASCADES; i++ )
		{
			float3 cand = SunShadowUVZ( worldPos, normalOffsetDir, i );
			if ( InsideCascade( cand ) )
			{
				c = i;
				uvz = cand;
				break;
			}
		}
	}
	outCascade = c;
	if ( c < 0 )
		return 1.0f;

	float shadow = SunShadowCascade( uvz, flNormal, NdotL, extraBias, footX, footY, c, true, flFoliage, minScale );

	// a narrow band at the rim of the cascade fades into the next one, filtered the same way
	float2 centered = abs( uvz.xy * 2.0f - 1.0f );
	float blendFactor = smoothstep( 0.92f, 0.995f, max( centered.x, centered.y ) );
	[branch]
	if ( blendFactor > 0.0f && c < ( SUN_SHADOW_CASCADES - 1 ) && ( g_vecPCSS.w < 1.5f || g_vecPCSS.w > 4.5f ) )
	{
		const float clN = max( NdotL, 0.0f );
		const float3 normalOffsetDir = flNormal * sqrt( saturate( 1.0f - clN * clN ) );
		float3 uvzNext = SunShadowUVZ( worldPos, normalOffsetDir, c + 1 );
		if ( InsideCascade( uvzNext ) )
			shadow = lerp( shadow, SunShadowCascade( uvzNext, flNormal, NdotL, extraBias, footX, footY, c + 1, false, flFoliage, minScale ), blendFactor );
	}

	return shadow;
}
#endif

struct PS_INPUT
{
	float2 vTexCoord				: TEXCOORD0;

	float3 vecWorldRay				: TEXCOORD1;

	float2 vScreenPos				: VPOS;		// HL2RPM: dither of the contact shadow march
};

struct PS_OUTPUT
{
	float4 vColor_0				:	COLOR0;
};

PS_OUTPUT main( const PS_INPUT In )
{
	PS_OUTPUT Out = (PS_OUTPUT)0;

	float flDepth = tex2D( sDepth, In.vTexCoord ).x;

#if HAS_SHADOW
	// HL2RPM: the geometric normal of the surface for the sun shadow lookups, from the depth
	// buffer. The G-buffer normal carries the bump map: a normal offset, a slope bias and a
	// receiver plane built from it let a bumpy surface shadow itself in a pattern following its
	// normal map. (Screen space steps - the derivatives of the interpolants - are taken here,
	// ahead of any branch; they are the same all over the screen.)
	const float3 vecRayPos = In.vecWorldRay * flDepth;
	const float3 vecPosDx = ddx( vecRayPos );
	const float3 vecPosDy = ddy( vecRayPos );
	const float3 vecGeoCross = cross( vecPosDx, vecPosDy );
	const float2 vecTexelUV = float2( ddx( In.vTexCoord.x ), ddy( In.vTexCoord.y ) );
	const float3 vecRayDx = ddx( In.vecWorldRay );
	const float3 vecRayDy = ddy( In.vecWorldRay );
#endif

	// HL2RPM: no geometry (sky). Translucent surfaces in front of the sky - windows, the glass
	// of vehicles - take this pixel's light, and it kept whatever an earlier frame had left
	// there (the pass used to clip): glass glowed at night. The light of the open sky instead.
	if ( flDepth < 0.1f )
	{
		float3 skyAmbientLow = max( 2.0 * g_light_ambient_low_half - g_light_ambient_high, 0.0 );
		float skySunUp = saturate( ( g_vecLightVec_Forward.z + 0.02 ) / 0.08 ) * saturate( g_vecLightVec_Forward.z );
		Out.vColor_0 = WriteLighting( float4( g_light_ambient_high * 0.75 + skyAmbientLow * 0.25
			+ g_light_diffuse * 0.45 * skySunUp, 0 ) );
		return Out;
	}

	// ---- the sun: how much of it reaches the pixel ----
	float lightAmount;
	{
		float phong_exp;
		bool half_lambert, litface;

		float4 flNormalCtrl = tex2D( sNormals, In.vTexCoord );
		float3 flNormal = normalize( flNormalCtrl.xyz * 2.0f - 1.0f );
	
	#if !DEFCFG_LIGHTCTRL_PACKING
		{
			float4 flLightCtrl = tex2D( sLightCtrl, In.vTexCoord );
			phong_exp = flLightCtrl.x;
			half_lambert = flLightCtrl.y;
			litface = flLightCtrl.z;
		}
	#else
		UnpackLightingControls( flNormalCtrl.a, phong_exp, half_lambert, litface );
	#endif

		// HL2RPM: lighting controls 1.0 = a pixel of the 3D skybox (gbuffer_ps30). Its position is
		// reconstructed x skybox scale, where the sun's shadow maps hold the map's own casters (a
		// tree near the edge of the map threw sparkling shadows on the skybox city): plain Lambert,
		// no shadow map lookups.
		const bool bSkybox = flNormalCtrl.a > ( 254.5f / 255.0f );
		const bool bViewmodel = ( flDepth < 2.5f );
		if ( bSkybox )
		{
			half_lambert = false;
			litface = false;
		}

	#if HAS_SHADOW
		// r_csm_pcss 8: what the G-buffer holds - red the 3D skybox, green the map, blue the body, cyan the viewmodel
		if ( g_vecPCSS.w > 7.5f )
		{
			const bool bBody = abs( flNormalCtrl.a * 255.0f - 254.0f ) < 0.5f;
			Out.vColor_0 = WriteLighting( float4( bSkybox ? 1 : 0, ( bSkybox || bBody ) ? 0 : 1, ( bBody || bViewmodel ) ? 1 : 0, 0 ) );
			return Out;
		}
	#endif

		float3 flLitNormal = lerp( 1, dot( flNormal, g_vecLightVec_Forward ), litface ) * flNormal;

		float viewFwdDot = dot( g_vecLightVec_Forward.xyz, flLitNormal );
		float hlWrap = saturate( viewFwdDot );
		hlWrap = hlWrap * ( 1.55f - 0.55f * hlWrap );
		float litDot = lerp( saturate( viewFwdDot ), hlWrap, half_lambert );

		lightAmount = litDot;

		float sunVis = saturate( ( g_vecLightVec_Forward.z + 0.02 ) / 0.08 );
		lightAmount *= sunVis;

		// (The sun's shadows come first and the sky light after them: the shadow filter is what
		// fills the temporary registers of ps_3_0 - with the ambient light, the AO and the GI
		// computed ahead of it and kept through it nothing could be added to this shader at all.)

	#if HAS_SHADOW
		// (surfaces turned away from the sun need no shadow lookup; the cascade view needs it)
		if ( !bSkybox && flDepth < DEPTH_RECONSTRUCTION_LIMIT && ( lightAmount > 0.0f || g_flCSMColorize > 0.5f ) )
		{
			float3 worldPos = g_vecViewOrigin + ( bViewmodel ? normalize( In.vecWorldRay ) * 12.0f : vecRayPos );

			float3 geoCross = vecGeoCross;
			float3 footX = vecPosDx;
			float3 footY = vecPosDy;
			[branch]
			if ( g_vecShadowExtra.y > 1.5f && !bViewmodel && !half_lambert )
			{
				// HL2RPM: adaptive 4-tap planarity fast path. On a planar surface 1/z is exact
				// linear in screen space, so |1/dL1 + 1/dR1 - 2/d0| ~= 0; fetch the 2nd-order
				// taps (dL2/dR2, dU2/dD2) only on creases and silhouettes (~5% of pixels).
				const float2 uv = In.vTexCoord;
				const float iz0 = 1.0f / flDepth;
				const float eps = iz0 * 0.002f + 1e-6f;
				float3 tx;
				{
					const float2 dx = float2( vecTexelUV.x, 0 );
					const float dL1 = max( tex2Dlod( sDepth, float4( uv - dx, 0, 0 ) ).x, 0.1f );
					const float dR1 = max( tex2Dlod( sDepth, float4( uv + dx, 0, 0 ) ).x, 0.1f );
					const float izL1 = 1.0f / dL1;
					const float izR1 = 1.0f / dR1;
					bool useR = true;
					[branch]
					if ( abs( izL1 + izR1 - 2.0f * iz0 ) > eps )
					{
						const float dL2 = max( tex2Dlod( sDepth, float4( uv - 2.0f * dx, 0, 0 ) ).x, 0.1f );
						const float dR2 = max( tex2Dlod( sDepth, float4( uv + 2.0f * dx, 0, 0 ) ).x, 0.1f );
						useR = abs( 2.0f * izR1 - 1.0f / dR2 - iz0 ) < abs( 2.0f * izL1 - 1.0f / dL2 - iz0 );
					}
					tx = useR ? ( ( In.vecWorldRay + vecRayDx ) * dR1 - vecRayPos )
						: ( vecRayPos - ( In.vecWorldRay - vecRayDx ) * dL1 );
				}
				float3 ty;
				{
					const float2 dy = float2( 0, vecTexelUV.y );
					const float dU1 = max( tex2Dlod( sDepth, float4( uv - dy, 0, 0 ) ).x, 0.1f );
					const float dD1 = max( tex2Dlod( sDepth, float4( uv + dy, 0, 0 ) ).x, 0.1f );
					const float izU1 = 1.0f / dU1;
					const float izD1 = 1.0f / dD1;
					bool useD = true;
					[branch]
					if ( abs( izU1 + izD1 - 2.0f * iz0 ) > eps )
					{
						const float dU2 = max( tex2Dlod( sDepth, float4( uv - 2.0f * dy, 0, 0 ) ).x, 0.1f );
						const float dD2 = max( tex2Dlod( sDepth, float4( uv + 2.0f * dy, 0, 0 ) ).x, 0.1f );
						useD = abs( 2.0f * izD1 - 1.0f / dD2 - iz0 ) < abs( 2.0f * izU1 - 1.0f / dU2 - iz0 );
					}
					ty = useD ? ( ( In.vecWorldRay + vecRayDy ) * dD1 - vecRayPos )
						: ( vecRayPos - ( In.vecWorldRay - vecRayDy ) * dU1 );
				}
				geoCross = cross( tx, ty );
				footX = tx;
				footY = ty;
			}
			float3 shadowNormal = geoCross * rsqrt( max( dot( geoCross, geoCross ), 1e-30f ) );
			shadowNormal *= ( dot( shadowNormal, In.vecWorldRay ) > 0.0f ) ? -1.0f : 1.0f;
			// Skip geometric normal on halflambert characters & viewmodels; smooth near curved terminators otherwise.
			shadowNormal = ( !bViewmodel && !half_lambert && dot( shadowNormal, flNormal ) > 0.3f && g_vecShadowExtra.y > 0.5f ) ? shadowNormal : flNormal;
			float gNdotL = dot( shadowNormal, g_vecLightVec_Forward );
			if ( !bViewmodel && !half_lambert && gNdotL < 0.25f && viewFwdDot > gNdotL )
				shadowNormal = normalize( lerp( flNormal, shadowNormal, saturate( gNdotL * 4.0f ) ) );
			float shadowNdotL = dot( shadowNormal, g_vecLightVec_Forward );
			// (foliage lit from both sides: the face toward the sun)
			if ( litface && shadowNdotL < 0.0f )
			{
				shadowNormal = -shadowNormal;
				shadowNdotL = -shadowNdotL;
			}

			// (r_csm_pcss 0: the same filter, always the sharpest kernel - no blocker search)
			// the local player's first person body (lighting controls 254, gbuffer_ps30) or viewmodel
			const float bodyBias = ( bViewmodel || abs( flNormalCtrl.a * 255.0f - 254.0f ) < 0.5f ) ? g_vecShadowExtra.x : 0.0f;

			int csmCascadeIndex = 0;
			float shadowMult = SunShadowPCSS( worldPos, shadowNormal, shadowNdotL, bodyBias, footX, footY, csmCascadeIndex, litface ? 1.0f : 0.0f, bViewmodel ? 2.0f : 0.0f );
			if ( g_flCSMColorize > 0.5f )
			{
				float3 cascadeColor = float3( 1, 0, 1 );
				if ( csmCascadeIndex == 0 ) cascadeColor = float3( 1, 0, 0 );       // red
				if ( csmCascadeIndex == 1 ) cascadeColor = float3( 0, 1, 0 );       // green
				if ( csmCascadeIndex == 2 ) cascadeColor = float3( 0, 0, 1 );       // blue
				if ( csmCascadeIndex == 3 ) cascadeColor = float3( 1, 1, 0 );       // yellow
				if ( csmCascadeIndex == 4 ) cascadeColor = float3( 1, 0.5, 0 );     // orange
				if ( csmCascadeIndex == 5 ) cascadeColor = float3( 0, 1, 1 );       // cyan
				if ( csmCascadeIndex == 6 ) cascadeColor = float3( 0.5, 0, 1 );     // purple
				if ( csmCascadeIndex == 7 ) cascadeColor = float3( 0.5, 0.5, 0.5 ); // gray
				Out.vColor_0 = WriteLighting( float4( cascadeColor, 0 ) );
				return Out;
			}

	#if 0
			// fixes self shadowing for half lambertian, but, i don't like it!
			lightAmount *= max( shadowMult, (1.0f - saturate( viewFwdDot )) * half_lambert );
	#else
			lightAmount *= shadowMult;

			// HL2RPM: contact shadows. The cascades miss what is smaller than a few texels: the
			// shadow a foot, a can, a pipe or the lip of a step throws right next to itself. A short
			// march toward the sun through the depth buffer: a sample that lands behind the visible
			// surface (and not far behind - a thin object, not a wall far in front) shadows the point.
			//
			// The march is as long as the cascade at the point is coarse: g_vecWeatherFlags.z of its texels
			// (r_deferred_contact_shadows_texels), up to the full length. Up close the first cascade
			// (texels of 0.1 - 0.2 units) shadows a foot or a can as it is, and a march of 24 units there
			// only added what a depth buffer can't know: whatever passes within the assumed thickness
			// behind a silhouette counts as hit - a halo of false shadow around the real one, with a
			// ragged rim, around every object and under the player's feet. Far away, where a texel is
			// units wide, the march is what draws the small shadows at all.
			float contactTexel = 1000.0f;
			if ( csmCascadeIndex == 0 ) contactTexel = g_vecSlopeData[0].z;
			if ( csmCascadeIndex == 1 ) contactTexel = g_vecSlopeData[1].z;
			if ( csmCascadeIndex == 2 ) contactTexel = g_vecSlopeData[2].z;
			if ( csmCascadeIndex == 3 ) contactTexel = g_vecSlopeData[3].z;
			// (g_vecSlopeData z: half a texel in world units)
			// Skip micro-march in sharp Cascade 0 where contactLen <= 1.5u (2048^2 shadow map is already sub-quarter-inch sharp)
			const float contactLen = min( g_vecContact.x, 2.0f * contactTexel * g_vecWeatherFlags.z );
			const float contactStrength = g_vecContact.w * saturate( ( contactLen - 1.5f ) * 0.25f );
			[branch]
			if ( !bViewmodel && contactStrength > 0.01f && lightAmount > 0.001f && shadowMult > 0.01f && viewFwdDot > 0.04f && flDepth < g_vecContact.z )
			{
				const float rayLen = length( In.vecWorldRay );
				[branch]
				if ( flDepth * rayLen < g_vecContact.z )
				{
					const float biasStep = min( 1.0f, contactLen * 0.125f );
					const float4 p0 = float4( worldPos + shadowNormal * biasStep, 1.0f );
					const float dither = ( g_vecShadowExtra.w < 0.0f ) ? 0.5f
						: frac( 52.9829189f * frac( dot( In.vScreenPos, float2( 0.06711056f, 0.00583715f ) ) ) + g_vecShadowExtra.w );
					// HL2RPM: hoist world->screen projection out of the march loop and compare linear
					// view-forward depth (clip.z == w_clip) directly instead of reconstructing rayQ + 2 sqrts per step.
					const float3 clip0 = float3( dot( g_matWorldToScreen[0], p0 ), dot( g_matWorldToScreen[1], p0 ), dot( g_matWorldToScreen[3], p0 ) );
					const float3 clipDir = float3( dot( g_matWorldToScreen[0].xyz, g_vecLightVec_Forward ), dot( g_matWorldToScreen[1].xyz, g_vecLightVec_Forward ), dot( g_matWorldToScreen[3].xyz, g_vecLightVec_Forward ) );
					const int nSteps = ( contactLen < 4.0f ) ? 6 : 8;
					const float invSteps = ( contactLen < 4.0f ) ? ( 1.0f / 6.0f ) : 0.125f;
					const float dt = contactLen * invSteps;
					float3 clip = clip0 + clipDir * ( dither * dt + biasStep );
					const float3 dClip = clipDir * dt;
					float occ = 0.0f;
					[loop]
					for ( int i = 0; i < nSteps; i++ )
					{
						if ( clip.z <= 1.0f )
							break;
						const float2 uvq = clip.xy / clip.z;
						if ( any( uvq < 0.0f ) || any( uvq > 1.0f ) )
							break;
						const float dScene = tex2Dlod( sDepth, float4( uvq, 0, 0 ) ).x;
						if ( dScene >= 0.1f )
						{
							const float behind = ( clip.z - dScene ) * rayLen;
							occ = max( occ, saturate( ( behind - 0.5f ) * 0.5f ) * saturate( ( g_vecContact.y - behind ) / 4.0f ) );
							if ( occ >= 0.99f )
								break;
						}
						clip += dClip;
					}
					lightAmount *= 1.0f - occ * contactStrength;

					// r_deferred_contact_shadows_debug: red = occlusion found, green = strength
					if ( g_vecGIApply.z > 0.5f )
					{
						Out.vColor_0 = WriteLighting( float4( occ, contactStrength, 0.25f, 0 ) );
						return Out;
					}
				}
				else if ( g_vecGIApply.z > 0.5f )
				{
					Out.vColor_0 = WriteLighting( float4( 0, g_vecContact.w, ( lightAmount > 0.001f ) ? 1.0f : 0.0f, 0 ) );
					return Out;
				}
			}
			else if ( g_vecGIApply.z > 0.5f )
			{
				Out.vColor_0 = WriteLighting( float4( 0, g_vecContact.w, ( lightAmount > 0.001f ) ? 1.0f : 0.0f, 0 ) );
				return Out;
			}

			// r_csm_pcss 5: the sun shadow term alone (white lit, black shadowed)
			if ( g_vecPCSS.w > 4.5f && g_vecPCSS.w < 5.5f )
			{
				Out.vColor_0 = WriteLighting( float4( shadowMult.xxx, 0 ) );
				return Out;
			}
	#endif
		}
	#endif

		// Deferred after CSM + contact shadows so already-shadowed pixels skip cloud evaluation
		[branch]
		if ( g_vecWeatherFlags.x > 0.0 && lightAmount > 0.001f && flDepth < DEPTH_RECONSTRUCTION_LIMIT )
			lightAmount *= CloudShadow( g_vecViewOrigin + In.vecWorldRay * flDepth, g_vecLightVec_Forward );
	}

	// ---- the sky light and the specular highlight ----
	// Everything they need is read again here rather than kept through the shadow filter above (a
	// tex2Dlod the compiler can't merge with the tex2D of the first part): see the note there.
	const float4 flNormalCtrl2 = tex2Dlod( sNormals, float4( In.vTexCoord, 0, 0 ) );
	const float3 flNormal = normalize( flNormalCtrl2.xyz * 2.0f - 1.0f );
	float phong_exp;
	bool half_lambert, litface;
	UnpackLightingControls( flNormalCtrl2.a, phong_exp, half_lambert, litface );
	const bool bSkybox = flNormalCtrl2.a > ( 254.5f / 255.0f );
	if ( bSkybox )
		litface = false;
	const float3 flLitNormal = lerp( 1, dot( flNormal, g_vecLightVec_Forward ), litface ) * flNormal;
	const float viewFwdDot = dot( g_vecLightVec_Forward.xyz, flLitNormal );

	// HL2RPM: the half resolution buffers (AO, GI) fill the top left of full size targets: at the
	// right and bottom edge the bilinear lookup reached the texel next to the drawn area (a ragged
	// dark border) - kept half a texel inside (a full resolution pixel from the edge)
	const float2 uvHalfRes = min( In.vTexCoord, 1.0f - float2( abs( ddx( In.vTexCoord.x ) ), abs( ddy( In.vTexCoord.y ) ) ) );

	// HL2RPM: sky light comes from above and bounce light from below (it used to be
	// oriented along the sun direction, which made overcast lighting wrong).
	float3 ambientLow = max( 2.0 * g_light_ambient_low_half - g_light_ambient_high, 0.0 );
	float skyFacing = saturate( flNormal.z * 0.5 + 0.5 ) * 0.75 + saturate( viewFwdDot * 0.5 + 0.5 ) * 0.25;
	float3 ambient = lerp( ambientLow, g_light_ambient_high, skyFacing );

	// HL2RPM: the sky light is occluded - by the geometry right around the point (SSAO)
	// and by roofs (indoors it drops to a dim bounce level)
	float2 aoSky = float2( 1.0, 1.0 );
	if ( g_vecAmbientCtrl.w > 0.0 )
	{
		aoSky = tex2D( sSSAO, uvHalfRes * g_vecAmbientCtrl.w ).rg;
		// (the rain map behind the sky visibility holds the map's roofs, not the skybox's)
		if ( bSkybox )
			aoSky.y = 1.0;
		ambient *= lerp( g_vecAmbientCtrl.y, 1.0, aoSky.y );

#if HAS_SHADOW
		// r_csm_pcss 6 / 7: the sky visibility / the SSAO alone
		if ( g_vecPCSS.w > 5.5f )
		{
			Out.vColor_0 = WriteLighting( float4( ( ( g_vecPCSS.w > 6.5f ) ? aoSky.x : aoSky.y ).xxx, 0 ) );
			return Out;
		}
#endif
	}

	ambient *= aoSky.x;

	// HL2RPM (PBR): the specular term of the light buffer is a luminance - what the surface
	// mirrors, for a reflectance of 1 from the front (the composite pass, which knows the
	// material, multiplies by its own and gives it the color of the light at the pixel; the
	// growth of the reflection toward glancing angles is in SpecularGGX and EnvFresnel, see
	// common_deferred_fxc.h). The sun: its GGX reflection by the roughness of
	// the G-buffer (phong_exp holds it). And the light around the point: the indirect light there
	// stands for it - it knows the sky, how much of it is in sight and what the sun bounces
	// in - more of it where the mirrored direction looks up at the sky than down at the ground.
	// (The old term was a Blinn-Phong highlight no stock material ever showed: their scale was 0.)
	// Rain: what lies under the open sky (the sky visibility of the rain map) and faces up is
	// covered by a film of water - smooth whatever is under it: wet cobbles and asphalt mirror
	// the sky at a glancing angle, the sun and the lamps in a narrow streak.
	const float flWet = bSkybox ? 0.0f : g_vecPBRWet.x * aoSky.y * saturate( flNormal.z * 1.1f + 0.35f );
	const float flRoughness = lerp( phong_exp, min( phong_exp, g_vecPBRWet.y ), flWet );

	const float3 vecV = normalize( -In.vecWorldRay );
	float flSpecular = 0.0f;
	[branch]
	if ( lightAmount > 0.001f )
	{
		flSpecular = SpecularGGX( flNormal, vecV, g_vecLightVec_Forward.xyz, max( flRoughness, g_vecPBR.w ) )
			* dot( g_light_diffuse.rgb, float3( 0.3f, 0.59f, 0.11f ) ) * g_vecPBR.x;
	}
	const float flMirrorUp = reflect( -vecV, flNormal ).z;
	const float flEnv = dot( ambient, float3( 0.3f, 0.59f, 0.11f ) )
		* lerp( g_vecPBR.y, g_vecPBR.z, saturate( flMirrorUp * 0.5f + 0.5f ) )
		* EnvFresnel( flNormal, vecV, flRoughness );

	// HL2RPM: the light through a thin thing - a leaf, a blade of grass, a curtain ($litface) - seen
	// against the sun: it glows, in its own color (the composite multiplies by the albedo), as
	// bright as the sun light that reaches it - that is, as lit as the shadow maps leave it (through
	// the rest of the crown: c80 x, y) - and the more the closer the view is to the sun (a broad
	// lobe and a narrow one). Lit from the front its light is the light of the sun as on anything.
	float transmit = 0.0f;
	[branch]
	if ( litface && g_vecFoliage.z > 0.0f )
	{
		float hlFront = saturate( viewFwdDot );
		hlFront = hlFront * ( 1.55f - 0.55f * hlFront );
		const float litFront = max( lerp( saturate( viewFwdDot ), hlFront, half_lambert ), 0.05f );
		const float reach = saturate( lightAmount / litFront );
		const float toSun = saturate( dot( -vecV, g_vecLightVec_Forward.xyz ) );
		transmit = reach * g_vecFoliage.z * ( pow( toSun, g_vecFoliage.w ) + 2.0f * pow( toSun, g_vecFoliage.w * 6.0f ) );
	}

	// HL2RPM: sky light + direct light (the old lerp *replaced* the sky light with the
	// sun wherever it was lit, so lit areas under a weak overcast sun got darker than shadow)
	// (lightAmount already contains saturate( litDot ) * sun visibility * shadows)
	float4 lighting = float4( ambient + g_light_diffuse * ( lightAmount + transmit ), flSpecular * lightAmount + flEnv );

	Out.vColor_0 = WriteLighting( lighting );

	return Out;
}
