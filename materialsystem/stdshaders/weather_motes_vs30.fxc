//========= HL2RPM ============================================================//
//
// Dust motes: specks floating in the air around the camera, seen where the sun
// lights them - the beams through the windows of a dark room. As the GPU rain,
// every mote is a quad of a static mesh whose position is a pure function of
// (seed, time): a slow wander around a world-fixed point, wrapped in a box that
// follows the camera. No CPU cost per mote.
//
//=============================================================================//

#include "common_vs_fxc.h"

const float4 g_vecCamera		: register( SHADER_SPECIFIC_CONST_0 );	// xyz eye, w time
const float4 g_vecMotes			: register( SHADER_SPECIFIC_CONST_1 );	// x motes enabled (0..1), y box size, z mote size, w drift speed
const float4 g_vecMotes2		: register( SHADER_SPECIFIC_CONST_2 );	// x smallest size on screen (per unit of distance)

struct VS_INPUT
{
	float3 vSeed		: POSITION;
	float2 vCorner		: TEXCOORD0;
	float4 vRandom		: TEXCOORD1;	// order, size, phase, brightness
};

struct VS_OUTPUT
{
	float4 vProjPos		: POSITION;
	float2 vCorner		: TEXCOORD0;
	float3 vWorldPos	: TEXCOORD1;	// the mote's center (lit as a point)
	float2 vFade		: TEXCOORD2;	// x alpha, y brightness
};

VS_OUTPUT main( const VS_INPUT In )
{
	VS_OUTPUT Out = (VS_OUTPUT)0;

	if ( In.vRandom.x > g_vecMotes.x )
	{
		Out.vProjPos = float4( 0, 0, -10, 1 );
		return Out;
	}

	// a few units of slow, uneven wander and a faint common drift (air moving through the room)
	const float t = g_vecCamera.w * g_vecMotes.w;
	const float phase = In.vRandom.z * 6.2831853;
	const float3 wander = float3(
		sin( t * 0.31 + phase ) + 0.5 * sin( t * 0.83 + phase * 3.1 ),
		cos( t * 0.27 + phase * 1.7 ) + 0.5 * sin( t * 0.71 + phase * 2.3 ),
		0.6 * sin( t * 0.23 + phase * 2.9 ) + 0.3 * sin( t * 0.61 + phase * 1.3 ) ) * 5.0;
	const float3 drift = float3( 0.7, 0.45, 0.12 ) * t;

	// world-fixed position, wrapped into the box around the camera
	const float box = g_vecMotes.y;
	float3 p = In.vSeed * box + wander + drift;
	const float3 boxMin = g_vecCamera.xyz - box * 0.5;
	p = boxMin + frac( ( p - boxMin ) / box ) * box;

	float3 toCam = g_vecCamera.xyz - p;
	const float dist = length( toCam );
	toCam /= max( dist, 1e-3 );

	// facing the camera
	const float3 side = normalize( cross( toCam, float3( 0, 0, 1 ) ) + float3( 1e-4, 0, 0 ) );
	const float3 up = cross( side, toCam );

	// a speck near, at least ~2 pixels far away (a soft dot TAA can hold: at one pixel it
	// was smeared over its neighbours and nearly lost) - fading instead of shimmering below that
	float size = g_vecMotes.z * In.vRandom.y;
	const float minSize = dist * g_vecMotes2.x;
	const float sizeFade = saturate( size / max( minSize, 1e-3 ) );
	size = max( size, minSize );

	const float3 pos = p + ( side * ( In.vCorner.x - 0.5 ) + up * ( In.vCorner.y - 0.5 ) ) * size;

	Out.vProjPos = mul( float4( pos, 1 ), cViewProj );
	Out.vCorner = In.vCorner;
	Out.vWorldPos = p;

	const float nearFade = saturate( ( dist - 6.0 ) / 16.0 );
	const float farFade = saturate( ( box * 0.5 - dist ) / ( box * 0.2 ) );
	Out.vFade = float2( nearFade * farFade * sizeFade, In.vRandom.w );

	return Out;
}
