//========= HL2RPM ============================================================//
//
// Volumetric clouds, rendered in screen space at reduced resolution.
//
// Output: rgb = in-scattered light (sky units, before the sky exposure),
//         a   = transmittance (1 = clear sky, 0 = opaque cloud),
//         a < 0 marks pixels that were not computed (covered by geometry).
//
// The sky shader composites this over the atmosphere. The raymarch noise is
// removed by the temporal resolve pass (weather_cloudresolve_ps30).
//
//=============================================================================//

#include "common_ps_fxc.h"

sampler sDepth			: register( s0 );	// G-buffer linear depth, 0 = sky
sampler sNoise			: register( s1 );	// 3D noise atlas (8x8 slices)
sampler sWeather		: register( s2 );	// 2D weather map

const float4 g_vecCamera		: register( c0 );	// xyz camera pos (units)
const float4 g_vecLightDir		: register( c1 );	// xyz direction to the sun/moon lighting the clouds, w night
const float4 g_vecLightColor	: register( c2 );	// rgb
const float4 g_vecSkyZenith		: register( c3 );
const float4 g_vecSkyHorizon	: register( c4 );
const float4 g_vecCloud0		: register( c5 );	// coverage, density, type, darkness
const float4 g_vecCloud1		: register( c6 );	// base (m), thickness (m), cirrus, time (s)
const float4 g_vecCloud2		: register( c7 );	// brightness, shadow strength, steps, temporal blend
const float4 g_vecWind			: register( c8 );	// xy cloud offset (m)
const float4 g_vecScreen		: register( c9 );	// 1/w, 1/h (full res), uv scale, frame
const float4 g_vecCloud3		: register( c10 );	// x altocumulus amount, y altocumulus altitude (m), z cloud space meters per unit, w debug view
const float4 g_vecLightning		: register( c14 );	// xyz flash dir, w intensity

struct PS_INPUT
{
	float2 vTexCoord			: TEXCOORD0;
	float3 vecWorldRay			: TEXCOORD1;
	float2 vScreenPos			: VPOS;
};

static const float PI = 3.14159265;
static const float EARTH_R = 6371000.0;
static const float UNITS_TO_M = 0.0254;
static const float MAX_DIST = 60000.0;
// all periods divide the 160 km wrap of the wind offset (no pops when it wraps)
static const float SHAPE_PERIOD = 16000.0;		// m (10x in 160 km)
static const float DETAIL_PERIOD = 1600.0;		// m (100x in 160 km)
static const float WEATHER_PERIOD = 40000.0;	// m (4x in 160 km)

// 3D noise from the 8x8 slice atlas: 62x62 slices with a 1 texel wrap border
float4 Noise3D( float3 p )
{
	p = frac( p );
	float zs = p.z * 64.0 - 0.5;
	float z0 = floor( zs );
	float zf = zs - z0;
	z0 = ( z0 < 0.0 ) ? 63.0 : z0;
	float z1 = ( z0 >= 63.0 ) ? 0.0 : z0 + 1.0;

	float2 inTile = ( 1.0 + p.xy * 62.0 ) / 512.0;
	float2 t0 = float2( fmod( z0, 8.0 ), floor( z0 / 8.0 ) ) * 0.125;
	float2 t1 = float2( fmod( z1, 8.0 ), floor( z1 / 8.0 ) ) * 0.125;

	float4 a = tex2Dlod( sNoise, float4( t0 + inTile, 0, 0 ) );
	float4 b = tex2Dlod( sNoise, float4( t1 + inTile, 0, 0 ) );
	return lerp( a, b, zf );
}

float Remap( float v, float lo, float hi, float newLo, float newHi )
{
	return newLo + ( v - lo ) / max( hi - lo, 1e-4 ) * ( newHi - newLo );
}

// Distance along the ray to the sphere of radius (R + H) seen from height h below it.
float DistToLayer( float mu, float h, float H )
{
	float rh = EARTH_R + h;
	float k = ( H - h ) * ( 2.0 * EARTH_R + h + H );
	float b = rh * mu;
	return k / ( b + sqrt( max( b * b + k, 0.0 ) ) );
}

// Coverage -> cut-off calibrated offline on the 62x62x64 convex Perlin-Worley volume
float CoverageThreshold( float c, float type )
{
	float cu = ( ( -1.2207 * c + 1.6196 ) * c - 1.4986 ) * c + 1.0431;
	float st = ( ( -0.6585 * c + 1.3479 ) * c - 1.7223 ) * c + 0.9918;
	return max( lerp( st, cu, type ), 0.0 ) * saturate( ( 1.0 - c ) * 20.0 );
}

float HeightProfile( float h, float type, float cov, float topVar )
{
	float stratus = saturate( h / 0.07 ) * saturate( ( 0.42 - h ) / 0.24 );
	// Cumulus tops vary organically per column between low puffs and tall towers
	float topH = lerp( 1.0, lerp( 0.58, 1.0, topVar ), saturate( type * 1.2 ) * saturate( ( 0.90 - cov ) * 4.0 ) );
	float cumulus = saturate( h / 0.09 ) * saturate( ( topH - h ) / max( topH * 0.45, 0.1 ) );
	float profile = lerp( stratus, cumulus, type );
	float anvil = saturate( ( type - 0.75 ) * 4.0 );
	float anvilShape = saturate( ( h - 0.72 ) / 0.10 ) * saturate( ( 1.0 - h ) / 0.14 );
	return max( profile, anvilShape * anvil * 0.9 );
}

// Sample weather map once per ray step and pack column state (x=cov, y=type, z=thr, w=deck)
void SampleWeatherColumn( float2 xy, out float4 wm, out float4 colState )
{
	wm = tex2Dlod( sWeather, float4( xy / WEATHER_PERIOD, 0, 0 ) );
	float cov = saturate( g_vecCloud0.x + ( wm.r - 0.5 ) * 0.5 * ( 1.0 - g_vecCloud0.x * 0.6 ) * saturate( ( 1.0 - g_vecCloud0.x ) * 6.0 ) );
	float tp = saturate( g_vecCloud0.z + ( wm.g - 0.5 ) * 0.7 );
	float thr = CoverageThreshold( cov, tp );
	float deck = saturate( ( cov - 0.92 ) / 0.08 );
	colState = float4( cov, tp, thr, deck );
}

float CloudDensityWithWM( float3 pos, float h01, float4 wm, float4 colState, float2 windDir, bool bDetail, out float outBillow )
{
	outBillow = 0.5;
	if ( h01 < 0.0 || h01 > 1.0 )
		return 0.0;

	float2 pxy = pos.xy + windDir * ( h01 * 380.0 );
	float3 shapePos = float3( pxy, h01 * g_vecCloud1.y * 1.6 + g_vecCloud1.w * 3.0 ) * ( 1.0 / SHAPE_PERIOD );
	shapePos.xy += ( wm.ba - 0.5 ) * 0.55;
	float4 shapeNoise = Noise3D( shapePos );
	float shape = shapeNoise.r;
	outBillow = saturate( ( shapeNoise.g - 0.30 ) * 2.5 );

	float hp = HeightProfile( h01, colState.y, colState.x, wm.g );
	float edgeWidth = lerp( 0.55, 0.42, colState.y );
	float base = smoothstep( 0.0, 1.0, saturate( ( shape * hp - colState.z ) / max( ( 1.0 - colState.z ) * edgeWidth, 0.05 ) ) );

	if ( bDetail && base > 0.001 )
	{
		float3 detailPos = float3( pxy, h01 * g_vecCloud1.y + g_vecCloud1.w * 12.0 ) * ( 1.0 / DETAIL_PERIOD );
		float4 dn = Noise3D( detailPos );
		float detailBillow = saturate( ( dn.g * 0.45 + dn.b * 0.55 - 0.30 ) * 2.5 );
		float detailWisp = saturate( ( dn.a * 0.65 + dn.g * 0.35 - 0.25 ) * 2.0 );
		float detail = lerp( detailWisp, 1.0 - detailBillow, saturate( h01 * 2.8 ) );
		float erosion = lerp( 0.20, 0.48, saturate( 1.0 - base * 1.25 ) );
		base = saturate( Remap( base, detail * erosion, 1.0, 0.0, 1.0 ) );
		outBillow = detailBillow;
	}

	base *= 0.55 + 0.45 * colState.x;

	// Modulated overcast deck keeps full sky cover while sculpting storm rolls and thinner streaks
	if ( colState.w > 0.0 )
	{
		float deckFloor = colState.w * ( 0.035 + 0.22 * shape * ( 0.55 + 0.90 * wm.r ) * ( 0.65 + 0.55 * outBillow ) ) * hp;
		base = max( base, deckFloor );
	}

	return base;
}

float HG( float c, float g )
{
	float g2 = g * g;
	return ( 1.0 - g2 ) / ( 4.0 * PI * pow( max( 1.0 + g2 - 2.0 * g * c, 1e-4 ), 1.5 ) );
}

float4 main( const PS_INPUT In ) : COLOR
{
	// ---- is this pixel sky? (any of the full-res pixels it covers)
	float2 uv = In.vTexCoord;
	float2 fp = g_vecScreen.xy * ( 0.25 / g_vecScreen.z );
	float4 depths = float4(
		tex2D( sDepth, uv + float2( -fp.x, -fp.y ) ).x,
		tex2D( sDepth, uv + float2(  fp.x, -fp.y ) ).x,
		tex2D( sDepth, uv + float2( -fp.x,  fp.y ) ).x,
		tex2D( sDepth, uv + float2(  fp.x,  fp.y ) ).x );
	if ( min( min( depths.x, depths.y ), min( depths.z, depths.w ) ) > 0.1 )
		return float4( 0, 0, 0, -1 );

	float3 rd = normalize( In.vecWorldRay );
	if ( rd.z < -0.03 )
		return float4( 0, 0, 0, 1 );

	const float densityScale = g_vecCloud0.y;
	const float darkness = g_vecCloud0.w;
	const float baseH = g_vecCloud1.x;
	const float invThick = 1.0 / max( g_vecCloud1.y, 1.0 );
	const float topH = baseH + g_vecCloud1.y;

	// ---- where the ray enters/leaves the cloud layer (camera below the layer)
	float camH = 2.0;
	float mu = max( rd.z, 0.0 );
	float tStart = DistToLayer( mu, camH, baseH );
	float tEnd = DistToLayer( mu, camH, topH );
	if ( tStart > MAX_DIST )
		return float4( 0, 0, 0, 1 );
	tEnd = min( tEnd, tStart + 12000.0 );
	tEnd = min( tEnd, MAX_DIST );

	const float flSteps = max( g_vecCloud2.z, 8.0 );
	const float effSteps = max( flSteps * lerp( 1.0, 0.68, saturate( mu * 1.4 ) ), 12.0 );
	const float dt = ( tEnd - tStart ) / effSteps;

	float jitter = frac( frac( 52.9829189 * frac( dot( In.vScreenPos, float2( 0.06711056, 0.00583715 ) ) ) )
		+ g_vecScreen.w * 0.61803398 );

	float cloudScale = ( g_vecCloud3.z > 0.0 ) ? g_vecCloud3.z : UNITS_TO_M;
	float2 camXY = g_vecCamera.xy * cloudScale + g_vecWind.xy;
	float2 windDir = ( dot( g_vecWind.zw, g_vecWind.zw ) > 1e-6 ) ? normalize( g_vecWind.zw )
		: ( ( dot( g_vecWind.xy, g_vecWind.xy ) > 1.0 ) ? normalize( g_vecWind.xy ) : float2( 0.85, 0.52 ) );

	float3 L = g_vecLightDir.xyz;
	float cosTheta = dot( rd, L );
	// Multi-lobe phases: strong forward silver lining, broad forward scatter, isotropic deep multiple scatter
	float phaseDirect = ( lerp( HG( cosTheta, 0.78 ), HG( cosTheta, -0.25 ), 0.25 ) + 0.35 * HG( cosTheta, 0.90 ) ) * ( 4.0 * PI );
	float phaseMid = HG( cosTheta, 0.35 ) * ( 4.0 * PI );
	float phaseDeep = 0.35 + 0.65 * HG( cosTheta, 0.08 ) * ( 4.0 * PI );

	const float dbg = g_vecCloud3.w;
	float3 lightColor = g_vecLightColor.rgb * g_vecCloud2.x * ( 1.0 - 0.75 * darkness ) * ( ( dbg > 1.5 && dbg < 2.5 ) ? 0.0 : 1.0 );
	const float ambScale = g_vecCloud2.x * 0.75 * ( ( dbg > 0.5 && dbg < 1.5 ) ? 0.0 : 1.0 );
	float sunLow = saturate( 1.0 - L.z * 3.5 ) * saturate( ( L.z + 0.08 ) * 8.0 );

	float3 flashColor = float3( 0.80, 0.86, 1.0 ) * g_vecLightning.w * 3.2;
	float flashCos = saturate( dot( rd, normalize( g_vecLightning.xyz ) ) );
	float flashAim = pow( flashCos, 14.0 ) + 0.1 * flashCos * flashCos;

	float3 scatter = 0.0;
	float T = 1.0;
	const float sigmaScale = 0.04 * densityScale;
	const float curvature = 0.5 / ( EARTH_R + camH );

	// Start in fine mode at step 0, switch to 2x stride in empty air after 2 zero samples, step back on hit
	float fi = jitter;
	int stride = 1;
	int zeroCount = 0;

	[loop]
	for ( int i = 0; i < 64; i++ )
	{
		if ( fi >= effSteps || T < 0.02 )
			break;

		float t = tStart + fi * dt;
		float3 samplePos = rd * t;
		float altitude = camH + samplePos.z + dot( samplePos.xy, samplePos.xy ) * curvature;
		float h01 = ( altitude - baseH ) * invThick;
		float3 worldPos = float3( samplePos.xy + camXY, altitude );

		float4 wm, colState;
		SampleWeatherColumn( worldPos.xy, wm, colState );

		float billow;
		bool wantDetail = ( stride == 1 ) && ( t < 24000.0 ) && ( T > 0.12 );
		float density = CloudDensityWithWM( worldPos, h01, wm, colState, windDir, wantDetail, billow );

		if ( stride == 2 )
		{
			if ( density <= 0.001 )
			{
				fi += 2.0;
				continue;
			}
			stride = 1;
			zeroCount = 0;
			fi -= 1.0;
			continue;
		}

		if ( density <= 0.001 )
		{
			zeroCount++;
			if ( zeroCount >= 2 )
				stride = 2;
			fi += 1.0;
			continue;
		}
		zeroCount = 0;

		// 4-step exponential light march toward sun (reusing column wm & early-out at layer top)
		float od = ( 1.0 - billow ) * density * g_vecCloud1.y * 0.040 * ( 1.0 - 0.35 * h01 );
		float lstep = g_vecCloud1.y * 0.045;
		float3 lp = worldPos;
		[loop]
		for ( int j = 0; j < 4; j++ )
		{
			lp += L * lstep;
			float hL = ( lp.z - baseH ) * invThick;
			if ( hL > 1.0 || hL < 0.0 )
				break;
			float unusedBillow;
			od += CloudDensityWithWM( lp, hL, wm, colState, windDir, false, unusedBillow ) * lstep;
			lstep *= 2.1;
		}

		float tau = od * sigmaScale;
		float3 sun = exp( -tau ) * phaseDirect + 0.45 * exp( -tau * 0.35 ) * phaseMid + 0.18 * exp( -tau * 0.16 ) * phaseDeep;
		float powder = 1.0 - 0.55 * exp( -tau * 1.8 );
		sun *= lerp( 1.0, powder * 1.10, saturate( 0.60 - 0.60 * cosTheta ) );

		// Analytical sky dome ambient occlusion + cool sky shadows + warm sunset underglow
		float skyAO = lerp( 0.18, 1.0, pow( saturate( h01 ), 0.70 ) ) * exp( -density * ( 1.0 - h01 ) * densityScale * 1.65 );
		float3 ambient = lerp( g_vecSkyHorizon.rgb * float3( 0.68, 0.76, 0.90 ), g_vecSkyZenith.rgb * float3( 0.92, 0.97, 1.05 ), saturate( h01 * 1.25 ) )
			* ( 0.12 + 0.88 * h01 * h01 ) * ( 1.0 - darkness * 0.50 ) * skyAO;
		ambient += lightColor * ( 0.055 * sunLow * ( 1.0 - h01 ) * exp( -tau * 0.22 ) );

		float3 S = sun * lightColor + ambient * ambScale + flashColor * flashAim * ( 1.0 - 0.6 * h01 );

		float sigma = density * sigmaScale;
		float stepT = exp( -sigma * dt );
		scatter += T * S * ( 1.0 - stepT );
		T *= stepT;
		fi += 1.0;
	}

	if ( T < 0.025 )
		T = saturate( ( T - 0.02 ) / 0.98 );

	// Aerial perspective toward horizon + gentle clip fade at MAX_DIST
	float distHaze = 1.0 - exp( -tStart / 45000.0 );
	float3 horizonHaze = g_vecSkyHorizon.rgb * ambScale * ( 0.55 - 0.25 * darkness );
	scatter = lerp( scatter, horizonHaze * ( 1.0 - T ), distHaze * 0.55 );
	float fade = saturate( ( MAX_DIST - tStart ) / 18000.0 );
	scatter *= fade;
	T = lerp( 1.0, T, fade );

	// ---- altocumulus: high rippled cloudlet sheets behind the cumulus
	float acAmount = g_vecCloud3.x;
	if ( acAmount > 0.01 && T > 0.01 )
	{
		float tAc = DistToLayer( mu, camH, g_vecCloud3.y );
		if ( tAc < 90000.0 )
		{
			float2 p = rd.xy * tAc + camXY * 1.3;
			float2 wmAc = tex2Dlod( sWeather, float4( p / WEATHER_PERIOD + 0.37, 0, 0 ) ).rb;
			p += ( wmAc - 0.5 ) * 1200.0;
			float amount = saturate( acAmount * 1.2 + ( wmAc.x - 0.5 ) * 1.1 );
			float4 n1 = Noise3D( float3( p / 8000.0, 0.31 + g_vecCloud1.w * 0.0003 ) );
			float4 n2 = Noise3D( float3( p / 2400.0, 0.73 + g_vecCloud1.w * 0.0008 ) );
			float cells = saturate( ( n1.g * 0.45 + n2.b * 0.55 - 0.30 ) * 2.5 );
			float rows = 0.5 + 0.5 * sin( dot( p, windDir ) * ( 6.2831853 / 700.0 ) + n1.a * 6.0 );
			cells *= 0.80 + 0.35 * rows;
			float patches = saturate( ( n1.r - 0.42 ) * 2.8 );
			float dens = smoothstep( 0.0, 1.0, saturate( ( cells - ( 0.88 - amount * 0.58 ) ) / 0.32 ) ) * patches;
			float acFade = exp( -tAc / 48000.0 ) * saturate( rd.z * 12.0 );
			float acAlpha = dens * amount * 0.52 * acFade;

			float acPhase = HG( cosTheta, 0.65 ) * ( 4.0 * PI );
			float3 acSun = lightColor * ( 0.32 + 0.42 * acPhase ) * ( 1.30 - 0.75 * dens );
			float3 acAmb = g_vecSkyZenith.rgb * ambScale * ( 1.0 - darkness * 0.45 );
			scatter += T * ( acSun + acAmb ) * acAlpha;
			T *= 1.0 - acAlpha;
		}
	}

	// moonlit clouds are silver-grey, not the white of day
	scatter *= lerp( 1.0, 0.45, saturate( g_vecLightColor.w ) );

	float4 result = float4( scatter, T );
	if ( dbg > 2.5 )
		result = float4( ( 1.0 - T ).xxx * 0.3, 0.0 );

	return result;
}
