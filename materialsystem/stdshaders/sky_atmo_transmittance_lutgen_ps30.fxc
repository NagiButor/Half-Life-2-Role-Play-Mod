
#include "common_ps_fxc.h"

struct PS_INPUT
{
	float2 vTexCoord : TEXCOORD0;
};

struct PS_OUTPUT
{
	float4 vColor_0 : COLOR0;
};

static const float PI = 3.14159265358;

static const float groundRadiusMM = 6.360;
static const float atmosphereRadiusMM = 6.460;

static const float3 rayleighScatteringBase = float3( 5.802, 13.558, 33.1 );
static const float rayleighAbsorptionBase = 0.0;

static const float mieScatteringBase = 3.996;
static const float mieAbsorptionBase = 4.4;

static const float3 ozoneAbsorptionBase = float3( 0.650, 1.881, 0.085 );

float rayIntersectSphere( float3 ro, float3 rd, float rad )
{
	float b = dot( ro, rd );
	float c = dot( ro, ro ) - rad * rad;
	if ( c > 0.0 && b > 0.0 )
		return -1.0;
	float discr = b * b - c;
	if ( discr < 0.0 )
		return -1.0;
	float s = sqrt( discr );
	if ( discr > b * b )
		return ( -b + s );
	return ( -b - s );
}

// HL2RPM: x = aerosol (Mie) multiplier from the weather (haze, fog, rain)
const float4 g_vecAtmo : register( c2 );

void getScatteringValues( float3 pos, out float3 rayleighScattering, out float mieScattering, out float3 extinction )
{
	// HL2RPM: real scale heights (8 km Rayleigh, 1.2 km Mie) and an ozone layer peaking
	// at 25 km. These were 10x too large, which made the sky pink/purple.
	float altitudeKM = ( length( pos ) - groundRadiusMM ) * 1000.0;

	float rayleighDensity = exp( -altitudeKM / 8.0 );
	float mieDensity = exp( -altitudeKM / 1.2 ) * max( g_vecAtmo.x, 0.1 );

	float3 ozoneAbsorption = ozoneAbsorptionBase * max( 0.0, 1.0 - abs( altitudeKM - 25.0 ) / 15.0 );

	rayleighScattering = rayleighScatteringBase * rayleighDensity;
	float3 rayleighAbsorption = rayleighAbsorptionBase * rayleighDensity;

	mieScattering = mieScatteringBase * mieDensity;
	float3 mieAbsorption = mieAbsorptionBase * mieDensity;

	extinction = rayleighScattering + rayleighAbsorption + mieScattering + mieAbsorption + ozoneAbsorption;
}

float3 IntegrateTransmittance( float r, float mu )
{
	r = clamp( r, groundRadiusMM, atmosphereRadiusMM );
	mu = clamp( mu, -1.0, 1.0 );

	float3 pos = float3( 0.0, 0.0, r );
	float sinTheta = sqrt( saturate( 1.0 - mu * mu ) );
	float3 dir = float3( sinTheta, 0.0, mu );

	float t = rayIntersectSphere( pos, dir, atmosphereRadiusMM );
	if ( t <= 0.0 )
		return 1.0.xxx;

	const int STEPS = 40;	// rebuilt only when the weather haze changes, can afford accuracy
	float dt = t / (float)STEPS;

	float3 tau = 0.0.xxx;
	for ( int i = 0; i < STEPS; i++ )
	{
		float s = ( (float)i + 0.5 ) * dt;
		float3 newPos = pos + dir * s;

		float3 rayleighScattering, extinction;
		float mieScattering;
		getScatteringValues( newPos, rayleighScattering, mieScattering, extinction );

		tau += extinction * dt;
	}

	return exp( -tau );
}

PS_OUTPUT main( const PS_INPUT In )
{
	float2 uv = In.vTexCoord;

	float r = lerp( groundRadiusMM, atmosphereRadiusMM, uv.y );
	float mu = lerp( -1.0, 1.0, uv.x );

	float3 T = IntegrateTransmittance( r, mu );

	PS_OUTPUT Out;
	Out.vColor_0 = float4( T, 1.0 );
	return Out;
}

