//========= HL2RPM ============================================================//
//
// Depth and normal aware (bilateral) separable blur of the half resolution
// indirect light (deferred_gi_ps30): rgb light, a 1 (0 = sky).
//
// Each half resolution pixel stands for the lower right pixel of its 2 x 2 block
// (the same one deferred_gi_ps30 took its depth and normal from). A tap counts as
// far as its depth and its normal are this pixel's: without the normal the light
// of one face of a box ran over its edge onto the next face, a light line along
// every edge.
//
//=============================================================================//

#include "common_ps_fxc.h"

sampler sGI				: register( s0 );	// half resolution GI (top left of a full size RT)
sampler sDepth			: register( s1 );	// G-buffer linear depth
sampler sNormals		: register( s2 );	// G-buffer normals

const float4 g_vecBlur	: register( c0 );	// xy step (screen uv), z depth tolerance (fraction), w GI uv scale

struct PS_INPUT
{
	float2 vTexCoord			: TEXCOORD0;
	float3 vecWorldRay			: TEXCOORD1;
};

float TapWeight( float2 uvPixel, float d0, float3 n0, float invTol )
{
	const float d = tex2Dlod( sDepth, float4( uvPixel, 0, 0 ) ).x;
	const float3 n = normalize( tex2Dlod( sNormals, float4( uvPixel, 0, 0 ) ).xyz * 2.0 - 1.0 );
	return saturate( 1.0 - abs( d - d0 ) * invTol ) * saturate( dot( n, n0 ) * 2.0 - 1.0 ) * ( d > 0.1 ? 1.0 : 0.0 );
}

float4 main( const PS_INPUT In ) : COLOR
{
	const float2 uv = In.vTexCoord;
	const float2 texel = float2( abs( ddx( uv.x ) ), abs( ddy( uv.y ) ) );
	// (reads of the half resolution source stay half a texel inside its drawn area)
	const float2 uvMax = 1.0 - 0.5 * texel;
	// the lower right pixel of the 2 x 2 block
	const float2 toPixel = 0.25 * texel;

	const float d0 = tex2Dlod( sDepth, float4( uv + toPixel, 0, 0 ) ).x;
	if ( d0 < 0.1 )
		return float4( 0, 0, 0, 0 );
	const float3 n0 = normalize( tex2Dlod( sNormals, float4( uv + toPixel, 0, 0 ) ).xyz * 2.0 - 1.0 );

	static const float w[5] = { 0.2270270, 0.1945946, 0.1216216, 0.0540541, 0.0162162 };

	float4 sum = tex2Dlod( sGI, float4( min( uv, uvMax ) * g_vecBlur.w, 0, 0 ) ) * w[0];
	float wsum = w[0];
	const float invTol = 1.0 / max( d0 * g_vecBlur.z, 1.0 );

	[unroll]
	for ( int i = 1; i < 5; i++ )
	{
		const float2 off = g_vecBlur.xy * i;

		const float2 uvA = uv + off;
		const float wA = w[i] * TapWeight( uvA + toPixel, d0, n0, invTol );
		sum += tex2Dlod( sGI, float4( min( uvA, uvMax ) * g_vecBlur.w, 0, 0 ) ) * wA;
		wsum += wA;

		const float2 uvB = uv - off;
		const float wB = w[i] * TapWeight( uvB + toPixel, d0, n0, invTol );
		sum += tex2Dlod( sGI, float4( min( uvB, uvMax ) * g_vecBlur.w, 0, 0 ) ) * wB;
		wsum += wB;
	}

	return sum / max( wsum, 1e-4 );
}
