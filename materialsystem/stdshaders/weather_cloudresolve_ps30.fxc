//========= HL2RPM ============================================================//
//
// Temporal resolve for the screen-space clouds (weather_clouds_ps30).
//
// The raymarch is jittered every frame; this pass reprojects last frame's
// result (clouds are at infinity, so only the camera rotation matters) and
// clamps it to the 3x3 neighbourhood of the new frame before blending, so
// edges never smear behind a turning camera (no ghosting).
//
// rgb = in-scattered light, a = transmittance, a < 0 = covered by geometry.
//
//=============================================================================//

#include "common_ps_fxc.h"

sampler sRaw					: register( s0 );	// this frame's raymarch
sampler sHistory				: register( s1 );	// last frame's resolved clouds

const float4 g_vecResolve		: register( c0 );	// xy texel size of the RTs, z legacy, w history weight
const float4 g_matPrevVP[4]		: register( c1 );	// rows, rotation-only previous view projection
const float4 g_vecCloudUVRect	: register( c5 );	// xy active cloud RT uv scale, zw max sample uv clamp

struct PS_INPUT
{
	float2 vTexCoord			: TEXCOORD0;
	float3 vecWorldRay			: TEXCOORD1;
};

float4 main( const PS_INPUT In ) : COLOR
{
	const float2 texel = g_vecResolve.xy;
	const float2 uvMax = g_vecCloudUVRect.zw;
	const float2 uvRaw = min( In.vTexCoord * g_vecCloudUVRect.xy, uvMax );

	float4 cur = tex2Dlod( sRaw, float4( uvRaw, 0, 0 ) );
	[branch]
	if ( cur.a < 0.0 )
	{
		// HL2RPM: dilate valid sky/cloud values 1 texel into covered geometry borders so bilinear
		// filtering in procsky_atmo_ps20b never blends with (0,0,0,-1) to cause black halos.
		// Check 4 cardinal neighbors first (1-texel distance): straight sky edges resolve in 4 taps.
		float4 dilSum = 0.0;
		float dilCount = 0.0;
		float4 nL = tex2Dlod( sRaw, float4( clamp( uvRaw + float2( -texel.x, 0.0 ), 0.0, uvMax ), 0, 0 ) );
		float4 nR = tex2Dlod( sRaw, float4( clamp( uvRaw + float2(  texel.x, 0.0 ), 0.0, uvMax ), 0, 0 ) );
		float4 nU = tex2Dlod( sRaw, float4( clamp( uvRaw + float2( 0.0, -texel.y ), 0.0, uvMax ), 0, 0 ) );
		float4 nD = tex2Dlod( sRaw, float4( clamp( uvRaw + float2( 0.0,  texel.y ), 0.0, uvMax ), 0, 0 ) );
		if ( nL.a >= 0.0 ) { dilSum += nL; dilCount += 1.0; }
		if ( nR.a >= 0.0 ) { dilSum += nR; dilCount += 1.0; }
		if ( nU.a >= 0.0 ) { dilSum += nU; dilCount += 1.0; }
		if ( nD.a >= 0.0 ) { dilSum += nD; dilCount += 1.0; }
		if ( dilCount > 0.0 )
			return dilSum / dilCount;

		// Deep interior geometry check via bilinear-filtered, already-dilated history: if last
		// frame's reprojected 2x2 neighborhood was also all covered (-1.0), skip the 4 diagonal taps.
		if ( g_vecResolve.w > 0.0 )
		{
			float4 p = float4( normalize( In.vecWorldRay ) * 1000.0, 1.0 );
			float4 clip = float4( dot( g_matPrevVP[0], p ), dot( g_matPrevVP[1], p ), dot( g_matPrevVP[2], p ), dot( g_matPrevVP[3], p ) );
			if ( clip.w > 0.001 )
			{
				float2 prevUV = ( clip.xy / clip.w ) * float2( 0.5, -0.5 ) + 0.5;
				if ( all( prevUV >= 0.0 ) && all( prevUV <= 1.0 ) )
				{
					if ( tex2Dlod( sHistory, float4( min( prevUV * g_vecCloudUVRect.xy, uvMax ), 0, 0 ) ).a < -0.99 )
						return float4( 0, 0, 0, -1 );
				}
			}
		}

		// Concave corner / fast-turn fallback: check the 4 diagonals to guarantee zero black halos
		float4 d0 = tex2Dlod( sRaw, float4( clamp( uvRaw + float2( -texel.x, -texel.y ), 0.0, uvMax ), 0, 0 ) );
		float4 d1 = tex2Dlod( sRaw, float4( clamp( uvRaw + float2(  texel.x, -texel.y ), 0.0, uvMax ), 0, 0 ) );
		float4 d2 = tex2Dlod( sRaw, float4( clamp( uvRaw + float2( -texel.x,  texel.y ), 0.0, uvMax ), 0, 0 ) );
		float4 d3 = tex2Dlod( sRaw, float4( clamp( uvRaw + float2(  texel.x,  texel.y ), 0.0, uvMax ), 0, 0 ) );
		if ( d0.a >= 0.0 ) { dilSum += d0; dilCount += 1.0; }
		if ( d1.a >= 0.0 ) { dilSum += d1; dilCount += 1.0; }
		if ( d2.a >= 0.0 ) { dilSum += d2; dilCount += 1.0; }
		if ( d3.a >= 0.0 ) { dilSum += d3; dilCount += 1.0; }
		if ( dilCount > 0.0 )
			return dilSum / dilCount;
		return float4( 0, 0, 0, -1 );
	}

	// 3x3 neighbourhood statistics (valid sky texels only, clamped inside active RT rect)
	float4 mn = cur;
	float4 mx = cur;
	float4 m1 = cur;
	float4 m2 = cur * cur;
	float cnt = 1.0;
	float4 sumTent = cur * 4.0;
	float wTent = 4.0;
	[unroll]
	for ( int y = -1; y <= 1; y++ )
	{
		[unroll]
		for ( int x = -1; x <= 1; x++ )
		{
			if ( x == 0 && y == 0 )
				continue;
			float4 s = tex2Dlod( sRaw, float4( clamp( uvRaw + float2( x, y ) * texel, 0.0, uvMax ), 0, 0 ) );
			if ( s.a >= 0.0 )
			{
				mn = min( mn, s );
				mx = max( mx, s );
				m1 += s;
				m2 += s * s;
				cnt += 1.0;
				const float w = ( x == 0 || y == 0 ) ? 2.0 : 1.0;
				sumTent += s * w;
				wTent += w;
			}
		}
	}
	float4 curFiltered = sumTent / wTent;

	if ( g_vecResolve.w <= 0.0 )
		return curFiltered;

	float3 rd = normalize( In.vecWorldRay );
	float4 p = float4( rd * 1000.0, 1.0 );
	float4 clip = float4( dot( g_matPrevVP[0], p ), dot( g_matPrevVP[1], p ), dot( g_matPrevVP[2], p ), dot( g_matPrevVP[3], p ) );
	if ( clip.w <= 0.001 )
		return curFiltered;

	float2 prevUV = ( clip.xy / clip.w ) * float2( 0.5, -0.5 ) + 0.5;
	if ( any( prevUV < 0.0 ) || any( prevUV > 1.0 ) )
		return curFiltered;

	float4 hist = tex2Dlod( sHistory, float4( min( prevUV * g_vecCloudUVRect.xy, uvMax ), 0, 0 ) );
	if ( hist.a < 0.0 )
		return curFiltered;

	// Variance-clipped AABB keeps edges crisp while suppressing IGN shimmer
	m1 /= cnt;
	float4 sigma = sqrt( max( m2 / cnt - m1 * m1, 0.0 ) );
	float4 slack = ( mx - mn ) * 0.12;
	float4 cMin = max( mn - slack, m1 - 1.35 * sigma );
	float4 cMax = min( mx + slack, m1 + 1.35 * sigma );
	hist = clamp( hist, cMin, cMax );

	// Preserve 85% of the sharp center texel when temporal history is valid
	float4 sharpCur = lerp( cur, curFiltered, 0.15 );
	return lerp( sharpCur, hist, g_vecResolve.w );
}
