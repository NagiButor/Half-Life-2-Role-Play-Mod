//========= HL2RPM ============================================================//
//
// The view of a wounded man without the HEV suit (hl2rpm_vitals.cpp in the client),
// over the finished frame, before the HUD:
//  - red creeps in from the edges as health goes down: the color drains, a red cast,
//    darker right at the edge; the line it ends at is broken up by blotches;
//  - the vessels of the eye grow in from the edges and throb with the heartbeat,
//    the frame swelling a little with each beat. The vessels are a texture
//    (hl2rpm_extras/tools/make_vitals_assets.py): r the vessels, g the order they
//    show in (roots at the edge first, then inward), b blotches, a a soft halo;
//  - near the end the sight clouds over (a blurred quarter size copy of the frame)
//    and dims from the edges in, in waves.
//
// $PASS 0: the frame -> quarter size (4 bilinear taps = its 4x4 block)
// $PASS 1: the effect over the frame
//
//=============================================================================//

// STATIC: "PASS" "0..1"

#include "common_ps_fxc.h"

sampler sFrame				: register( s0 );	// the frame (gamma space)
sampler sVeins				: register( s1 );	// see above
sampler sBlur				: register( s2 );	// quarter size copy of the frame (pass 1)

const float4 g_vecParams	: register( c0 );	// x strength 0..1, y heartbeat pulse 0..1, z dimming 0..1, w clouding 0..1
const float4 g_vecParams2	: register( c1 );	// x desaturation 0..1, y swell of the frame on a beat, zw unused
const float4 g_vecRect		: register( c2 );	// the view in the frame texture: xy uv of its corner, zw its uv size
const float4 g_vecTexel		: register( c3 );	// xy 1 / frame texture size, zw 1 / quarter texture size
const float4 g_vecBlurRect	: register( c4 );	// the view in the quarter texture: xy uv of its corner, zw its uv size

struct PS_INPUT
{
	float2 vTexCoord			: TEXCOORD0;
	float3 vecWorldRay			: TEXCOORD1;
};

// (inside a [branch] only tex2Dlod - X3528)
float3 BlurTap( float2 uv )
{
	return tex2Dlod( sBlur, float4( uv, 0.0, 0.0 ) ).rgb;
}

float Luma( float3 c )
{
	return dot( c, float3( 0.299, 0.587, 0.114 ) );
}

float4 main( const PS_INPUT In ) : COLOR
{
#if PASS == 0

	const float2 uv = In.vTexCoord;
	const float2 o = g_vecTexel.xy;
	float3 c = tex2D( sFrame, uv + float2( -o.x, -o.y ) ).rgb;
	c += tex2D( sFrame, uv + float2(  o.x, -o.y ) ).rgb;
	c += tex2D( sFrame, uv + float2( -o.x,  o.y ) ).rgb;
	c += tex2D( sFrame, uv + float2(  o.x,  o.y ) ).rgb;
	return float4( c * 0.25, 1.0 );

#else

	const float strength = g_vecParams.x;
	const float pulse = g_vecParams.y;
	const float dim = g_vecParams.z;
	const float cloud = g_vecParams.w;

	// where in the view: 0..1, and how far out - a rounded rectangle (the edges of the screen, not a circle)
	const float2 uvView = ( In.vTexCoord - g_vecRect.xy ) / g_vecRect.zw;
	const float2 p = abs( uvView * 2.0 - 1.0 );
	const float r = pow( p.x * p.x * p.x + p.y * p.y * p.y, 1.0 / 3.0 );

	// the beat: the frame swells a little, more toward the edges
	const float swell = g_vecParams2.y * pulse * ( 0.4 + 0.6 * saturate( r ) );
	const float2 uvS = 0.5 + ( uvView - 0.5 ) * ( 1.0 - swell );

	float3 c = tex2D( sFrame, g_vecRect.xy + uvS * g_vecRect.zw ).rgb;

	// clouding: the blurred copy (a 4x4 box, then a wide tent of bilinear taps), more toward the edges
	[branch]
	if ( cloud > 0.002 )
	{
		const float2 lo = g_vecBlurRect.xy + g_vecTexel.zw * 0.5;
		const float2 hi = g_vecBlurRect.xy + g_vecBlurRect.zw - g_vecTexel.zw * 0.5;
		const float2 uvB = g_vecBlurRect.xy + uvS * g_vecBlurRect.zw;
		const float2 t = g_vecTexel.zw * ( 0.75 + 1.5 * cloud );
		float3 b = BlurTap( clamp( uvB, lo, hi ) ) * 2.0;
		b += BlurTap( clamp( uvB + float2(  t.x, 0.0 ), lo, hi ) );
		b += BlurTap( clamp( uvB + float2( -t.x, 0.0 ), lo, hi ) );
		b += BlurTap( clamp( uvB + float2( 0.0,  t.y ), lo, hi ) );
		b += BlurTap( clamp( uvB + float2( 0.0, -t.y ), lo, hi ) );
		b += BlurTap( clamp( uvB + float2(  t.x,  t.y ) * 0.7, lo, hi ) );
		b += BlurTap( clamp( uvB + float2( -t.x,  t.y ) * 0.7, lo, hi ) );
		b += BlurTap( clamp( uvB + float2(  t.x, -t.y ) * 0.7, lo, hi ) );
		b += BlurTap( clamp( uvB + float2( -t.x, -t.y ) * 0.7, lo, hi ) );
		c = lerp( c, b * 0.1, saturate( cloud * ( 0.55 + 0.45 * saturate( r ) ) ) );
	}

	// the vessels sit in the eye: they don't swell with the frame
	const float4 v = tex2D( sVeins, uvView );

	// the red, its inner line broken up by blotches; a beat pushes it in a little
	const float e0 = 1.12 - 0.68 * strength - 0.05 * pulse * strength;
	const float m = smoothstep( e0, e0 + 0.8, r + ( v.b - 0.5 ) * 0.14 );
	const float veil = m * ( 0.35 + 0.65 * strength );

	// (blood is dark: the cast takes some light too - over a bright sky a plain red cast glowed pink)
	c = lerp( c, Luma( c ).xxx, saturate( veil * 0.6 + g_vecParams2.x ) );
	c *= lerp( float3( 1.0, 1.0, 1.0 ), float3( 0.85, 0.13, 0.11 ), veil );
	c = lerp( c, float3( 0.30, 0.01, 0.015 ) * ( 0.45 + 0.55 * saturate( Luma( c ) * 3.0 ) ), m * m * ( 0.2 + 0.5 * strength ) );

	// the vessels: the ones whose turn has come (g) - few and faint while it isn't that bad,
	// a darker halo that swells on the beat
	const float lim = pow( abs( strength ), 1.2 ) * 1.15 + 0.06 * pulse * strength;
	const float vis = v.r * saturate( ( lim - v.g ) * 10.0 );
	const float halo = v.a * saturate( ( lim + 0.1 - v.g ) * 5.0 );
	c *= 1.0 - halo * ( 0.25 + 0.25 * pulse ) * ( 0.4 + 0.6 * strength );
	c = lerp( c, float3( 0.30, 0.0, 0.02 ), saturate( vis * ( 0.35 + 0.35 * strength + 0.25 * m ) ) );

	// dimming: from the edges in
	c *= 1.0 - dim * ( 0.3 + 0.65 * smoothstep( 0.15, 1.25, r ) );

	return float4( c, 1.0 );

#endif
}
