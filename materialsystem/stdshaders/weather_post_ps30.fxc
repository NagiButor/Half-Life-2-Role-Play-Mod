//========= HL2RPM ============================================================//
//
// Weather applied to the lit opaque scene (before translucents):
//   - wet surfaces: darker + sky reflection (Fresnel), only where rain can fall
//     (top-down rain occlusion map), walls a bit, floors fully
//   - puddles on flat ground with raindrop ripples
//   - exponential height fog with sun in-scattering
//
// Blend: ONE, SRC_ALPHA  ->  result = src.rgb + scene * src.a
//
//=============================================================================//

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"

sampler sNormals		: register( s0 );
sampler sDepth			: register( s1 );
sampler sRainMap		: register( s2 );	// hardware depth compare
sampler sWeatherMap		: register( s3 );
sampler sScene			: register( s4 );	// HL2RPM: the lit opaque scene (copied before this pass), screen space reflections

const float3 g_vecViewOrigin	: register( c0 );
const float4 g_vecRain			: register( c1 );	// rain, wetness, puddles, time
const float4 g_vecFog			: register( c2 );	// density /1000u, falloff /1000u, base z, volumetric
const float4 g_vecFogColor		: register( c3 );	// rgb, max opacity
const float4 g_vecSkyZenith		: register( c4 );
const float4 g_vecSkyHorizon	: register( c5 );
const float4 g_vecLightDir		: register( c6 );
const float4 g_vecLightColor	: register( c7 );
const float4 g_matRainMap[3]	: register( c8 );	// rows of world -> rain map texture
const float4 g_vecRainMap		: register( c11 );	// depth bias, size, texel size, valid
const float4 g_vecFlags			: register( c12 );	// x fog on, y wet on, z night, w debug view
const float4 g_matWorldToScreen[4]	: register( c13 );	// HL2RPM: world -> screen texture coords of this view (rows, c13 - c16)
const float4 g_vecSSR			: register( c17 );	// x steps (0 = off), y strength on puddles, z strength on wet surfaces, w thickness scale

struct PS_INPUT
{
	float2 vTexCoord			: TEXCOORD0;
	float3 vecWorldRay			: TEXCOORD1;
};

// HL2RPM: screen space reflection. March along R in world space (steps growing with the
// distance), compare each sample with the depth buffer along the same view ray (linear in screen
// space), refine the first hit by bisection and take the scene's color there. conf fades out
// toward the screen's edges, with the length of the ray, and is 0 for a miss (the sky stays).
float3 TraceSSR( float3 P, float3 R, float3 rayP, float2 uvP, float3 dRdu, float3 dRdv, out float conf )
{
	conf = 0.0;
	float tPrev = 0.0;
	float t = 3.0;
	const int steps = (int)g_vecSSR.x;
	[loop]
	for ( int i = 0; i < 24; i++ )
	{
		if ( i >= steps )
			break;
		const float4 q = float4( P + R * t, 1.0 );
		const float w = dot( g_matWorldToScreen[3], q );
		if ( w < 1.0 )
			break;
		const float2 uv = float2( dot( g_matWorldToScreen[0], q ), dot( g_matWorldToScreen[1], q ) ) / w;
		if ( any( uv < 0.0 ) || any( uv > 1.0 ) )
			break;
		const float d = tex2Dlod( sDepth, float4( uv, 0, 0 ) ).x;
		if ( d > 0.1 )
		{
			const float3 rayQ = rayP + dRdu * ( uv.x - uvP.x ) + dRdv * ( uv.y - uvP.y );
			const float behind = length( q.xyz - g_vecViewOrigin ) - d * length( rayQ );
			// (behind the visible surface by less than the last step: the ray went through it here,
			// not behind a thing far in front of it - the steps grow, so must the tolerance)
			if ( behind > 0.0 && behind < ( 6.0 + ( t - tPrev ) * 1.5 ) * g_vecSSR.w )
			{
				// bisection between the last sample in front and this one
				float a = tPrev, b = t;
				float2 uvHit = uv;
				[unroll]
				for ( int k = 0; k < 4; k++ )
				{
					const float m = ( a + b ) * 0.5;
					const float4 qm = float4( P + R * m, 1.0 );
					const float wm = dot( g_matWorldToScreen[3], qm );
					const float2 uvm = float2( dot( g_matWorldToScreen[0], qm ), dot( g_matWorldToScreen[1], qm ) ) / max( wm, 1.0 );
					const float dm = tex2Dlod( sDepth, float4( uvm, 0, 0 ) ).x;
					const float3 rayM = rayP + dRdu * ( uvm.x - uvP.x ) + dRdv * ( uvm.y - uvP.y );
					const float bm = length( qm.xyz - g_vecViewOrigin ) - dm * length( rayM );
					if ( bm > 0.0 )
					{
						b = m;
						uvHit = uvm;
					}
					else
						a = m;
				}
				const float2 edge = min( uvHit, 1.0 - uvHit );
				conf = saturate( min( edge.x, edge.y ) * 12.0 ) * saturate( 1.0 - i / max( (float)steps, 1.0 ) * 0.8 );
				return tex2Dlod( sScene, float4( uvHit, 0, 0 ) ).rgb;
			}
		}
		tPrev = t;
		t = t * 1.4 + 4.0;
	}
	return 0.0;
}

float RainExposure( float3 worldPos, float3 normal )
{
	if ( g_vecRainMap.w < 0.5 )
		return saturate( normal.z * 1.2 );	// no map yet: guess from the normal

	float4 wp = float4( worldPos + normal * 2.0, 1.0 );
	float3 uvz = float3( dot( g_matRainMap[0], wp ), dot( g_matRainMap[1], wp ), dot( g_matRainMap[2], wp ) );

	// outside the map: fade to the normal-based guess
	float2 edge = abs( uvz.xy * 2.0 - 1.0 );
	float inside = saturate( ( 1.0 - max( edge.x, edge.y ) ) * 12.0 );

	float z = uvz.z - g_vecRainMap.x;
	float2 o = g_vecRainMap.z / g_vecRainMap.y * 1.5;	// ~1.5 texels in uv
	float exposed = 0.25 * (
		tex2Dproj( sRainMap, float4( uvz.xy + float2( -o.x, -o.y ), z, 1 ) ).x +
		tex2Dproj( sRainMap, float4( uvz.xy + float2(  o.x, -o.y ), z, 1 ) ).x +
		tex2Dproj( sRainMap, float4( uvz.xy + float2( -o.x,  o.y ), z, 1 ) ).x +
		tex2Dproj( sRainMap, float4( uvz.xy + float2(  o.x,  o.y ), z, 1 ) ).x );

	return lerp( saturate( normal.z * 1.2 ), exposed, inside );
}

// Expanding rings where drops hit a puddle
float3 RippleNormal( float2 p, float time, float strength )
{
	float2 cell = floor( p );
	float2 f = frac( p ) - 0.5;
	float3 n = float3( 0, 0, 1 );

	float rnd = frac( sin( dot( cell, float2( 12.9898, 78.233 ) ) ) * 43758.5453 );
	float t = frac( time * 0.9 + rnd );
	float2 center = float2( frac( rnd * 7.13 ), frac( rnd * 3.71 ) ) - 0.5;
	float d = length( f - center * 0.6 );
	float ring = sin( ( d - t * 0.45 ) * 60.0 ) * saturate( 1.0 - abs( d - t * 0.45 ) * 14.0 ) * ( 1.0 - t );
	float2 dir = ( f - center * 0.6 ) / max( d, 1e-3 );
	n.xy += dir * ring * strength;
	return normalize( n );
}

float4 main( const PS_INPUT In ) : COLOR
{
	if ( g_vecFlags.w > 1.5 )
	{
		// debug: the rain occlusion map seen from above (brighter = lower occluder)
		float2 uvMap = In.vTexCoord;
		float lo = 0.0, hi = 1.0;
		[loop]
		for ( int i = 0; i < 14; i++ )
		{
			float mid = ( lo + hi ) * 0.5;
			float s = tex2Dlod( sRainMap, float4( uvMap, mid, 0 ) ).x;
			if ( s > 0.5 )
				lo = mid;
			else
				hi = mid;
		}
		float h = saturate( ( lo - 0.40 ) * 12.0 );
		return float4( h, h, h, 0.0 );
	}

	// HL2RPM: screen space steps of the view ray (the ray is linear in screen space), ahead of
	// any branch
	const float3 dRdu = ddx( In.vecWorldRay ) / ddx( In.vTexCoord.x );
	const float3 dRdv = ddy( In.vecWorldRay ) / ddy( In.vTexCoord.y );

	float depth = tex2D( sDepth, In.vTexCoord ).x;
	if ( depth < 0.1 )
		return float4( 0, 0, 0, 1 );	// sky: handled by the sky shader

	float3 worldPos = g_vecViewOrigin + In.vecWorldRay * depth;
	float3 toPoint = worldPos - g_vecViewOrigin;
	float dist = length( toPoint );
	float3 rd = toPoint / max( dist, 1e-3 );

	float4 vecNormalCtrl = tex2D( sNormals, In.vTexCoord );
	float3 N = normalize( vecNormalCtrl.xyz * 2.0 - 1.0 );
	// HL2RPM: lighting controls 1.0 = the 3D skybox (gbuffer_ps30): the rain map holds the
	// map's roofs at its reconstructed position, not the skybox's - it is under the open sky
	const bool bSkybox = vecNormalCtrl.a > ( 254.5 / 255.0 );

	float4 result = float4( 0, 0, 0, 1 );

	if ( g_vecFlags.w > 0.5 )
	{
		// debug: rain exposure (red = open sky, blue = covered), green = outside the map
		float e = RainExposure( worldPos, N );
		float valid = g_vecRainMap.w;
		return float4( e, 1.0 - valid, 1.0 - e, 0.0 ) * ( 0.35 + 0.65 * saturate( N.z * 0.5 + 0.5 ) );
	}

	// ---------------- wetness
	float wetness = g_vecRain.y;
	if ( g_vecFlags.y > 0.5 && wetness > 0.001 )
	{
		float exposure = bSkybox ? 1.0 : RainExposure( worldPos, N );
		float wet = wetness * exposure * saturate( N.z * 1.1 + 0.35 );

		float2 puv = worldPos.xy / 700.0;
		float pn = tex2D( sWeatherMap, puv ).a * 0.7 + tex2D( sWeatherMap, puv * 3.7 + 0.21 ).a * 0.3;
		float puddles = g_vecRain.z;
		float puddle = puddles * exposure * smoothstep( 0.92, 0.985, N.z )
			* smoothstep( 0.62 - puddles * 0.28, 0.70 - puddles * 0.28, pn );

		float3 Nw = N;
		if ( puddle > 0.01 )
		{
			float3 up = float3( 0, 0, 1 );
			if ( g_vecRain.x > 0.02 )
				up = RippleNormal( worldPos.xy / 18.0, g_vecRain.w, 0.25 * g_vecRain.x );
			Nw = normalize( lerp( N, up, puddle ) );
		}

		float3 V = -rd;
		float3 R = reflect( rd, Nw );
		float NdV = saturate( dot( Nw, V ) );
		float fresnel = pow( 1.0 - NdV, 5.0 );

		// standing water is a mirror: the sharp sky, the sun's glint, Fresnel up to 1
		float3 skySharp = lerp( g_vecSkyHorizon.rgb, g_vecSkyZenith.rgb, saturate( R.z * 1.2 ) );

		// HL2RPM: what is really around - buildings, lamps, the street - from the screen, where
		// the reflected ray finds it (the sky only where it misses)
		float ssrConf = 0.0;
		float3 ssrColor = 0.0;
		[branch]
		if ( g_vecSSR.x > 0.5 && ( puddle > 0.05 || ( g_vecSSR.z > 0.0 && wet > 0.35 && fresnel > 0.15 ) ) && !bSkybox )
			ssrColor = TraceSSR( worldPos + Nw * 1.5, R, In.vecWorldRay, In.vTexCoord, dRdu, dRdv, ssrConf );
		skySharp = lerp( skySharp, ssrColor, ssrConf * g_vecSSR.y );
		float sunSpec = pow( saturate( dot( R, g_vecLightDir.xyz ) ), 220.0 ) * saturate( g_vecLightDir.z * 5.0 );
		float3 reflPuddle = ( skySharp + g_vecLightColor.rgb * sunSpec * 0.5 ) * ( 0.02 + 0.98 * fresnel );

		// the water film on a rough surface is not: it reflects a blurred sky, and little even
		// at grazing angles. (It used to reach ~60 % toward the horizon, so the wet look came
		// and went with the pitch of the view and travelled with the player; the darkening
		// below is what reads as "wet" and doesn't depend on the view.)
		float3 skyRough = lerp( g_vecSkyHorizon.rgb, g_vecSkyZenith.rgb, 0.45 + 0.25 * saturate( R.z ) );
		skyRough = lerp( skyRough, ssrColor, ssrConf * g_vecSSR.z );
		float3 reflWet = skyRough * ( 0.02 + 0.13 * fresnel );

		result.rgb += reflWet * wet * ( 1.0 - puddle ) + reflPuddle * puddle;
		result.a *= 1.0 - ( wet * 0.40 + puddle * 0.25 );
	}

	// ---------------- height fog
	if ( g_vecFlags.x > 0.5 && g_vecFog.x > 0.0 )
	{
		float d0 = g_vecFog.x * 0.001;
		float k = max( g_vecFog.y * 0.001, 1e-6 );
		float camH = g_vecViewOrigin.z - g_vecFog.z;
		float dz = toPoint.z;
		float kdz = k * dz;
		float shape = ( abs( kdz ) > 1e-4 ) ? ( 1.0 - exp( -kdz ) ) / kdz : 1.0;
		float opticalDepth = d0 * dist * exp( -k * camH ) * shape;
		float fog = ( 1.0 - exp( -opticalDepth ) ) * g_vecFogColor.a;

		// sunlight scattered toward the camera (strong forward lobe)
		float cosTheta = dot( rd, g_vecLightDir.xyz );
		float g = 0.62;
		float phase = ( 1.0 - g * g ) / pow( max( 1.0 + g * g - 2.0 * g * cosTheta, 1e-3 ), 1.5 ) * 0.25;
		float3 fogColor = g_vecFogColor.rgb + g_vecLightColor.rgb * phase * 0.18 * ( 1.0 - g_vecFlags.z );

		result.rgb = result.rgb * ( 1.0 - fog ) + fogColor * fog;
		result.a *= 1.0 - fog;
	}

	return result;
}
