
// STATIC:		"USEWORLDTRANSFORM"			"0..1"

// DYNAMIC:		"NUM_SHADOWED_COOKIE"		"0..2"
// DYNAMIC:		"NUM_SHADOWED"				"0..3"
// DYNAMIC:		"NUM_COOKIE"				"0..3"
// DYNAMIC:		"NUM_SIMPLE"				"0..10"

// SKIP:		!$NUM_SHADOWED_COOKIE && !$NUM_SHADOWED && !$NUM_COOKIE && !$NUM_SIMPLE

// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED_COOKIE && $NUM_SHADOWED
// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED_COOKIE && $NUM_COOKIE
// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED_COOKIE && $NUM_SIMPLE
// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED && $NUM_COOKIE
// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED && $NUM_SIMPLE
// SKIP:		$USEWORLDTRANSFORM && $NUM_COOKIE && $NUM_SIMPLE

// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED_COOKIE > 1
// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED > 1
// SKIP:		$USEWORLDTRANSFORM && $NUM_COOKIE > 1
// SKIP:		$USEWORLDTRANSFORM && $NUM_SIMPLE > 1

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"

/*

	Point lights:

	position		x y z	radius			w
	color diffuse	x y z	falloffpower	w
	color ambient	x y z

	** shadowed or cookied **
							shadowscale		w

	rotationmatrix	x y z
					x y z
					x y z

*/


sampler sNormals							: register( s0 );
sampler sDepth								: register( s1 );
#if !DEFCFG_LIGHTCTRL_PACKING
sampler sLightCtrl							: register( s2 );
#endif

const float3 g_vecViewOrigin				: register( c0 );
const float4 g_vecShadowMappingTweaks_0		: register( c1 );
const float4 g_vecShadowMappingTweaks_1		: register( c2 );

#if USEWORLDTRANSFORM
const float3 g_vecFrustumCenter		: register( c3 );
const float3 g_vecFrustumRight		: register( c4 );
const float3 g_vecFrustumUp			: register( c5 );
const float2 g_vecHalfScreenTexel		: register( c6 );
#endif


sampler sMixedSampler[FREE_LIGHT_SAMPLERS]			: register( FIRST_LIGHT_SAMPLER_FXC );
const float4 g_flMixedData[78]						: register( FIRST_SHARED_LIGHTDATA_CONSTANT_FXC ); // MAX_LIGHTDATA_CONSTANT_ROWS

// HL2RPM: what of the world each light reaches (client deferred_lightreach.cpp; the layout is in
// deferred_global_common.h): the free distance from the light in the direction of the pixel, traced
// against the world. 1 where the light gets to, 0 behind the first wall - its shadow maps (props,
// people) are separate and only the near lamps have them; without this a lamp, its fill (ambient)
// and its bounce light lit the far side of a wall. The light's parameter: -1 = no map (it moves, is
// new, sits in a wall), else slot + 0.5 x how far the map has eased in.
sampler sLightReach							: register( s15 );

float LightReach( float flParam, float3 worldPos, float3 normal, float3 lightPos )
{
	if ( flParam < 0.0f )
		return 1.0f;

	float3 vecDelta = worldPos - lightPos;
	const float flDist0 = length( vecDelta );
	// (off the surface along its normal: a face turned to the light comes out of its wall, the far
	// side of a wall goes deeper behind it)
	vecDelta += normal * ( 4.0f + flDist0 * 0.01f );
	const float flDist = length( vecDelta );

	const float flSlot = floor( flParam );
	const float flFade = saturate( frac( flParam ) * 2.0f );
	const float3 a = abs( vecDelta );
	float flFace, flMajor;
	float2 uv;
	if ( a.x >= a.y && a.x >= a.z )
	{
		flMajor = a.x;
		flFace = vecDelta.x > 0.0f ? 0.0f : 1.0f;
		uv = vecDelta.yz;
	}
	else if ( a.y >= a.z )
	{
		flMajor = a.y;
		flFace = vecDelta.y > 0.0f ? 2.0f : 3.0f;
		uv = vecDelta.xz;
	}
	else
	{
		flMajor = a.z;
		flFace = vecDelta.z > 0.0f ? 4.0f : 5.0f;
		uv = vecDelta.xy;
	}
	float2 tex = clamp( ( uv / max( flMajor, 0.001f ) * 0.5f + 0.5f ) * LIGHTREACH_N, 0.5f, LIGHTREACH_N - 0.5f );
	const float flRow = floor( flSlot / LIGHTREACH_SLOTS_X + 0.001f );
	const float flCol = flSlot - flRow * LIGHTREACH_SLOTS_X;
	tex += float2( ( flCol * 6.0f + flFace ) * LIGHTREACH_N, flRow * LIGHTREACH_N );
	const float flFree = tex2Dlod( sLightReach, float4( tex / float2( LIGHTREACH_ATLAS_W, LIGHTREACH_ATLAS_H ), 0, 0 ) ).r;

	// full up to the wall (+ a margin for the coarse map), gone a little behind it
	const float flBias = 2.0f + flDist * 0.02f;
	const float flSoft = 4.0f + flDist * 0.03f;
	return lerp( 1.0f, saturate( ( flFree + flBias - flDist ) / flSoft + 1.0f ), flFade );
}


struct PS_INPUT
{
#if USEWORLDTRANSFORM
	float3 vecProjXYW				: TEXCOORD0;
#else
	float2 vTexCoord				: TEXCOORD0;
	float3 vecWorldRay				: TEXCOORD1;
#endif
};

struct PS_OUTPUT
{
	float4 vColor_0				:	COLOR0;
};



float4 DoPointLightBasic( const int index, float3 normal,
	float3 vecWorldToLight, float lightToWorldDist,
	float3 vecWorldRayInv,
	bool litface, bool half_lambert,
	float phong_exp )
{
#if DEFCFG_CHEAP_LIGHTS
	float3 normalizedLightVec = vecWorldToLight / lightToWorldDist;
	float litDot = dot( normalizedLightVec, normal );

	float distFade = DeferredLightFalloff( lightToWorldDist, g_flMixedData[ index ].w, g_flMixedData[ index + 1 ].w );
	distFade *= DeferredLightPeak( g_flMixedData[ index + 1 ].xyz, distFade );

	return float4( 0, saturate( litDot ) * distFade, 0, 0 );
#else
	float3 normalizedLightVec = vecWorldToLight / lightToWorldDist;
	float3 flLitNormal = lerp( normal, dot( normal, normalizedLightVec ) * normal, litface );

#if DEFCFG_BLINN_PHONG
	// HL2RPM (PBR): phong_exp is the roughness of the surface (UnpackLightingControls)
	float flSpecular = SpecularGGX( normal, vecWorldRayInv, normalizedLightVec, phong_exp );
#else
	float flSpecular = dot( reflect( -normalizedLightVec, flLitNormal ), vecWorldRayInv );
	flSpecular = pow( flSpecular, phong_exp );
#endif

	float viewFwdDot = dot( normalizedLightVec, flLitNormal );
	float litDot = lerp( viewFwdDot, viewFwdDot * 0.5f + 0.5f, half_lambert );

	float lightAmount = saturate( litDot );

	// (HL2RPM: the curve of the light, or the engine's attenuation of a converted lamp - common_lighting_fxc.h)
	float distFade = DeferredLightFalloff( lightToWorldDist, g_flMixedData[ index ].w, g_flMixedData[ index + 1 ].w );
	// (its strength softly limited before the edge - DeferredLightPeak)
	distFade *= DeferredLightPeak( g_flMixedData[ index + 1 ].xyz, distFade );

	return float4( litDot, lightAmount, flSpecular, distFade );
#endif
}





PS_OUTPUT main( const PS_INPUT In )
{
	float2 vecTexcoords;
	float3 vecWorldRay;

#if USEWORLDTRANSFORM
	vecTexcoords = In.vecProjXYW.xy / In.vecProjXYW.z;
	vecWorldRay = g_vecFrustumCenter +
		vecTexcoords.x * g_vecFrustumRight +
		vecTexcoords.y * g_vecFrustumUp;
	vecTexcoords = vecTexcoords * float2( 0.5f, -0.5f ) + 0.5f;
	vecTexcoords += g_vecHalfScreenTexel;
#else
	vecTexcoords = In.vTexCoord;
	vecWorldRay = In.vecWorldRay;
#endif

	float flDepth = tex2D( sDepth, vecTexcoords ).x;

#if USEWORLDTRANSFORM
	clip( min( flDepth - 0.1f, DEPTH_RECONSTRUCTION_LIMIT - flDepth ) );
#else
	clip( min( flDepth - 0.1f, DEPTH_RECONSTRUCTION_LIMIT_FULLSCREEN - flDepth ) );
#endif

	float3 worldPos = g_vecViewOrigin + vecWorldRay * flDepth;

	float4 flNormalCtrl = tex2D( sNormals, vecTexcoords );
	float3 flNormal = normalize( flNormalCtrl.xyz * 2.0f - 1.0f );

	float phong_exp;
	bool half_lambert, litface;
#if DEFCFG_CHEAP_LIGHTS
	phong_exp = half_lambert = litface = 0;
#elif !DEFCFG_LIGHTCTRL_PACKING
	{
		float4 flLightCtrl = tex2D( sLightCtrl, vecTexcoords );
		phong_exp = flLightCtrl.x;
		half_lambert = flLightCtrl.y;
		litface = flLightCtrl.z;
	}
#else
	UnpackLightingControls( flNormalCtrl.a, phong_exp, half_lambert, litface );
#endif

	float3 worldRayInv = normalize( -vecWorldRay );

	float4 flLight = 0;

	for ( int i = 0; i < NUM_SHADOWED_COOKIE; i++ )
	{
		int iDataIndex = i * NUM_CONSTS_POINT_ADVANCED;
		int iSamplerIndex = i * 2;

		float3 vecDeltaWorld = worldPos - g_flMixedData[ iDataIndex ].xyz;
		float dist = length( vecDeltaWorld );

		float3x3 matRotation = float3x3( g_flMixedData[ iDataIndex + 3 ].xyz,
			g_flMixedData[ iDataIndex + 4 ].xyz,
			g_flMixedData[ iDataIndex + 5 ].xyz );

		float4 localLight = DoPointLightBasic( iDataIndex, flNormal,
									-vecDeltaWorld, dist, worldRayInv,
									litface, half_lambert, phong_exp );

		float3 vecDeltaRotated = mul3x3( vecDeltaWorld, matRotation );
		// HL2RPM: no light reaches the point (outside the cone or the radius, turned away): the
		// shadow filter and normal-offset shadow setup are skipped
		float flShadow = 1.0f;
		[branch]
		if ( localLight.y * localLight.w > 0.0f )
		{
			float normalDotLight = dot( -vecDeltaWorld, flNormal ) / max( dist, 1e-4f );
			float sinAngle = sqrt( saturate( 1.0f - normalDotLight * normalDotLight ) );
			float normalOffsetScale = 0.25f + 1.25f * sinAngle;
			float3 vecDeltaOffset = vecDeltaWorld + flNormal * normalOffsetScale;
			float distOffset = length( vecDeltaOffset );
			float3 vecDeltaShadow = ( g_flMixedData[ iDataIndex + 2 ].w < 0.0f )
				? mul3x3( vecDeltaOffset, matRotation ) : vecDeltaOffset;
			flShadow = PerformDualParaboloidShadow( sMixedSampler[ iSamplerIndex ],
				vecDeltaShadow, g_vecShadowMappingTweaks_0, g_vecShadowMappingTweaks_1,
				distOffset, g_flMixedData[ iDataIndex ].w, g_flMixedData[ iDataIndex + 2 ].w, normalDotLight );
		}
		localLight.y *= flShadow;

		flLight += DoLightFinalCookied( g_flMixedData[ iDataIndex + 1 ].xyz,
			g_flMixedData[ iDataIndex + 2 ].xyz,
			localLight, DoCubemapCookie( sMixedSampler[ iSamplerIndex + 1 ], vecDeltaRotated ) )
			* LightReach( g_flMixedData[ iDataIndex + 3 ].w, worldPos, flNormal, g_flMixedData[ iDataIndex ].xyz );
	}

	for ( int i = 0; i < NUM_SHADOWED; i++ )
	{
		int iDataIndex = NUM_SHADOWED_COOKIE * NUM_CONSTS_POINT_ADVANCED
			+ i * NUM_CONSTS_POINT_ADVANCED;
		int iSamplerIndex = NUM_SHADOWED_COOKIE * 2 + i;

		float3 vecDeltaWorld = worldPos - g_flMixedData[ iDataIndex ].xyz;
		float dist = length( vecDeltaWorld );

		float4 localLight = DoPointLightBasic( iDataIndex, flNormal,
									-vecDeltaWorld, dist, worldRayInv,
									litface, half_lambert, phong_exp );

		// HL2RPM: no light reaches the point (outside the cone or the radius, turned away): the
		// shadow filter and rotation/offset setup are skipped
		float flShadow = 1.0f;
		[branch]
		if ( localLight.y * localLight.w > 0.0f )
		{
			float normalDotLight = dot( -vecDeltaWorld, flNormal ) / max( dist, 1e-4f );
			float sinAngle = sqrt( saturate( 1.0f - normalDotLight * normalDotLight ) );
			float normalOffsetScale = 0.25f + 1.25f * sinAngle;
			float3 vecDeltaOffset = vecDeltaWorld + flNormal * normalOffsetScale;
			float distOffset = length( vecDeltaOffset );
			float3 vecDeltaShadow = vecDeltaOffset;
			if ( g_flMixedData[ iDataIndex + 2 ].w < 0.0f )
			{
				float3x3 matRotation = float3x3( g_flMixedData[ iDataIndex + 3 ].xyz,
					g_flMixedData[ iDataIndex + 4 ].xyz,
					g_flMixedData[ iDataIndex + 5 ].xyz );
				vecDeltaShadow = mul3x3( vecDeltaOffset, matRotation );
			}
			flShadow = PerformDualParaboloidShadow( sMixedSampler[ iSamplerIndex ],
				vecDeltaShadow, g_vecShadowMappingTweaks_0, g_vecShadowMappingTweaks_1,
				distOffset, g_flMixedData[ iDataIndex ].w, g_flMixedData[ iDataIndex + 2 ].w, normalDotLight );
		}
		localLight.y *= flShadow;

		flLight += DoLightFinal( g_flMixedData[ iDataIndex + 1 ].xyz,
			g_flMixedData[ iDataIndex + 2 ].xyz,
			localLight )
			* LightReach( g_flMixedData[ iDataIndex + 3 ].w, worldPos, flNormal, g_flMixedData[ iDataIndex ].xyz );
	}

	for ( int i = 0; i < NUM_COOKIE; i++ )
	{
		int iDataIndex = NUM_SHADOWED_COOKIE * NUM_CONSTS_POINT_ADVANCED
			+ NUM_SHADOWED * NUM_CONSTS_POINT_ADVANCED
			+ i * NUM_CONSTS_POINT_ADVANCED;
		int iSamplerIndex = NUM_SHADOWED_COOKIE * 2 + NUM_SHADOWED + i;

		float3 vecDeltaWorld = worldPos - g_flMixedData[ iDataIndex ].xyz;
		float dist = length( vecDeltaWorld );

		float3x3 matRotation = float3x3( g_flMixedData[ iDataIndex + 3 ].xyz,
			g_flMixedData[ iDataIndex + 4 ].xyz,
			g_flMixedData[ iDataIndex + 5 ].xyz );

		float4 localLight = DoPointLightBasic( iDataIndex, flNormal,
									-vecDeltaWorld, dist, worldRayInv,
									litface, half_lambert, phong_exp );

		float3 vecDeltaRotated = mul3x3( vecDeltaWorld, matRotation );

		flLight += DoLightFinalCookied( g_flMixedData[ iDataIndex + 1 ].xyz,
			g_flMixedData[ iDataIndex + 2 ].xyz,
			localLight, DoCubemapCookie( sMixedSampler[ iSamplerIndex ], vecDeltaRotated ) )
			* LightReach( g_flMixedData[ iDataIndex + 3 ].w, worldPos, flNormal, g_flMixedData[ iDataIndex ].xyz );
	}

	for ( int i = 0; i < NUM_SIMPLE; i++ )
	{
		int iDataIndex = NUM_SHADOWED_COOKIE * NUM_CONSTS_POINT_ADVANCED
			+ NUM_SHADOWED * NUM_CONSTS_POINT_ADVANCED
			+ NUM_COOKIE * NUM_CONSTS_POINT_ADVANCED
			+ i * NUM_CONSTS_POINT_SIMPLE;

		float3 vecDelta = worldPos - g_flMixedData[ iDataIndex ].xyz;
		float dist = length( vecDelta );

		float4 localLight = DoPointLightBasic( iDataIndex, flNormal,
									-vecDelta, dist, worldRayInv,
									litface, half_lambert, phong_exp );

		flLight += DoLightFinal( g_flMixedData[ iDataIndex + 1 ].xyz,
			g_flMixedData[ iDataIndex + 2 ].xyz,
			localLight )
			* LightReach( g_flMixedData[ iDataIndex + 2 ].w, worldPos, flNormal, g_flMixedData[ iDataIndex ].xyz );
	}

	PS_OUTPUT Out;

	Out.vColor_0 = WriteLighting( flLight );

	return Out;
}
