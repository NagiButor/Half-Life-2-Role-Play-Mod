@include "base.fgd"

@PointClass base(Targetname, Parentname, Angles) iconsprite("editor/light.vmt") sphere(radius) = light_deferred
[
	spawnflags(flags) =
	[
		1 	: "Enabled" : 1
		2 	: "Enable shadow" : 0
		4 	: "Enable cookie" : 0
		8 	: "Enable volumetrics" : 0
		16	: "Enable lightstyle" : 0
	]

	light_type(Choices) : "Light type" : 0 : "" =
	[
		0 : "Point"
		1 : "Spot"
	]

	diffuse(color255) : "Color diffuse" : "255 255 255 255" : ""
	ambient(color255) : "Color ambient" : "10 10 10 255" : ""

	radius(float) : "Radius" : "256.0" : ""
	power(float) : "Falloff power" : "2.0" : ""

	spot_cone_inner(float) : "Spotlight cone inner" : "35.0" : ""
	spot_cone_outer(float) : "Spotlight cone outer" : "45.0" : ""

	vis_dist(integer) : "Visible distance" : 2048 : ""
	vis_range(integer) : "Visible fade range" : 512 : ""
	shadow_dist(integer) : "Shadow distance" : 1536 : ""
	shadow_range(integer) : "Shadow fade range" : 512 : ""
	//Pravka: a light without a shadow shines through walls - shadows unless switched off here
	autoshadow(choices) : "Automatic shadow" : 1 : "Cast a shadow even when 'Enable shadow' is not set (a light without a shadow shines through walls). No = a cheap fill light without a shadow. Also sv_deferred_light_autoshadow." =
	[
		0 : "No"
		1 : "Yes"
	]

	cookietex(string) : "Cookie texture" : : "Path to vtf or vgui projectable factory name."

	style_seed(integer) : "Lightstyle seed" : -1 : ""
	style_amt(float) : "Lightstyle amount" : "0.5" : ""
	style_speed(float) : "Lightstyle speed" : "0.3" : ""
	style_smooth(float) : "Lightstyle smoothing" : "0.5" : ""
	style_random(float) : "Lightstyle random" : "0.5" : ""

	enable_from_hour(float) : "Enable from (hour)" : -1 : "If set, the light is only enabled between enable_from_hour and enable_to_hour. Uses env_timecycle time. Example night: 20 -> 6."
	enable_to_hour(float) : "Enable to (hour)" : -1 : "See enable_from_hour."
	time_toggle_shadows(choices) : "Toggle shadows with time" : 1 : "If enabled, shadows will also toggle on/off with the time window." =
	[
		0 : "No"
		1 : "Yes"
	]
	time_toggle_volumetrics(choices) : "Toggle volumetrics with time" : 1 : "If enabled, volumetrics will also toggle on/off with the time window." =
	[
		0 : "No"
		1 : "Yes"
	]
	//Pravka: switched like the classic light entities (converted lamps keep their I/O)
	input TurnOn(void) : "Turn the light on."
	input TurnOff(void) : "Turn the light off."
	input Toggle(void) : "Toggle the light."
]

@PointClass base(Targetname, Parentname, Angles) iconsprite("editor/light.vmt") lightprop("models/editor/spot.mdl") lightcone() sphere(radius) = light_deferred_spot
[
	spawnflags(flags) =
	[
		1 	: "Enabled" : 1
		2 	: "Enable shadow" : 0
		4 	: "Enable cookie" : 0
		8 	: "Enable volumetrics" : 0
		16	: "Enable lightstyle" : 0
	]

	light_type(Choices) : "Light type" : 1 : "" =
	[
		0 : "Point"
		1 : "Spot"
	]

	diffuse(color255) : "Color diffuse" : "255 255 255 255" : ""
	ambient(color255) : "Color ambient" : "10 10 10 255" : ""

	radius(float) : "Radius" : "256.0" : ""
	power(float) : "Falloff power" : "2.0" : ""

	spot_cone_inner(float) : "Spotlight cone inner" : "35.0" : ""
	spot_cone_outer(float) : "Spotlight cone outer" : "45.0" : ""

	vis_dist(integer) : "Visible distance" : 2048 : ""
	vis_range(integer) : "Visible fade range" : 512 : ""
	shadow_dist(integer) : "Shadow distance" : 1536 : ""
	shadow_range(integer) : "Shadow fade range" : 512 : ""
	//Pravka: a light without a shadow shines through walls - shadows unless switched off here
	autoshadow(choices) : "Automatic shadow" : 1 : "Cast a shadow even when 'Enable shadow' is not set (a light without a shadow shines through walls). No = a cheap fill light without a shadow. Also sv_deferred_light_autoshadow." =
	[
		0 : "No"
		1 : "Yes"
	]

	cookietex(string) : "Cookie texture" : : "Path to vtf or vgui projectable factory name."

	style_seed(integer) : "Lightstyle seed" : -1 : ""
	style_amt(float) : "Lightstyle amount" : "0.5" : ""
	style_speed(float) : "Lightstyle speed" : "0.3" : ""
	style_smooth(float) : "Lightstyle smoothing" : "0.5" : ""
	style_random(float) : "Lightstyle random" : "0.5" : ""

	enable_from_hour(float) : "Enable from (hour)" : -1 : "If set, the light is only enabled between enable_from_hour and enable_to_hour. Uses env_timecycle time. Example night: 20 -> 6."
	enable_to_hour(float) : "Enable to (hour)" : -1 : "See enable_from_hour."
	time_toggle_shadows(choices) : "Toggle shadows with time" : 1 : "If enabled, shadows will also toggle on/off with the time window." =
	[
		0 : "No"
		1 : "Yes"
	]
	time_toggle_volumetrics(choices) : "Toggle volumetrics with time" : 1 : "If enabled, volumetrics will also toggle on/off with the time window." =
	[
		0 : "No"
		1 : "Yes"
	]
	//Pravka: switched like the classic light entities (converted lamps keep their I/O)
	input TurnOn(void) : "Turn the light on."
	input TurnOff(void) : "Turn the light off."
	input Toggle(void) : "Toggle the light."
]

@PointClass base(Targetname, Angles) iconsprite("editor/light_env.vmt") = light_deferred_global
[
	spawnflags(flags) =
	[
		1 	: "Enabled" : 1
		2 	: "Enable shadow" : 1
		4 	: "Enable transitions" : 1
	]
	diffuse(color255) : "Color diffuse" : "255 255 255 255" : ""
	ambient_high(color255) : "Color ambient high" : "20 40 80 255" : ""
	ambient_low(color255) : "Color ambient low" : "40 20 10 255" : ""

	fadetime(float) : "Fade interval time" : "1.0" : ""
]

@PointClass base(Targetname) iconsprite("editor/logic_script.vmt") = env_timecycle
[
	start_time(float) : "Start time (hours)" : "12.0" : ""
	//Pravka: sv_timecycle_speed_scale (0.1) multiplies it - the old text was wrong (it was a 14.4 minute day)
	time_scale(float) : "Time scale multiplier" : "10.0" : "Real length of a day = day_length_seconds / (time_scale * sv_timecycle_speed_scale). With the defaults (8640, 10, 0.1) a day lasts 2.4 hours."
	day_length_seconds(float) : "Day length (seconds)" : "8640.0" : ""

	sunrise_hour(float) : "Sunrise hour" : "6.0" : ""
	sunset_hour(float) : "Sunset hour" : "18.0" : ""
	max_altitude(float) : "Max sun altitude (deg)" : "60.0" : ""
	azimuth_offset(float) : "Azimuth offset (deg)" : "0.0" : ""
	twilight_hours(float) : "Twilight duration (hours)" : "1.25" : ""
	night_altitude(float) : "Night sun altitude (deg)" : "-12.0" : ""
]

//Pravka: HL2RPM dynamic weather
@PointClass base(Targetname) iconsprite("editor/fog_controller.vmt") = env_weather : "HL2RPM dynamic weather: volumetric clouds, rain, fog, wet surfaces and lightning. Created automatically on maps with light_deferred_global; place one to choose the start weather or to control it with inputs."
[
	start_weather(choices) : "Start weather" : -1 : "Weather when the map starts." =
	[
		-1 : "Random (calm)"
		0 : "Clear"
		1 : "Fair"
		2 : "Partly cloudy"
		3 : "Overcast"
		4 : "Fog"
		5 : "Drizzle"
		6 : "Rain"
		7 : "Thunderstorm"
		8 : "Misty"
		9 : "Snowfall"		//Pravka
		10 : "Falling ash"	//Pravka
		11 : "Cumulus (towers in the afternoon)"	//Pravka
		12 : "Broken clouds (stratocumulus)"	//Pravka
		13 : "High clouds (cirrus, altocumulus)"	//Pravka
	]
	auto_weather(choices) : "Automatic weather changes" : 1 : "The weather changes by itself over time (plausible sequences, fog in the morning, storms in the afternoon)." =
	[
		0 : "No"
		1 : "Yes"
	]
	duration_scale(float) : "Weather duration scale" : "1.0" : "Multiplier for how long each automatic weather lasts."

	input SetWeather(string) : "Blend to a weather: clear, fair, partlycloudy, overcast, fog, drizzle, rain, thunderstorm, misty, snow, ash, cumulus, stratocumulus, highclouds. Optional transition time in seconds after the name, e.g. 'rain 30'. Snow and ash are never chosen by the automatic weather."
	input SetWeatherInstant(string) : "Switch to a weather immediately (same names as SetWeather)."
	input EnableAuto(void) : "Enable automatic weather changes."
	input DisableAuto(void) : "Disable automatic weather changes."
]
