"Water"
{
	// HL2RPM: the sea: deep teal, clear near the shore
	"%compilewater" 1
	"%tooltexture" "nature/water_frame01_normal"
	"$abovewater" 1
	"$forceexpensive" 1
	"$envmap" "env_cubemap"
	"$refracttexture" "_rt_WaterRefraction"
	"$refractamount" "1"
	"$reflecttexture" "_rt_WaterReflection"
	"$reflectentities" 1
	"$reflectamount" "1"
	"$scale" "[1 1]"
	"$bumpmap" "dev/water_dudv"
	"$normalmap" "dev/water_normal"
	"$surfaceprop" "water"
	"$bottommaterial" "nature/water_coast01_beneath"
	"$bumpframe" "0"
	"$fogenable" 1
	"$fogcolor" "{18 46 54}"
	"$fogstart" "40"
	"$fogend" "450"
	// the kind of water (stdshaders/water.cpp): how much faster than the average each color fades
	// on the way through it (rgb), its density (w); its own color's glow
	"$water_absorb" "[2.4 1.1 0.8 1.0]"
	"$water_glow" "0"

	"Proxies"
	{
		"AnimatedTexture"
		{
			"animatedtexturevar" "$normalmap"
			"animatedtextureframenumvar" "$bumpframe"
			"animatedtextureframerate" 30.00
		}
		"TextureScroll"
		{
			"texturescrollvar" "$bumptransform"
			"texturescrollrate" .03
			"texturescrollangle" 45.00
		}
		"WaterLOD"
		{
		}
	}
}
