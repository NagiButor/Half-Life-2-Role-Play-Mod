
// STATIC:		"USEWORLDTRANSFORM"			"0..1"

// DYNAMIC:		"NUM_SHADOWED_COOKIE"		"0..2"
// DYNAMIC:		"NUM_SHADOWED"				"0..3"
// DYNAMIC:		"NUM_COOKIE"				"0..3"
// DYNAMIC:		"NUM_SIMPLE"				"0..10"

// SKIP:		!$NUM_SHADOWED_COOKIE && !$NUM_SHADOWED && !$NUM_COOKIE && !$NUM_SIMPLE

// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED_COOKIE && $NUM_SHADOWED
// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED_COOKIE && $NUM_COOKIE
// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED_COOKIE && $NUM_SIMPLE
// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED && $NUM_COOKIE
// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED && $NUM_SIMPLE
// SKIP:		$USEWORLDTRANSFORM && $NUM_COOKIE && $NUM_SIMPLE

// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED_COOKIE > 1
// SKIP:		$USEWORLDTRANSFORM && $NUM_SHADOWED > 1
// SKIP:		$USEWORLDTRANSFORM && $NUM_COOKIE > 1
// SKIP:		$USEWORLDTRANSFORM && $NUM_SIMPLE > 1

#include "common_ps_fxc.h"
#include "common_deferred_fxc.h"

/*

	Spot lights:

	position			x y z	radius			w
	color diffuse		x y z	falloffpower	w
	color ambient		x y z	cone outer		w
	backward			x y z	cone inner		w

	** shadowed or cookied **
	shadowscale			x

	world2texture		x y z w
						x y z w
						x y z w
						x y z w

*/


sampler sNormals							: register( s0 );
sampler sDepth								: register( s1 );
#if !DEFCFG_LIGHTCTRL_PACKING
sampler sLightCtrl							: register( s2 );
#endif

const float3 g_vecViewOrigin				: register( c0 );
const float4 g_vecShadowMappingTweaks_0		: register( c1 );
const float4 g_vecShadowMappingTweaks_1		: register( c2 );

// Debug bias visualisation flag (c7.x):
//  0 = normal rendering
//  1 = greyscale total bias magnitude
//  2 = RGB bias components (R=constant, G=slope, B=rpdb)
const float4 g_vecSpotBiasDebug				: register( c7 );

#if USEWORLDTRANSFORM
const float3 g_vecFrustumCenter		: register( c3 );
const float3 g_vecFrustumRight		: register( c4 );
const float3 g_vecFrustumUp			: register( c5 );
const float2 g_vecHalfScreenTexel		: register( c6 );
#endif

sampler sMixedSampler[FREE_LIGHT_SAMPLERS]			: register( FIRST_LIGHT_SAMPLER_FXC );
const float4 g_flMixedData[120]						: register( FIRST_SHARED_LIGHTDATA_CONSTANT_FXC ); // MAX_LIGHTDATA_CONSTANT_ROWS


struct PS_INPUT
{
#if USEWORLDTRANSFORM
	float3 vecProjXYW				: TEXCOORD0;
#else
	float2 vTexCoord				: TEXCOORD0;
	float3 vecWorldRay				: TEXCOORD1;
#endif
};

struct PS_OUTPUT
{
	float4 vColor_0				:	COLOR0;
};

float SpotReceiverPlaneDepthBias( float3 shadowProj )
{
	float2 dUVdx = ddx( shadowProj.xy );
	float2 dUVdy = ddy( shadowProj.xy );
	float  dZdx  = ddx( shadowProj.z );
	float  dZdy  = ddy( shadowProj.z );

	float det    = dUVdx.x * dUVdy.y - dUVdx.y * dUVdy.x;
	float absDet = abs( det );

	float bias = 0.0f;
	if ( absDet > 1e-7f )
	{
		float invDet = 1.0f / det;
		float2 dZduv = float2(
			dZdx * dUVdy.y - dZdy * dUVdx.y,
			dZdy * dUVdx.x - dZdx * dUVdy.x ) * invDet;

		float rawBias = ( abs( dZduv.x ) + abs( dZduv.y ) ) * g_vecShadowMappingTweaks_0.z;

		// Smoothly fade RPDB when the screen-space Jacobian determinant is
		// very small (camera close to surface).  The 1/det amplifies FP
		// noise in that regime, creating per-pixel bias fluctuations that
		// manifest as shadow-acne stripes.  Fading prevents the binary
		// RPDB on/off pattern at the old hard 1e-7 threshold.
		float rpdbConfidence = smoothstep( 1e-6f, 1e-4f, absDet );
		bias = rawBias * rpdbConfidence;
	}

	return bias;
}

float ApplySpotReceiverDepthBias( float shadowDepth, float viewFwdDot, float viewZ, float3 shadowProj, float4 spotBias )
{
	viewZ = max( viewZ, spotBias.z );

	float oneTexelDepth = spotBias.x / max( viewZ, 0.001f );

	float cosA = max( abs( viewFwdDot ), 0.01f );
	float tanA = sqrt( 1.0f - cosA * cosA ) / cosA;
	tanA = min( tanA, 10.0f );

	// Constant raised from 0.5 to 0.75 texels (Reduced to 0.1 for Bias Free fwidth mapping)
	// The extra quarter-texel covers the perspective depth margin that linear (CSM) does not need.
	// Close-range stabiliser: +0.25 * cosA adds another quarter-texel on
	// face-on surfaces (where normal-offset is near-zero and the constant
	// bias is the only defence).  At grazing angles the slope term already
	// dominates, so the stabiliser tapers to near-zero via cosA weighting.
	// Update V3: Increased base to 0.25 and reduced slope to 0.2 to match Point Light fix
	float biasTexels = 0.25f + cosA * 0.1f + 0.2f * tanA;

	float rpdbDepth = SpotReceiverPlaneDepthBias( shadowProj );
	float rpdbTexels = rpdbDepth / max( oneTexelDepth, 1e-7f );
	biasTexels = max( biasTexels, rpdbTexels );
	biasTexels = min( biasTexels, 6.0f ); // Reduced from 12.0f

	return shadowDepth - oneTexelDepth * biasTexels;
}

// Debug variant: also outputs per-component bias info for visualisation
float ApplySpotReceiverDepthBias_Debug( float shadowDepth, float viewFwdDot, float viewZ, float3 shadowProj, float4 spotBias,
	out float3 dbgComponents )  // R=constant, G=slope, B=rpdb  (in texels, /12 normalised)
{
	viewZ = max( viewZ, spotBias.z );
	float oneTexelDepth = spotBias.x / max( viewZ, 0.001f );

	float cosA = max( abs( viewFwdDot ), 0.01f );
	float tanA = sqrt( 1.0f - cosA * cosA ) / cosA;
	tanA = min( tanA, 10.0f );

	float constTerm = 0.75f + cosA * 0.25f;
	float slopeTerm = 3.0f * tanA;
	float biasTexels = constTerm + slopeTerm;

	float rpdbDepth  = SpotReceiverPlaneDepthBias( shadowProj );
	float rpdbTexels = rpdbDepth / max( oneTexelDepth, 1e-7f );
	float rpdbUsed   = max( rpdbTexels - biasTexels, 0.0f );  // extra from rpdb
	biasTexels = max( biasTexels, rpdbTexels );
	biasTexels = min( biasTexels, 12.0f );

	dbgComponents = float3( constTerm, slopeTerm, rpdbUsed ) / 12.0f;

	return shadowDepth - oneTexelDepth * biasTexels;
}

float3 ToShadowSpace_Spot( float3 worldPos, float viewFwdDot, float3 vecNormal, float4 spotBias, float4x4 spotWorldToTexture, out float outViewZ )
{
	float4 clip0 = mul( float4( worldPos, 1 ), spotWorldToTexture );
	float viewZ = max( clip0.w, spotBias.z );

	float cosAngle = abs( viewFwdDot );
	float sinAngle = sqrt( saturate( 1.0f - cosAngle * cosAngle ) );
	worldPos += vecNormal * ( sinAngle * ( viewZ * spotBias.y ) );

	float4 clip = mul( float4( worldPos, 1 ), spotWorldToTexture );
	outViewZ = max( clip.w, spotBias.z );
	clip.xyz /= clip.w;
	return clip.xyz;
}


float4 DoSpotLightBasic( const int index, float3 normal,
	float3 vecWorldToLight, float lightToWorldDist,
	float3 vecWorldRayInv,
	bool litface, bool half_lambert,
	float phong_exp, const bool bDoSpotAttn )
{
#if DEFCFG_CHEAP_LIGHTS
	float3 normalizedLightVec = vecWorldToLight / lightToWorldDist;
	float litDot = dot( normalizedLightVec, normal );

	float fade = 1.0f - saturate( lightToWorldDist / g_flMixedData[ index ].w );
	fade *= fade;

	if ( bDoSpotAttn )
	{
		float spotDot = dot( g_flMixedData[ index + 3 ].xyz, normalizedLightVec );
		fade *= smoothstep( g_flMixedData[ index + 2 ].w, g_flMixedData[ index + 3 ].w, spotDot );
	}

	return float4( 0, saturate( litDot ) * fade, 0, 0 );
#else
	float3 normalizedLightVec = vecWorldToLight / lightToWorldDist;
	float3 flLitNormal = lerp( normal, dot( normal, normalizedLightVec ) * normal, litface );

#if DEFCFG_BLINN_PHONG
	float flSpecular = saturate( dot( normalize( vecWorldRayInv + normalizedLightVec ), flLitNormal ) );
	flSpecular = pow( flSpecular, phong_exp ) * dot( vecWorldRayInv, flLitNormal );
#else
	float flSpecular = dot( reflect( -normalizedLightVec, flLitNormal ), vecWorldRayInv );
	flSpecular = pow( flSpecular, phong_exp );
#endif

	float viewFwdDot = dot( normalizedLightVec, flLitNormal );
	float litDot = lerp( viewFwdDot, viewFwdDot * 0.5f + 0.5f, half_lambert );

	float lightAmount = saturate( litDot );

	float fade = 1.0f - saturate( lightToWorldDist / g_flMixedData[ index ].w );
	fade = pow( fade, g_flMixedData[ index + 1 ].w );

	if ( bDoSpotAttn )
	{
		float spotDot = dot( g_flMixedData[ index + 3 ].xyz, normalizedLightVec );
		fade *= smoothstep( g_flMixedData[ index + 2 ].w, g_flMixedData[ index + 3 ].w, spotDot );
	}

	return float4( litDot, lightAmount, flSpecular, fade );
#endif
}



PS_OUTPUT main( const PS_INPUT In )
{
	float2 vecTexcoords;
	float3 vecWorldRay;

#if USEWORLDTRANSFORM
	vecTexcoords = In.vecProjXYW.xy / In.vecProjXYW.z;
	vecWorldRay = g_vecFrustumCenter +
		vecTexcoords.x * g_vecFrustumRight +
		vecTexcoords.y * g_vecFrustumUp;
	vecTexcoords = vecTexcoords * float2( 0.5f, -0.5f ) + 0.5f;
	vecTexcoords += g_vecHalfScreenTexel;
#else
	vecTexcoords = In.vTexCoord;
	vecWorldRay = In.vecWorldRay;
#endif

	float flDepth = tex2D( sDepth, vecTexcoords ).x;

#if USEWORLDTRANSFORM
	clip( min( flDepth - 0.1f, DEPTH_RECONSTRUCTION_LIMIT - flDepth ) );
#else
	clip( min( flDepth - 0.1f, DEPTH_RECONSTRUCTION_LIMIT_FULLSCREEN - flDepth ) );
#endif

	float3 worldPos = g_vecViewOrigin + vecWorldRay * flDepth;

	float4 flNormalCtrl = tex2D( sNormals, vecTexcoords );
	float3 flNormal = normalize( flNormalCtrl.xyz * 2.0f - 1.0f );

	float phong_exp;
	bool half_lambert, litface;
#if DEFCFG_CHEAP_LIGHTS
	phong_exp = half_lambert = litface = 0;
#elif !DEFCFG_LIGHTCTRL_PACKING
	{
		float4 flLightCtrl = tex2D( sLightCtrl, vecTexcoords );
		phong_exp = flLightCtrl.x;
		half_lambert = flLightCtrl.y;
		litface = flLightCtrl.z;
	}
#else
	UnpackLightingControls( flNormalCtrl.a, phong_exp, half_lambert, litface );
#endif

	float3 worldRayInv = -vecWorldRay;
#if DEFCFG_BLINN_PHONG == 0
		worldRayInv = normalize( worldRayInv );
#endif

	float4 flLight = 0;
	float3 dbgBiasComponents = 0;  // for debug visualisation (first shadowed light only)
	float  dbgBiasTotal = 0;

	for ( int i = 0; i < NUM_SHADOWED_COOKIE; i++ )
	{
		int iDataIndex = i * NUM_CONSTS_SPOT_ADVANCED;
		int iSamplerIndex = i * 2;

		float3 vecDelta = worldPos - g_flMixedData[ iDataIndex ].xyz;
		float dist = length( vecDelta );

		float4x4 spotWorldToTexture = float4x4( g_flMixedData[ iDataIndex + 5 ],
			g_flMixedData[ iDataIndex + 6 ],
			g_flMixedData[ iDataIndex + 7 ],
			g_flMixedData[ iDataIndex + 8 ] );

		float3 normalizedLightVec = (-vecDelta) / dist;
		float viewFwdDot = abs( dot( normalizedLightVec, flNormal ) );
		float4 spotBias = g_flMixedData[ iDataIndex + 9 ];

		// Normal Offset Bias for Spot Light
		float cosAngle = abs( dot( normalizedLightVec, flNormal ) );
		float sinAngle = sqrt( saturate( 1.0f - cosAngle * cosAngle ) );
		// Multiply by 2.0 texels approx
		float3 vecDeltaOffset = vecDelta + flNormal * ( sinAngle * 2.0f );

		float spotViewZ;
		float3 depthPos = ToShadowSpace_Spot( worldPos + (vecDeltaOffset - vecDelta), viewFwdDot, flNormal, spotBias, spotWorldToTexture, spotViewZ );
		float depthBiased = ApplySpotReceiverDepthBias( depthPos.z, viewFwdDot, spotViewZ, depthPos, spotBias );

		float4 localLight = DoSpotLightBasic( iDataIndex, flNormal,
									-vecDelta, dist, worldRayInv,
									litface, half_lambert, phong_exp, false );

		localLight.y *= PerformProjectedShadow( sMixedSampler[ iSamplerIndex ],
			float3( depthPos.xy, depthBiased ), g_vecShadowMappingTweaks_0, g_vecShadowMappingTweaks_1,
			g_flMixedData[ iDataIndex + 4 ].x );

#if VENDOR == VENDOR_FXC_AMD
		float3 AMDVec = abs( floor( depthPos.xyz ) );
		float AMDAmt = AMDVec.x + AMDVec.y + AMDVec.z;
		int AMDScale = step( AMDAmt, 0.0001f );
		localLight.w *= AMDScale;
#else
		localLight.w *= 1.0f - any( floor( depthPos.xyz ) );
#endif

		flLight += DoLightFinalCookied( g_flMixedData[ iDataIndex + 1 ].xyz,
			g_flMixedData[ iDataIndex + 2 ].xyz,
			localLight, DoStandardCookie( sMixedSampler[ iSamplerIndex + 1 ], depthPos.xy ) );
	}

	for ( int i = 0; i < NUM_SHADOWED; i++ )
	{
		int iDataIndex = NUM_SHADOWED_COOKIE * NUM_CONSTS_SPOT_ADVANCED
			+ i * NUM_CONSTS_SPOT_ADVANCED;
		int iSamplerIndex = NUM_SHADOWED_COOKIE * 2 + i;

		float3 vecDelta = worldPos - g_flMixedData[ iDataIndex ].xyz;
		float dist = length( vecDelta );

		float4x4 spotWorldToTexture = float4x4( g_flMixedData[ iDataIndex + 5 ],
			g_flMixedData[ iDataIndex + 6 ],
			g_flMixedData[ iDataIndex + 7 ],
			g_flMixedData[ iDataIndex + 8 ] );

		float3 normalizedLightVec = (-vecDelta) / dist;
		float viewFwdDot = abs( dot( normalizedLightVec, flNormal ) );
		float4 spotBias = g_flMixedData[ iDataIndex + 9 ];

		// Normal Offset Bias for Spot Light
		float cosAngle = abs( dot( normalizedLightVec, flNormal ) );
		float sinAngle = sqrt( saturate( 1.0f - cosAngle * cosAngle ) );
		float3 vecDeltaOffset = vecDelta + flNormal * ( sinAngle * 2.0f );

		float spotViewZ;
		float3 depthPos = ToShadowSpace_Spot( worldPos + (vecDeltaOffset - vecDelta), viewFwdDot, flNormal, spotBias, spotWorldToTexture, spotViewZ );

		float depthBiased;
		if ( i == 0 && g_vecSpotBiasDebug.x > 0.5f )
		{
			float3 dbgComp;
			depthBiased = ApplySpotReceiverDepthBias_Debug( depthPos.z, viewFwdDot, spotViewZ, depthPos, spotBias, dbgComp );
			dbgBiasComponents = dbgComp;
			dbgBiasTotal = ( depthPos.z - depthBiased ) / max( spotBias.x / max( spotViewZ, 0.001f ), 1e-7f ) / 12.0f;
		}
		else
		{
			depthBiased = ApplySpotReceiverDepthBias( depthPos.z, viewFwdDot, spotViewZ, depthPos, spotBias );
		}

		float4 localLight = DoSpotLightBasic( iDataIndex, flNormal,
									-vecDelta, dist, worldRayInv,
									litface, half_lambert, phong_exp, true );

		localLight.y *= PerformProjectedShadow( sMixedSampler[ iSamplerIndex ],
			float3( depthPos.xy, depthBiased ), g_vecShadowMappingTweaks_0, g_vecShadowMappingTweaks_1,
			g_flMixedData[ iDataIndex + 4 ].x );

		flLight += DoLightFinal( g_flMixedData[ iDataIndex + 1 ].xyz,
			g_flMixedData[ iDataIndex + 2 ].xyz,
			localLight );
	}

	for ( int i = 0; i < NUM_COOKIE; i++ )
	{
		int iDataIndex = NUM_SHADOWED_COOKIE * NUM_CONSTS_SPOT_ADVANCED
			+ NUM_SHADOWED * NUM_CONSTS_SPOT_ADVANCED
			+ i * NUM_CONSTS_SPOT_ADVANCED;
		int iSamplerIndex = NUM_SHADOWED_COOKIE * 2 + NUM_SHADOWED + i;

		float3 vecDelta = worldPos - g_flMixedData[ iDataIndex ].xyz;
		float dist = length( vecDelta );

		float4x4 spotWorldToTexture = float4x4( g_flMixedData[ iDataIndex + 5 ],
			g_flMixedData[ iDataIndex + 6 ],
			g_flMixedData[ iDataIndex + 7 ],
			g_flMixedData[ iDataIndex + 8 ] );

		float4 depthPos = mul( float4( worldPos, 1 ), spotWorldToTexture );
		depthPos.xyz /= depthPos.w;

		float4 localLight = DoSpotLightBasic( iDataIndex, flNormal,
									-vecDelta, dist, worldRayInv,
									litface, half_lambert, phong_exp, false );

#if VENDOR == VENDOR_FXC_AMD
		float3 AMDVec = abs( floor( depthPos.xyz ) );
		float AMDAmt = AMDVec.x + AMDVec.y + AMDVec.z;
		int AMDScale = step( AMDAmt, 0.0001f );
		localLight.w *= AMDScale;
#else
		localLight.w *= 1.0f - any( floor( depthPos.xyz ) );
#endif

		flLight += DoLightFinalCookied( g_flMixedData[ iDataIndex + 1 ].xyz,
			g_flMixedData[ iDataIndex + 2 ].xyz,
			localLight, DoStandardCookie( sMixedSampler[ iSamplerIndex ], depthPos.xy ) );
	}

	for ( int i = 0; i < NUM_SIMPLE; i++ )
	{
		int iDataIndex = NUM_SHADOWED_COOKIE * NUM_CONSTS_SPOT_ADVANCED
			+ NUM_SHADOWED * NUM_CONSTS_SPOT_ADVANCED
			+ NUM_COOKIE * NUM_CONSTS_SPOT_ADVANCED
			+ i * NUM_CONSTS_SPOT_SIMPLE;

		float3 vecDelta = worldPos - g_flMixedData[ iDataIndex ].xyz;
		float dist = length( vecDelta );

		float4 localLight = DoSpotLightBasic( iDataIndex, flNormal,
									-vecDelta, dist, worldRayInv,
									litface, half_lambert, phong_exp, true );

		flLight += DoLightFinal( g_flMixedData[ iDataIndex + 1 ].xyz,
			g_flMixedData[ iDataIndex + 2 ].xyz,
			localLight );
	}

	PS_OUTPUT Out;

	// Debug bias visualisation (def_spot_shadow_debug cvar)
	if ( g_vecSpotBiasDebug.x > 1.5f )
	{
		// Mode 2: per-component  R=constant  G=slope  B=rpdb
		Out.vColor_0 = float4( dbgBiasComponents, 1 );
		return Out;
	}
	else if ( g_vecSpotBiasDebug.x > 0.5f )
	{
		// Mode 1: greyscale total bias (texels / 12)
		Out.vColor_0 = float4( dbgBiasTotal.xxx, 1 );
		return Out;
	}

	Out.vColor_0 = WriteLighting( flLight );

	return Out;
}
