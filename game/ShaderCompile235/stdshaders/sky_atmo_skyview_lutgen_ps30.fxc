
#include "common_ps_fxc.h"

const float3 g_vecSunDir : register( c1 );
const float3 g_light_diffuse : register( c16 );

sampler2D sTransmittanceLut : register( s0 );
sampler2D sMultiScatteringLut : register( s1 );

struct PS_INPUT
{
	float2 vTexCoord : TEXCOORD0;
};

struct PS_OUTPUT
{
	float4 vColor_0 : COLOR0;
};

static const float PI = 3.14159265358;

static const float groundRadiusMM = 6.360;
static const float atmosphereRadiusMM = 6.460;
static const float3 viewPos = float3( 0.0, 0.0, groundRadiusMM + 0.0002 );

static const float3 rayleighScatteringBase = float3( 5.802, 13.558, 33.1 );
static const float rayleighAbsorptionBase = 0.0;

static const float mieScatteringBase = 3.996;
static const float mieAbsorptionBase = 4.4;

static const float3 ozoneAbsorptionBase = float3( 0.650, 1.881, 0.085 );

float rayIntersectSphere( float3 ro, float3 rd, float rad )
{
	float b = dot( ro, rd );
	float c = dot( ro, ro ) - rad * rad;
	if ( c > 0.0 && b > 0.0 )
		return -1.0;
	float discr = b * b - c;
	if ( discr < 0.0 )
		return -1.0;
	float s = sqrt( discr );
	if ( discr > b * b )
		return ( -b + s );
	return ( -b - s );
}

float getMiePhase( float cosTheta )
{
	const float g = 0.8;
	const float scale = 3.0 / ( 8.0 * PI );

	float num = ( 1.0 - g * g ) * ( 1.0 + cosTheta * cosTheta );
	float denom = ( 2.0 + g * g ) * pow( max( 1.0 + g * g - 2.0 * g * cosTheta, 1e-4 ), 1.5 );

	return scale * num / max( denom, 1e-4 );
}

float getRayleighPhase( float cosTheta )
{
	return 3.0 / ( 16.0 * PI ) * ( 1.0 + cosTheta * cosTheta );
}

void getScatteringValues( float3 pos, out float3 rayleighScattering, out float mieScattering, out float3 extinction )
{
	float height = length( pos ) - groundRadiusMM;

	float rayleighDensity = exp( -height / 0.08 );
	float mieDensity = exp( -height / 0.012 );

	float3 ozoneAbsorption = ozoneAbsorptionBase * saturate( ( height - 0.015 ) / 0.03 ) * saturate( ( 0.12 - height ) / 0.03 );

	rayleighScattering = rayleighScatteringBase * rayleighDensity;
	float3 rayleighAbsorption = rayleighAbsorptionBase * rayleighDensity;

	mieScattering = mieScatteringBase * mieDensity;
	float3 mieAbsorption = mieAbsorptionBase * mieDensity;

	extinction = rayleighScattering + rayleighAbsorption + mieScattering + mieAbsorption + ozoneAbsorption;
}

float3 getSunTransmittance( float3 pos, float3 sunDir )
{
	if ( rayIntersectSphere( pos, sunDir, groundRadiusMM ) > 0.0 )
		return 0.0.xxx;

	float r = clamp( length( pos ), groundRadiusMM, atmosphereRadiusMM );
	float mu = dot( normalize( pos ), sunDir );
	mu = clamp( mu, -1.0, 1.0 );

	float u = ( mu * 0.5 + 0.5 );
	float v = ( r - groundRadiusMM ) / ( atmosphereRadiusMM - groundRadiusMM );
	return tex2D( sTransmittanceLut, float2( u, v ) ).rgb;
}

float3 raymarchScattering( float3 pos, float3 rayDir, float3 sunDir, float tMax )
{
	if ( tMax <= 0.0 )
		return 0.0.xxx;

	const int STEPS = 8;
	float dt = tMax / (float)STEPS;

	float3 transmittance = 1.0.xxx;
	float3 lum = 0.0.xxx;

	float cosTheta = dot( rayDir, sunDir );
	float rayleighPhaseValue = getRayleighPhase( cosTheta );
	float miePhaseValue = getMiePhase( cosTheta );

	for ( int i = 0; i < STEPS; i++ )
	{
		float t = ( (float)i + 0.5 ) * dt;
		float3 newPos = pos + rayDir * t;

		float3 rayleighScattering, extinction;
		float mieScattering;
		getScatteringValues( newPos, rayleighScattering, mieScattering, extinction );

		float3 sunTransmittance = getSunTransmittance( newPos, sunDir );

		float3 rayleighInScattering = rayleighScattering * ( rayleighPhaseValue * sunTransmittance );
		float3 mieInScattering = mieScattering * ( miePhaseValue * sunTransmittance );
		float3 inScattering = ( rayleighInScattering + mieInScattering );

		float height01 = saturate( ( length( newPos ) - groundRadiusMM ) / ( atmosphereRadiusMM - groundRadiusMM ) );
		float muS = dot( normalize( newPos ), sunDir );
		float3 ms = tex2D( sMultiScatteringLut, float2( muS * 0.5 + 0.5, height01 ) ).rgb;
		inScattering *= ( 1.0.xxx + ms );

		float3 sampleTransmittance = exp( -extinction * dt );
		float3 scatteringIntegral = ( inScattering - inScattering * sampleTransmittance ) / max( extinction, 1e-4.xxx );
		lum += transmittance * scatteringIntegral;

		transmittance *= sampleTransmittance;
	}

	return lum;
}

float3 DirFromSkyViewUV( float2 uv, float3 sunDir )
{
	float mu = lerp( -1.0, 1.0, uv.y );
	float sinTheta = sqrt( saturate( 1.0 - mu * mu ) );

	float cosGamma = lerp( -1.0, 1.0, uv.x );
	float sinGamma = sqrt( saturate( 1.0 - cosGamma * cosGamma ) );

	float3 up = float3( 0.0, 0.0, 1.0 );
	float3 t0 = normalize( cross( up, sunDir ) );
	float3 t1 = cross( sunDir, t0 );

	float3 dirInSunFrame = float3( sinTheta * sinGamma, sinTheta * cosGamma, mu );
	float3 dir = t0 * dirInSunFrame.x + t1 * dirInSunFrame.y + sunDir * dirInSunFrame.z;
	return normalize( dir );
}

PS_OUTPUT main( const PS_INPUT In )
{
	float2 uv = In.vTexCoord;

	float3 sunDir = normalize( g_vecSunDir );
	float3 rayDir = DirFromSkyViewUV( uv, sunDir );

	float atmoDist = rayIntersectSphere( viewPos, rayDir, atmosphereRadiusMM );
	float groundDist = rayIntersectSphere( viewPos, rayDir, groundRadiusMM );
	float tMax = ( groundDist < 0.0 ) ? atmoDist : groundDist;

	float3 lum = raymarchScattering( viewPos, rayDir, sunDir, tMax );
	lum *= max( g_light_diffuse, 0.0.xxx );

	PS_OUTPUT Out;
	Out.vColor_0 = float4( lum, 1.0 );
	return Out;
}

